@page "/settings"
@inject TechieRagConfigService ConfigService
@inject TechieRagManager RagManager
@inject ToastService ToastService
@inject ILogger<Settings> Logger

<PageTitle>TechieRag Settings</PageTitle>

<div class="space-y-6">
    <div>
        <TypographyH2>TechieRag Configuration</TypographyH2>
        <TypographyMuted>Configure embedding providers, vector stores, and processing options.</TypographyMuted>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <Spinner Size="SpinnerSize.Large" />
        </div>
    }
    else
    {
        <div class="grid gap-6 lg:grid-cols-2">
            <!-- Embedding Configuration -->
            <Card>
                <CardHeader>
                    <CardTitle>Embedding Configuration</CardTitle>
                    <CardDescription>Configure how text is converted to vector embeddings.</CardDescription>
                </CardHeader>
                <CardContent Class="space-y-4">
                    <Field>
                        <FieldLabel>Embedding Source</FieldLabel>
                        <FieldContent>
                            <Select @bind-Value="embeddingSourceString" TValue="string">
                                <SelectTrigger>
                                    <SelectValue Placeholder="Select embedding source" />
                                </SelectTrigger>
                                <SelectContent>
                                    <SelectItem Value="@("Embedded")" Text="Embedded BGE-M3 (Auto-download)" TValue="string">Embedded BGE-M3 (Auto-download)</SelectItem>
                                    <SelectItem Value="@("Ollama")" Text="Ollama (Local)" TValue="string">Ollama (Local)</SelectItem>
                                    <SelectItem Value="@("LmStudio")" Text="LM Studio (Local)" TValue="string">LM Studio (Local)</SelectItem>
                                    <SelectItem Value="@("Onnx")" Text="ONNX (Custom Model)" TValue="string">ONNX (Custom Model)</SelectItem>
                                    <SelectItem Value="@("Http")" Text="HTTP Service (Docker/Custom)" TValue="string">HTTP Service (Docker/Custom)</SelectItem>
                                    <SelectItem Value="@("AzureOpenAI")" Text="Azure OpenAI (Cloud)" TValue="string">Azure OpenAI (Cloud)</SelectItem>
                                    <SelectItem Value="@("OpenAI")" Text="OpenAI (Cloud)" TValue="string">OpenAI (Cloud)</SelectItem>
                                </SelectContent>
                            </Select>
                            <FieldDescription>Select where embedding vectors will be generated.</FieldDescription>
                        </FieldContent>
                    </Field>

                    @if (config.Embedding.Source == EmbeddingSource.Embedded)
                    {
                        <Alert Variant="AlertVariant.Info">
                            <AlertTitle>BGE-M3 Model (Auto-download)</AlertTitle>
                            <AlertDescription>High-quality 1024-dimension embeddings supporting 100+ languages. Model (~2.3GB) downloads automatically on first use.</AlertDescription>
                        </Alert>
                    }
                    else
                    {
                        <Field>
                            <FieldLabel>Model Name</FieldLabel>
                            <FieldContent>
                                <Input @bind-Value="config.Embedding.Model" Placeholder="@GetModelPlaceholder()" />
                                <FieldDescription>@GetModelHint()</FieldDescription>
                            </FieldContent>
                        </Field>
                    }

                    @if (config.Embedding.Source == EmbeddingSource.Onnx)
                    {
                        <Field>
                            <FieldLabel>Model Path</FieldLabel>
                            <FieldContent>
                                <Input @bind-Value="config.Embedding.ModelPath" Placeholder="C:\Models\bge-m3-onnx" />
                                <FieldDescription>Path to the directory containing ONNX model files.</FieldDescription>
                            </FieldContent>
                        </Field>
                    }
                    else if (config.Embedding.Source != EmbeddingSource.Embedded)
                    {
                        <Field>
                            <FieldLabel>Endpoint URL</FieldLabel>
                            <FieldContent>
                                <Input @bind-Value="config.Embedding.Endpoint" Placeholder="@GetEndpointPlaceholder()" />
                                <FieldDescription>@GetEndpointHint()</FieldDescription>
                            </FieldContent>
                        </Field>
                    }

                    @if (RequiresApiKey())
                    {
                        <Field>
                            <FieldLabel>API Key</FieldLabel>
                            <FieldContent>
                                <Input Type="InputType.Password" @bind-Value="config.Embedding.ApiKey" Placeholder="Enter your API key" />
                                <FieldDescription>Your API key for authentication. Keep this secure.</FieldDescription>
                            </FieldContent>
                        </Field>
                    }
                </CardContent>
            </Card>

            <!-- Vector Store Configuration -->
            <Card>
                <CardHeader>
                    <CardTitle>Vector Store Configuration</CardTitle>
                    <CardDescription>Configure where vector embeddings are stored and searched.</CardDescription>
                </CardHeader>
                <CardContent Class="space-y-4">
                    <Field>
                        <FieldLabel>Vector Store Type</FieldLabel>
                        <FieldContent>
                            <Select @bind-Value="vectorStoreTypeString" TValue="string">
                                <SelectTrigger>
                                    <SelectValue Placeholder="Select vector store" />
                                </SelectTrigger>
                                <SelectContent>
                                    <SelectItem Value="@("SqliteVec")" Text="SQLite-vec (Embedded)" TValue="string">SQLite-vec (Embedded Database)</SelectItem>
                                    <SelectItem Value="@("PgVector")" Text="PGVector (PostgreSQL)" TValue="string">PGVector (PostgreSQL)</SelectItem>
                                    <SelectItem Value="@("Qdrant")" Text="Qdrant (Vector Database)" TValue="string">Qdrant (Vector Database)</SelectItem>
                                </SelectContent>
                            </Select>
                            <FieldDescription>@GetVectorStoreHint()</FieldDescription>
                        </FieldContent>
                    </Field>

                    <Field>
                        <FieldLabel>@GetConnectionStringLabel()</FieldLabel>
                        <FieldContent>
                            <Input @bind-Value="vectorStoreConnectionInput" Placeholder="@GetConnectionStringPlaceholder()" />
                            <FieldDescription>@GetConnectionStringHint()</FieldDescription>
                        </FieldContent>
                    </Field>

                    @if (config.VectorStore.Type == VectorStoreType.Qdrant)
                    {
                        <Field>
                            <FieldLabel>Qdrant API Key</FieldLabel>
                            <FieldContent>
                                <Input Type="InputType.Password" @bind-Value="config.VectorStore.ApiKey" Placeholder="Enter Qdrant API key..." />
                                <FieldDescription>API key for Qdrant authentication. Leave empty if not configured.</FieldDescription>
                            </FieldContent>
                        </Field>
                    }
                </CardContent>
            </Card>

            <!-- Processing Configuration -->
            <Card>
                <CardHeader>
                    <CardTitle>Document Processing</CardTitle>
                    <CardDescription>Configure how documents are split into chunks for embedding.</CardDescription>
                </CardHeader>
                <CardContent Class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <Field>
                            <FieldLabel>Chunk Size (chars)</FieldLabel>
                            <FieldContent>
                                <Input Type="InputType.Number" @bind-Value="chunkSizeString" Placeholder="500" />
                                <FieldDescription>Recommended: 300-800</FieldDescription>
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel>Chunk Overlap (chars)</FieldLabel>
                            <FieldContent>
                                <Input Type="InputType.Number" @bind-Value="chunkOverlapString" Placeholder="50" />
                                <FieldDescription>Overlap preserves context</FieldDescription>
                            </FieldContent>
                        </Field>
                    </div>
                </CardContent>
            </Card>

            <!-- Advanced Settings -->
            <Card>
                <CardHeader>
                    <CardTitle>Advanced Settings</CardTitle>
                    <CardDescription>Additional configuration options.</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="flex items-center space-x-2">
                        <Switch @bind-Checked="config.EnableTelemetry" Id="telemetry" />
                        <Label For="telemetry">Enable Telemetry</Label>
                    </div>
                    <TypographyMuted>Collect metrics and logging data for monitoring.</TypographyMuted>
                </CardContent>
            </Card>
        </div>

        <!-- Action Buttons -->
        <Card>
            <CardContent Class="flex items-center justify-between pt-6">
                <Button Variant="ButtonVariant.Outline" OnClick="ResetToDefaults" Disabled="isSaving">
                    Reset to Defaults
                </Button>
                <Button OnClick="SaveConfigAsync" Disabled="isSaving">
                    @if (isSaving)
                    {
                        <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Configuration</span>
                    }
                </Button>
            </CardContent>
        </Card>
    }
</div>

@code {
    private TechieRagConfig config = new();
    private bool isLoading = true;
    private bool isSaving;
    private string vectorStoreConnectionInput = "";

    private string embeddingSourceString
    {
        get => config.Embedding.Source.ToString();
        set { if (Enum.TryParse<EmbeddingSource>(value, out var src)) config.Embedding.Source = src; }
    }

    private string vectorStoreTypeString
    {
        get => config.VectorStore.Type.ToString();
        set { if (Enum.TryParse<VectorStoreType>(value, out var t)) config.VectorStore.Type = t; }
    }

    private string? chunkSizeString
    {
        get => config.Processing.DefaultChunkSize.ToString();
        set { if (int.TryParse(value, out var v)) config.Processing.DefaultChunkSize = v; }
    }

    private string? chunkOverlapString
    {
        get => config.Processing.DefaultChunkOverlap.ToString();
        set { if (int.TryParse(value, out var v)) config.Processing.DefaultChunkOverlap = v; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            config = await ConfigService.LoadConfigAsync();
            vectorStoreConnectionInput = ExtractConnectionInput(config.VectorStore.Type, config.VectorStore.ConnectionString);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load configuration");
            ToastService.Error("Failed to load configuration. Using defaults.", "Error");
            config = new TechieRagConfig();
            vectorStoreConnectionInput = "techierag.db";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string ExtractConnectionInput(VectorStoreType type, string connectionString)
    {
        if (string.IsNullOrWhiteSpace(connectionString))
            return type == VectorStoreType.SqliteVec ? "techierag.db" : "";

        if (type == VectorStoreType.SqliteVec)
        {
            var lower = connectionString.ToLowerInvariant();
            if (lower.StartsWith("data source="))
                return connectionString.Substring("data source=".Length).Trim().TrimEnd(';');
            return connectionString;
        }

        return connectionString;
    }

    private static string BuildConnectionString(VectorStoreType type, string input)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            return type switch
            {
                VectorStoreType.SqliteVec => "Data Source=techierag.db",
                VectorStoreType.Qdrant => "http://localhost:6334",
                _ => ""
            };
        }

        if (type == VectorStoreType.SqliteVec)
        {
            var trimmed = input.Trim();
            if (trimmed.ToLowerInvariant().StartsWith("data source="))
                return trimmed;
            return $"Data Source={trimmed}";
        }

        return input.Trim();
    }

    private async Task SaveConfigAsync()
    {
        isSaving = true;
        StateHasChanged();

        try
        {
            config.VectorStore.ConnectionString = BuildConnectionString(config.VectorStore.Type, vectorStoreConnectionInput);
            await ConfigService.SaveConfigAsync(config);
            await RagManager.ReconfigureAsync();
            ToastService.Success("Configuration saved and applied successfully!", "Saved");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save or apply configuration");
            ToastService.Error($"Failed to save: {ex.Message}", "Error");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResetToDefaults()
    {
        ConfigService.ResetToDefaults();
        config = await ConfigService.LoadConfigAsync();
        ToastService.Success("Configuration reset to defaults.", "Reset");
    }

    private bool RequiresApiKey() => config.Embedding.Source is EmbeddingSource.AzureOpenAI or EmbeddingSource.OpenAI;

    private string GetModelPlaceholder() => config.Embedding.Source switch
    {
        EmbeddingSource.Ollama => "bge-m3",
        EmbeddingSource.AzureOpenAI => "text-embedding-3-small",
        EmbeddingSource.OpenAI => "text-embedding-3-small",
        _ => "bge-m3"
    };

    private string GetModelHint() => config.Embedding.Source switch
    {
        EmbeddingSource.Ollama => "Model name as shown in 'ollama list'.",
        EmbeddingSource.AzureOpenAI => "Deployment name in Azure OpenAI resource.",
        EmbeddingSource.OpenAI => "Model name (e.g., text-embedding-3-small).",
        _ => "The embedding model to use."
    };

    private string GetEndpointPlaceholder() => config.Embedding.Source switch
    {
        EmbeddingSource.Ollama => "http://localhost:11434",
        EmbeddingSource.LmStudio => "http://localhost:1234",
        EmbeddingSource.Http => "http://localhost:7997",
        EmbeddingSource.AzureOpenAI => "https://your-resource.openai.azure.com",
        EmbeddingSource.OpenAI => "https://api.openai.com",
        _ => ""
    };

    private string GetEndpointHint() => config.Embedding.Source switch
    {
        EmbeddingSource.Ollama => "Ollama server URL. Default port is 11434.",
        EmbeddingSource.LmStudio => "LM Studio server URL. Default port is 1234.",
        EmbeddingSource.Http => "HTTP embedding service URL.",
        EmbeddingSource.AzureOpenAI => "Your Azure OpenAI resource endpoint URL.",
        EmbeddingSource.OpenAI => "OpenAI API base URL.",
        _ => "The API endpoint URL."
    };

    private string GetVectorStoreHint() => config.VectorStore.Type switch
    {
        VectorStoreType.SqliteVec => "Embedded database - no setup required.",
        VectorStoreType.PgVector => "PostgreSQL with pgvector extension.",
        VectorStoreType.Qdrant => "High-performance vector database.",
        _ => "Select a vector database."
    };

    private string GetConnectionStringLabel() => config.VectorStore.Type switch
    {
        VectorStoreType.SqliteVec => "Database File Path",
        VectorStoreType.PgVector => "Connection String",
        VectorStoreType.Qdrant => "Endpoint URL",
        _ => "Connection String"
    };

    private string GetConnectionStringPlaceholder() => config.VectorStore.Type switch
    {
        VectorStoreType.SqliteVec => "techierag.db",
        VectorStoreType.PgVector => "Host=localhost;Database=techierag;...",
        VectorStoreType.Qdrant => "http://localhost:6334",
        _ => ""
    };

    private string GetConnectionStringHint() => config.VectorStore.Type switch
    {
        VectorStoreType.SqliteVec => "Just enter the filename. File will be created if it doesn't exist.",
        VectorStoreType.PgVector => "PostgreSQL connection string with pgvector extension.",
        VectorStoreType.Qdrant => "Qdrant HTTP API endpoint URL.",
        _ => "Connection details for the vector store."
    };
}
