@page "/llm-settings"
@rendermode InteractiveServer
@inject TechieRagConfigService ConfigService
@inject TechieRagManager RagManager
@inject ToastService ToastService
@inject ILogger<LlmSettings> Logger

<PageTitle>LLM Settings</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <TypographyH2>LLM Configuration</TypographyH2>
            <TypographyMuted>Configure LLM providers, fallback, usage tracking, and prompts.</TypographyMuted>
        </div>
        <div class="flex gap-2">
            <Button Variant="ButtonVariant.Outline" OnClick="ResetToDefaultsAsync" Disabled="isSaving">Reset</Button>
            <Button OnClick="SaveConfigAsync" Disabled="isSaving">
                @if (isSaving) { <Spinner Size="SpinnerSize.Small" Class="mr-2" /> <span>Saving...</span> }
                else { <span>Save</span> }
            </Button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <Spinner Size="SpinnerSize.Large" />
        </div>
    }
    else
    {
        <Tabs DefaultValue="provider">
            <TabsList Class="grid w-full grid-cols-4">
                <TabsTrigger Value="provider">Provider</TabsTrigger>
                <TabsTrigger Value="fallback">Fallback</TabsTrigger>
                <TabsTrigger Value="usage">Usage</TabsTrigger>
                <TabsTrigger Value="prompts">Prompts</TabsTrigger>
            </TabsList>

            <TabsContent Value="provider">
                <Card>
                    <CardHeader>
                        <CardTitle>Primary LLM Provider</CardTitle>
                        <CardDescription>Select and configure the primary LLM for text generation.</CardDescription>
                    </CardHeader>
                    <CardContent Class="space-y-4">
                        @RenderLlmFields(config.Llm, "primary")
                    </CardContent>
                </Card>
            </TabsContent>

            <TabsContent Value="fallback">
                <Card>
                    <CardHeader>
                        <CardTitle>Fallback LLM Provider</CardTitle>
                        <CardDescription>If the primary fails, this provider is used automatically.</CardDescription>
                    </CardHeader>
                    <CardContent Class="space-y-4">
                        <div class="flex items-center space-x-2">
                            <Switch @bind-Checked="enableFallback" Id="enable-fallback" />
                            <Label For="enable-fallback">Enable Fallback Provider</Label>
                        </div>

                        @if (enableFallback)
                        {
                            <Separator />
                            @RenderLlmFields(fallbackConfig, "fallback")
                        }
                    </CardContent>
                </Card>
            </TabsContent>

            <TabsContent Value="usage">
                <Card>
                    <CardHeader>
                        <CardTitle>Usage Tracking &amp; Budgets</CardTitle>
                        <CardDescription>Set token and cost limits to manage LLM usage.</CardDescription>
                    </CardHeader>
                    <CardContent Class="space-y-4">
                        <div class="flex items-center space-x-2">
                            <Switch @bind-Checked="config.UsageTracking.Enabled" Id="enable-tracking" />
                            <Label For="enable-tracking">Enable Token Tracking</Label>
                        </div>

                        @if (config.UsageTracking.Enabled)
                        {
                            <Separator />
                            <div class="grid grid-cols-2 gap-4">
                                <Field>
                                    <FieldLabel>Max Total Tokens</FieldLabel>
                                    <FieldContent>
                                        <Input Type="InputType.Number" @bind-Value="maxTotalTokensString" />
                                    </FieldContent>
                                </Field>
                                <Field>
                                    <FieldLabel>Max Cost (USD)</FieldLabel>
                                    <FieldContent>
                                        <Input Type="InputType.Number" @bind-Value="maxCostString" />
                                    </FieldContent>
                                </Field>
                            </div>

                            <Field>
                                <FieldLabel>Alert Threshold: @config.UsageTracking.AlertThreshold.ToString("P0")</FieldLabel>
                                <FieldContent>
                                    <Slider @bind-Value="alertThresholdSlider" Min="0" Max="100" Step="5" />
                                </FieldContent>
                            </Field>

                            <div class="flex items-center space-x-2">
                                <Switch @bind-Checked="config.UsageTracking.BlockOnExceeded" Id="block-exceeded" />
                                <Label For="block-exceeded">Block Requests When Exceeded</Label>
                            </div>
                        }
                    </CardContent>
                </Card>
            </TabsContent>

            <TabsContent Value="prompts">
                <div class="space-y-4">
                    <Card>
                        <CardHeader>
                            <CardTitle>RAG Prompt Template</CardTitle>
                            <CardDescription>Customize how the system prompt and context are formatted.</CardDescription>
                        </CardHeader>
                        <CardContent Class="space-y-4">
                            <Field>
                                <FieldLabel>System Prompt</FieldLabel>
                                <FieldContent>
                                    <Textarea @bind-Value="config.Prompt.SystemPrompt" Class="min-h-[100px]" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel>Context Template</FieldLabel>
                                <FieldContent>
                                    <Textarea @bind-Value="config.Prompt.ContextChunkTemplate" Class="min-h-[80px]" />
                                </FieldContent>
                            </Field>
                            <div class="grid grid-cols-2 gap-4">
                                <Field>
                                    <FieldLabel>Max Context Chunks</FieldLabel>
                                    <FieldContent>
                                        <Input Type="InputType.Number" @bind-Value="maxContextChunksString" />
                                    </FieldContent>
                                </Field>
                                <Field>
                                    <FieldLabel>Max Context Tokens</FieldLabel>
                                    <FieldContent>
                                        <Input Type="InputType.Number" @bind-Value="maxContextTokensString" />
                                    </FieldContent>
                                </Field>
                            </div>
                        </CardContent>
                    </Card>

                    <Card>
                        <CardHeader>
                            <CardTitle>Resilience Settings</CardTitle>
                            <CardDescription>Configure retry and circuit breaker behavior.</CardDescription>
                        </CardHeader>
                        <CardContent Class="space-y-4">
                            <div class="grid grid-cols-2 gap-4">
                                <Field>
                                    <FieldLabel>Max Retries</FieldLabel>
                                    <FieldContent>
                                        <Input Type="InputType.Number" @bind-Value="maxRetriesString" />
                                    </FieldContent>
                                </Field>
                                <Field>
                                    <FieldLabel>Timeout (seconds)</FieldLabel>
                                    <FieldContent>
                                        <Input Type="InputType.Number" @bind-Value="timeoutString" />
                                    </FieldContent>
                                </Field>
                            </div>
                            <div class="flex items-center space-x-2">
                                <Switch @bind-Checked="config.Resilience.HandleRateLimiting" Id="rate-limit" />
                                <Label For="rate-limit">Handle Rate Limiting</Label>
                            </div>
                            <Field>
                                <FieldLabel>Circuit Breaker Threshold</FieldLabel>
                                <FieldContent>
                                    <Input Type="InputType.Number" @bind-Value="cbThresholdString" />
                                    <FieldDescription>Number of consecutive failures before opening the circuit.</FieldDescription>
                                </FieldContent>
                            </Field>
                        </CardContent>
                    </Card>
                </div>
            </TabsContent>
        </Tabs>

        <!-- Connection Test -->
        <Card>
            <CardHeader>
                <CardTitle>Connection Test</CardTitle>
            </CardHeader>
            <CardContent Class="space-y-4">
                <Button OnClick="TestLlmConnectionAsync" Disabled="isTesting">
                    @if (isTesting) { <Spinner Size="SpinnerSize.Small" Class="mr-2" /> <span>Testing...</span> }
                    else { <span>Test LLM Connection</span> }
                </Button>
                @if (!string.IsNullOrEmpty(testResult))
                {
                    <Alert Variant="@(testSuccess ? AlertVariant.Success : AlertVariant.Danger)">
                        <AlertDescription>@testResult</AlertDescription>
                    </Alert>
                }
            </CardContent>
        </Card>
    }
</div>

@code {
    private TechieRagConfig config = new();
    private LlmConfig fallbackConfig = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool isTesting;
    private bool enableFallback;
    private string? testResult;
    private bool testSuccess;

    private double alertThresholdSlider
    {
        get => config.UsageTracking.AlertThreshold * 100.0;
        set => config.UsageTracking.AlertThreshold = (float)(value / 100.0);
    }

    private string? maxTotalTokensString
    {
        get => config.UsageTracking.MaxTotalTokens.ToString();
        set { if (long.TryParse(value, out var v)) config.UsageTracking.MaxTotalTokens = v; }
    }

    private string? maxCostString
    {
        get => config.UsageTracking.MaxCostUsd.ToString("F2");
        set { if (decimal.TryParse(value, out var v)) config.UsageTracking.MaxCostUsd = v; }
    }

    private string? maxContextChunksString
    {
        get => config.Prompt.MaxContextChunks.ToString();
        set { if (int.TryParse(value, out var v)) config.Prompt.MaxContextChunks = v; }
    }

    private string? maxContextTokensString
    {
        get => config.Prompt.MaxContextTokens.ToString();
        set { if (int.TryParse(value, out var v)) config.Prompt.MaxContextTokens = v; }
    }

    private string? maxRetriesString
    {
        get => config.Resilience.MaxRetries.ToString();
        set { if (int.TryParse(value, out var v)) config.Resilience.MaxRetries = v; }
    }

    private string? timeoutString
    {
        get => config.Resilience.TimeoutSeconds.ToString();
        set { if (int.TryParse(value, out var v)) config.Resilience.TimeoutSeconds = v; }
    }

    private string? cbThresholdString
    {
        get => config.Resilience.CircuitBreakerThreshold.ToString();
        set { if (int.TryParse(value, out var v)) config.Resilience.CircuitBreakerThreshold = v; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            config = await ConfigService.LoadConfigAsync();
            if (config.LlmFallback is not null && config.LlmFallback.Source != LlmSource.None)
            {
                fallbackConfig = config.LlmFallback;
                enableFallback = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load LLM configuration");
            ToastService.Error("Failed to load configuration.", "Error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private RenderFragment RenderLlmFields(LlmConfig llmConfig, string prefix) => __builder =>
    {
        <Field>
            <FieldLabel>Source</FieldLabel>
            <FieldContent>
                <Select @bind-Value="@llmConfig.Source" TValue="LlmSource">
                    <SelectTrigger>
                        <SelectValue Placeholder="Select LLM provider" />
                    </SelectTrigger>
                    <SelectContent>
                        <SelectItem Value="LlmSource.None" Text="None" TValue="LlmSource">None</SelectItem>
                        <SelectItem Value="LlmSource.Ollama" Text="Ollama" TValue="LlmSource">Ollama</SelectItem>
                        <SelectItem Value="LlmSource.LmStudio" Text="LM Studio" TValue="LlmSource">LM Studio</SelectItem>
                        <SelectItem Value="LlmSource.OpenAICompatible" Text="OpenAI-Compatible" TValue="LlmSource">OpenAI-Compatible</SelectItem>
                        <SelectItem Value="LlmSource.AzureAIFoundry" Text="Azure AI Foundry" TValue="LlmSource">Azure AI Foundry</SelectItem>
                        <SelectItem Value="LlmSource.GoogleGemini" Text="Google Gemini" TValue="LlmSource">Google Gemini</SelectItem>
                        <SelectItem Value="LlmSource.Anthropic" Text="Anthropic" TValue="LlmSource">Anthropic</SelectItem>
                    </SelectContent>
                </Select>
            </FieldContent>
        </Field>

        @if (llmConfig.Source != LlmSource.None)
        {
            <Field>
                <FieldLabel>Endpoint</FieldLabel>
                <FieldContent>
                    <Input @bind-Value="llmConfig.Endpoint" Placeholder="@GetLlmEndpointPlaceholder(llmConfig.Source)" />
                </FieldContent>
            </Field>

            @if (llmConfig.Source is LlmSource.OpenAICompatible or LlmSource.AzureAIFoundry or LlmSource.GoogleGemini or LlmSource.Anthropic)
            {
                <Field>
                    <FieldLabel>API Key</FieldLabel>
                    <FieldContent>
                        <Input Type="InputType.Password" @bind-Value="llmConfig.ApiKey" Placeholder="Enter API key" />
                    </FieldContent>
                </Field>
            }

            <Field>
                <FieldLabel>Model</FieldLabel>
                <FieldContent>
                    <Input @bind-Value="llmConfig.Model" Placeholder="@GetLlmModelPlaceholder(llmConfig.Source)" />
                </FieldContent>
            </Field>

            <div class="grid grid-cols-2 gap-4">
                <Field>
                    <FieldLabel>Temperature: @llmConfig.Temperature.ToString("F1")</FieldLabel>
                    <FieldContent>
                        <Slider Value="@((double)llmConfig.Temperature)" ValueChanged="@(v => llmConfig.Temperature = (float)v)" Min="0" Max="2" Step="0.1" />
                    </FieldContent>
                </Field>
                <Field>
                    <FieldLabel>Max Tokens</FieldLabel>
                    <FieldContent>
                        <Input Type="InputType.Number" Value="@llmConfig.MaxTokens.ToString()" ValueChanged="@((string? v) => { if (int.TryParse(v, out var n)) llmConfig.MaxTokens = n; })" />
                    </FieldContent>
                </Field>
            </div>
        }
    };

    private string? GetMaxTokensString(LlmConfig c)
    {
        return c.MaxTokens.ToString();
    }

    private void SetMaxTokens(LlmConfig c, string? value)
    {
        if (int.TryParse(value, out var v)) c.MaxTokens = v;
    }

    private string GetLlmEndpointPlaceholder(LlmSource source) => source switch
    {
        LlmSource.Ollama => "http://localhost:11434",
        LlmSource.LmStudio => "http://localhost:1234",
        LlmSource.OpenAICompatible => "https://api.openai.com",
        LlmSource.AzureAIFoundry => "https://your-resource.openai.azure.com",
        LlmSource.GoogleGemini => "https://generativelanguage.googleapis.com",
        LlmSource.Anthropic => "https://api.anthropic.com",
        _ => ""
    };

    private string GetLlmModelPlaceholder(LlmSource source) => source switch
    {
        LlmSource.Ollama => "llama3.2",
        LlmSource.LmStudio => "llama3.2",
        LlmSource.OpenAICompatible => "gpt-4o",
        LlmSource.AzureAIFoundry => "gpt-4o",
        LlmSource.GoogleGemini => "gemini-2.0-flash",
        LlmSource.Anthropic => "claude-sonnet-4-5-20250929",
        _ => ""
    };

    private async Task SaveConfigAsync()
    {
        isSaving = true;
        StateHasChanged();

        try
        {
            config.LlmFallback = enableFallback ? fallbackConfig : null;
            await ConfigService.SaveConfigAsync(config);
            await RagManager.ReconfigureAsync();
            ToastService.Success("LLM configuration saved and applied.", "Saved");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save LLM configuration");
            ToastService.Error($"Failed to save: {ex.Message}", "Error");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResetToDefaultsAsync()
    {
        config.Llm = new LlmConfig();
        fallbackConfig = new LlmConfig();
        enableFallback = false;
        config.UsageTracking = new UsageTrackingConfig();
        config.Resilience = new ResilienceConfig();
        config.Prompt = new PromptConfig();
        ToastService.Success("LLM settings reset to defaults.", "Reset");
        await Task.CompletedTask;
    }

    private async Task TestLlmConnectionAsync()
    {
        isTesting = true;
        testResult = null;
        StateHasChanged();

        try
        {
            var provider = RagManager.GetLlmProvider();
            if (provider is null)
            {
                testResult = "No LLM provider configured. Save settings first.";
                testSuccess = false;
                return;
            }

            var sw = System.Diagnostics.Stopwatch.StartNew();
            var response = await provider.CompleteAsync("Say 'hello' in one word.");
            sw.Stop();

            testResult = $"Connected - {provider.ModelName} via {provider.Name} (response: {sw.ElapsedMilliseconds}ms)";
            testSuccess = true;
        }
        catch (Exception ex)
        {
            testResult = $"Connection failed: {ex.Message}";
            testSuccess = false;
        }
        finally
        {
            isTesting = false;
        }
    }
}
