<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package Metadata -->
    <PackageId>TechieRag</PackageId>
    <Version>1.0.0</Version>
    <Authors>Techie Rathor</Authors>
    <Company>TechieRathor</Company>
    <Description>A flexible, configurable RAG (Retrieval-Augmented Generation) library for .NET. Supports multiple embedding providers (Ollama, LM Studio, OpenAI, Azure OpenAI, ONNX, HTTP) and vector stores (SQLite-vec, PostgreSQL/pgvector, Qdrant). Built-in document processors for PDF, DOCX, XLSX, PPTX, CSV, HTML, Markdown, JSON, TOML, and code files.</Description>
    <PackageTags>RAG;AI;Embeddings;VectorStore;LLM;OpenAI;Ollama;Qdrant;pgvector;SQLite;DocumentProcessing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/techierathore/TechieRag</PackageProjectUrl>
    <RepositoryUrl>https://github.com/techierathore/TechieRag.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TechieRag.Tests" />
  </ItemGroup>

  <!-- AI Agent Files: Distributed to consumer projects via NuGet -->
  <!-- TechieRag.targets auto-deploys these to the consumer project on every build -->
  <!-- Content files are packed under BOTH build\ and buildTransitive\ so that -->
  <!-- $(MSBuildThisFileDirectory)content\ resolves correctly for both direct and transitive refs -->
  <ItemGroup>
    <None Include="build\TechieRag.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\TechieRag.targets" Pack="true" PackagePath="build\" />
    <None Include="build\content\TechieRag-AI-Reference.md" Pack="true" PackagePath="buildTransitive\content\" />
    <None Include="build\content\techierag-claude-command.md" Pack="true" PackagePath="buildTransitive\content\" />
    <None Include="build\content\techierag-opencode-command.md" Pack="true" PackagePath="buildTransitive\content\" />
    <None Include="build\content\TechieRag-AI-Reference.md" Pack="true" PackagePath="build\content\" />
    <None Include="build\content\techierag-claude-command.md" Pack="true" PackagePath="build\content\" />
    <None Include="build\content\techierag-opencode-command.md" Pack="true" PackagePath="build\content\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Markdig" Version="0.45.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <!-- Pin the native SQLite binary past GHSA-2m69-gcr7-jv3q (transitive 2.1.11 via Microsoft.Data.Sqlite
         is High-severity). lib.e_sqlite3 ships only the native e_sqlite3 binary; the SQLite C ABI is stable,
         so the 2.1.11 managed core/provider load the 3.50.3 native lib fine. Flows to Embedded + tests via
         the project references. Remove when Microsoft.Data.Sqlite bumps its SQLitePCLRaw floor past the fix. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="Qdrant.Client" Version="1.16.1" />
    <PackageReference Include="Tomlyn" Version="0.20.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
  </ItemGroup>

</Project>
