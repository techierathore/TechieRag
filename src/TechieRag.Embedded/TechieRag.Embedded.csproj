<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ensure ONNX Runtime native DLLs are copied to consuming projects -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package Metadata -->
    <PackageId>TechieRag.Embedded</PackageId>
    <Version>1.0.0</Version>
    <Authors>Techie Rathor</Authors>
    <Company>TechieRathor</Company>
    <Description>Offline embeddings and reranking for TechieRag on ONNX Runtime: BGE-M3 (1024 dimensions, multilingual) on desktops, all-MiniLM-L6-v2 (384 dimensions) on Android and iOS, downloaded once into the per-user application data folder. Ships the native ONNX Runtime wiring for .NET MAUI heads (Windows, Mac Catalyst, Android, iOS).</Description>
    <PackageTags>RAG;AI;Embeddings;ONNX;Offline;SelfContained;LocalAI;BGE-M3;Multilingual;EdgeAI</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/techierathore/TechieRag</PackageProjectUrl>
    <RepositoryUrl>https://github.com/techierathore/TechieRag.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Same publishing posture as TechieRag core - see NUGET-PUBLISHING.md. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TechieRag.Tests" />
  </ItemGroup>

  <!-- REQ-FN-055 / BRD-90: native ONNX Runtime wiring for Mac Catalyst, iOS and Android MAUI heads,
       applied to every consuming app (direct or transitive) so none writes it by hand. A project
       that references this one by ProjectReference (samples/TechieRag.Probe) imports the targets
       file itself, since NuGet build assets do not flow over a ProjectReference. -->
  <ItemGroup>
    <None Include="buildTransitive\TechieRag.Embedded.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\onnx-customops-stub.c" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TechieRag\TechieRag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ONNX Runtime for running embedding models locally -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.30.0" />

    <!-- Tokenizers for text preprocessing -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <!-- Model weights are never packed (ADR-004): they are downloaded on first use into the model
       root, <LocalApplicationData>/TechieRag/models (REQ-RAG-053). -->

</Project>
