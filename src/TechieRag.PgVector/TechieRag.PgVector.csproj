<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same targets as TechieRag core, so a net8.0 consumer of the PostgreSQL stores keeps them. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>TechieRag</RootNamespace>

    <!-- Package Metadata -->
    <PackageId>TechieRag.PgVector</PackageId>
    <Version>1.3.0</Version>
    <Authors>Techie Rathor</Authors>
    <Company>TechieRathor</Company>
    <Description>PostgreSQL for TechieRag: the pgvector vector store (PgVectorStore, UsePgVector) and the PostgreSQL conversation, workspace and token-usage stores (UsePostgres, WithPersistence(StoreProvider.Postgres)). Brings in Npgsql and Pgvector, which the TechieRag core package no longer carries.</Description>
    <PackageTags>RAG;AI;VectorStore;pgvector;PostgreSQL;Npgsql;TechieRag</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/techierathore/TechieRag</PackageProjectUrl>
    <RepositoryUrl>https://github.com/techierathore/TechieRag.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Same publishing posture as TechieRag core - see NUGET-PUBLISHING.md. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TechieRag.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TechieRag\TechieRag.csproj" />
  </ItemGroup>

  <!-- REQ-RAG-168 (TrStudio TR-RAG-006): these two left the core package, so an app that uses only SQLite
       no longer carries a PostgreSQL client. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
  </ItemGroup>

</Project>
