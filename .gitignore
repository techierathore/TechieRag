# Secrets — nuget.config holds a GitHub Packages PAT in plaintext; keep it out of the repo.
# NOTE: this only stops FUTURE commits. The file is already tracked and the token is already in
# history — you must also untrack it (git rm --cached nuget.config) AND revoke/rotate the exposed PAT.
nuget.config

# Local dev secrets — real AppManager BaseUrl/ApiKey/ApiSecret/ApplicationId live here, never commit.
# .NET auto-layers appsettings.Development.json over appsettings.json in the Development environment.
appsettings.Development.json
apps/TechieDesk/appsettings.Development.json

