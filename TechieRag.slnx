<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>

  <!-- Library repository since 2026-09-24 (BRD-87, REQ-FN-006): the application (Sevak, formerly
       TechieDesk) lives in its own repository and consumes these packages from NuGet. -->
  <Folder Name="/src/">
    <Project Path="src/TechieRag.Embedded/TechieRag.Embedded.csproj" />
    <!-- REQ-RAG-036 / BRD-117: the opt-in OpenTelemetry exporters, kept out of the core package so
         the core still links no exporter (REQ-NFR-008). -->
    <Project Path="src/TechieRag.Telemetry/TechieRag.Telemetry.csproj" />
    <Project Path="src/TechieRag/TechieRag.csproj" />
    <!-- REQ-RAG-016 / BRD-84, ADR-008: agents on Microsoft Agent Framework, a sibling package so the
         core never references MAF. -->
    <Project Path="src/TechieRag.Agents/TechieRag.Agents.csproj" />
    <!-- REQ-RAG-057 / BRD-96, ADR-014: the in-process local language model, a sibling package so the
         core never references a local inference runtime. -->
    <Project Path="src/TechieRag.Local/TechieRag.Local.csproj" />
  </Folder>
  <Folder Name="/docs/">
    <File Path="docs/TechieRag-BRD.md" />
    <File Path="docs/TechieRag-P2-BRD.md" />
    <File Path="docs/TechieRag-Phases.md" />
    <File Path="docs/TechieRag-Architecture.md" />
    <File Path="docs/TechieRag-Coding-Standards.md" />
    <File Path="docs/TechieRag-UsageGuide.md" />
    <File Path="docs/TechieRag-DevGuide.md" />
    <File Path="docs/ai-agent-autodistribution-guide.md" />
    <File Path="docs/EMBEDDED-PACKAGE-GUIDE.md" />
    <File Path="docs/integration-testing-guide.md" />
    <File Path="docs/NUGET-PUBLISHING-GUIDE.md" />
    <File Path="docs/SETUP-AND-TESTING-GUIDE.md" />
    <File Path="docs/TechieRag-UserGuide.md" />
    <File Path="docs/TechieRag.Embedded-UserGuide.md" />
    <File Path="DECISIONS.md" />
    <File Path="NUGET-PUBLISHING.md" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/TechieRag.Tests/TechieRag.Tests.csproj" />
    <Project Path="tests/TechieRag.Agents.Tests/TechieRag.Agents.Tests.csproj" />
    <Project Path="tests/TechieRag.Local.Tests/TechieRag.Local.Tests.csproj" />
  </Folder>
</Solution>
