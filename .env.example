# TechieDesk deployment configuration (12-factor / REQ-FN-018).
# Copy to `.env` (never commit the filled-in copy) and adjust. Docker Compose reads
# this file automatically. ASP.NET Core maps nested config keys with a DOUBLE
# UNDERSCORE, so `AppManager__BaseUrl` sets the AppManager:BaseUrl setting.

# ---- App host ----
ASPNETCORE_ENVIRONMENT=Production
# Host port to publish the app on (container always listens on 8080).
APP_PORT=8080

# ---- App database (DbUp-migrated on start) ----
# The compose stack defaults the app DB to the bundled Postgres/pgvector service.
POSTGRES_USER=techiedesk
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=techiedesk
# To run the app DB on SQLite instead of Postgres, set these on the `app` service:
#   AppDb__Provider=Sqlite
#   AppDb__ConnectionString=Data Source=data/techiedesk.db

# ---- Auth mode (REQ-UI-023) ----
# Leave AppManager__BaseUrl EMPTY for offline single-user mode (built-in Admin, no login).
# Set it (plus key/secret) to run against AppManager. Keep secrets OUT of version control.
AppManager__BaseUrl=
AppManager__ApiKey=
AppManager__ApiSecret=
AppManager__ApplicationId=

# ---- Optional profile services ----
# Enable with:  docker compose --profile qdrant --profile ollama up -d
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OLLAMA_PORT=11434

# ---- AI providers (runtime, offline by default) ----
# Out of the box the app uses zero-external-service defaults: Embedded BGE-M3 + SqliteVec.
# The first-run wizard (/setup) writes techierag-config.json; alternatively the TechieRag:*
# section can be seeded via env, e.g.:
#   TechieRag__Embedding__Source=Ollama
#   TechieRag__Embedding__Endpoint=http://ollama:11434
#   TechieRag__Embedding__Model=bge-m3
