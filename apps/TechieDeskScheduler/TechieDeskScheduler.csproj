<Project Sdk="Microsoft.NET.Sdk">

  <!--
    REQ-FN-042 / BRD-139 / ADR-009 — the background scheduler helper.

    This is the process a launchd user agent (macOS) or a per-user logon task (Windows) starts, so
    schedules run with the TechieDesk window closed. It is NOT a second scheduler: it references
    TechieDesk.Core and hosts the same SchedulerService against the same data directory. BRD-139
    explicitly rules out a job server or job database, and there is none here — no listening port, no
    queue, no storage of its own.

    AssemblyName matches what SchedulerHelperLocator looks for beside the app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TechieDeskScheduler</RootNamespace>
    <AssemblyName>TechieDeskScheduler</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TechieDesk.Core\TechieDesk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!-- Same version the desktop head uses, so both processes log through one Serilog. -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

</Project>
