@inherits LayoutComponentBase

@* Centered-card layout for the public auth screens (login/register/password recovery),
   matching docs/mockups/*.html — no sidebar, soft gradient backdrop. *@

<div class="flex min-h-screen items-center justify-center bg-gradient-to-b from-primary/5 via-background to-background p-6">
    <div class="flex w-full max-w-md flex-col gap-4">
        @* REQ-NFR-005: the brand lockup and the strapline are the page banner; wrapping them in
           <header> (and the legal note below in <footer>) puts every node on these screens inside
           a landmark, which is what axe's `region` rule is asking for. Both are display:contents-
           free plain wrappers, so the parent flex column still sees the same children. *@
        <header class="flex flex-col gap-4">
            <a href="/login" class="flex items-center justify-center gap-2.5 text-lg font-bold tracking-tight">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-xs font-extrabold text-primary-foreground shadow">TD</span>
                <span>TechieDesk</span>
            </a>
            <div class="-mt-2 text-center text-sm text-muted-foreground">Chat with your documents — self-hosted.</div>
        </header>

        @* REQ-NFR-005: the auth screens had no landmark at all, so every element on them was
           orphaned outside a region (axe landmark-one-main + region, 6-10 nodes per route).
           A <main> wrapper gives assistive tech a single "skip to the form" target without
           changing the visual layout: <main> repeats the parent's `flex flex-col gap-4` so a
           body with several stacked cards (e.g. /setup) keeps the exact same rhythm, while the
           wrapper itself is a single flex item in the parent's identical gap. Deliberately not
           `class="contents"` — that utility is not present in the prebuilt TrBlazeUI bundle. *@
        <main class="flex w-full flex-col gap-4">
            @Body
        </main>

        <footer class="text-center text-xs text-muted-foreground">
            Passwords are RSA-encrypted before transmission · Accounts managed by AppManager
        </footer>
    </div>
</div>

<ToastProvider Position="ToastPosition.BottomRight" />
<PortalHost />
