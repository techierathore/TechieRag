@page "/text-ingestion"
@using TechieRag.Models
@using TechieRag.Embedded
@implements IDisposable
@inject ITechieRag Rag
@inject ToastService ToastService
@inject ILogger<TextIngestion> Logger
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["TextInPageTitle"]</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0">@Localizer["TextInTitle"]</h1>
        <TypographyMuted>@Localizer["TextInSubtitle"]</TypographyMuted>
    </div>

    <!-- Model Download Progress -->
    @if (isDownloadingModel)
    {
        <Alert Variant="AlertVariant.Warning">
            <Alert.Icon><Spinner Size="SpinnerSize.Small" /></Alert.Icon>
            <AlertTitle>@Localizer["TextInDownloadingModel"]</AlertTitle>
            <AlertDescription>
                @(downloadProgress?.StatusMessage)
                <Progress aria-label="@Localizer["TextInModelDownloadProgress"]" Value="@Math.Round((double)(downloadProgress?.CurrentFileProgressPercent ?? 0))" Class="mt-2" />
                <div class="flex justify-between text-xs mt-1">
                    <span>@FormatBytes(downloadProgress?.CurrentFileBytesDownloaded ?? 0) / @FormatBytes(downloadProgress?.CurrentFileTotalBytes ?? 0)</span>
                    <span>@Localizer["TextInFileProgress", (downloadProgress?.CompletedFiles ?? 0) + 1, downloadProgress?.TotalFiles ?? 5]</span>
                </div>
            </AlertDescription>
        </Alert>
    }

    <div class="grid gap-6 lg:grid-cols-3">
        <!-- Input Form -->
        <div class="lg:col-span-2 space-y-4">
            <Card>
                <CardHeader>
                    <CardTitle>@Localizer["TextInTextContent"]</CardTitle>
                    <CardDescription>@Localizer["TextInTextContentDescription"]</CardDescription>
                </CardHeader>
                <CardContent Class="space-y-4">
                    <Field>
                        <FieldLabel>@Localizer["TextInDocumentName"]</FieldLabel>
                        <FieldContent>
                            <Input @bind-Value="documentName" Placeholder="@Localizer["TextInDocumentNamePlaceholder"]" Required="true" />
                            <FieldDescription>@Localizer["TextInDocumentNameHint"]</FieldDescription>
                        </FieldContent>
                    </Field>

                    <Field>
                        <FieldLabel>@Localizer["TextInTextContent"]</FieldLabel>
                        <FieldContent>
                            <Textarea @bind-Value="textContent" Placeholder="@Localizer["TextInTextContentPlaceholder"]" Class="min-h-[200px]" />
                            <div class="flex gap-4 mt-1">
                                <TypographyMuted>@Localizer["TextInCharacterCount", textContent.Length.ToString("N0")]</TypographyMuted>
                                <TypographyMuted>@(Localizer["TextInWordCount", textContent.Split(new[] { ' ', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Length])</TypographyMuted>
                            </div>
                        </FieldContent>
                    </Field>

                    <Field>
                        <FieldLabel>@Localizer["TextInSourceInfo"]</FieldLabel>
                        <FieldContent>
                            <Input @bind-Value="sourceInfo" Placeholder="@Localizer["TextInSourceInfoPlaceholder"]" />
                            <FieldDescription>@Localizer["TextInSourceInfoHint"]</FieldDescription>
                        </FieldContent>
                    </Field>

                    <div class="flex gap-3">
                        <Button OnClick="IngestTextAsync" Disabled="isIngesting">
                            @if (isIngesting) { <Spinner Size="SpinnerSize.Small" Class="mr-2" /> <span>@Localizer["TextInIngesting"]</span> }
                            else { <span>@Localizer["TextInIngestText"]</span> }
                        </Button>
                        <Button Variant="ButtonVariant.Outline" OnClick="ClearForm">@Localizer["TextInClearForm"]</Button>
                        <Button Variant="ButtonVariant.Destructive" OnClick="ClearVectorStoreAsync" Disabled="isIngesting">@Localizer["TextInClearAllData"]</Button>
                    </div>

                    @if (isIngesting)
                    {
                        <div class="space-y-2">
                            <Progress aria-label="@Localizer["TextInIngestionProgress"]" Value="@Math.Round((double)progress)" />
                            <TypographyMuted>@progressMessage</TypographyMuted>
                        </div>
                    }
                </CardContent>
            </Card>
        </div>

        <!-- Stats & Documents Sidebar -->
        <div class="space-y-4">
            @if (stats != null)
            {
                <Card>
                    <CardHeader>
                        <CardTitle>@Localizer["TextInStatistics"]</CardTitle>
                    </CardHeader>
                    <CardContent>
                        <div class="space-y-3">
                            <div class="flex justify-between">
                                <TypographyMuted>@Localizer["TextInDocuments"]</TypographyMuted>
                                <span class="font-medium">@stats.TotalDocuments</span>
                            </div>
                            <div class="flex justify-between">
                                <TypographyMuted>@Localizer["TextInChunks"]</TypographyMuted>
                                <span class="font-medium">@stats.TotalChunks</span>
                            </div>
                            <div class="flex justify-between">
                                <TypographyMuted>@Localizer["TextInStorage"]</TypographyMuted>
                                <span class="font-medium">@FormatSize(stats.VectorStoreSizeBytes)</span>
                            </div>
                        </div>
                    </CardContent>
                </Card>
            }

            <Card>
                <CardHeader>
                    <CardTitle>@Localizer["TextInDocuments"]</CardTitle>
                </CardHeader>
                <CardContent>
                    @if (documents.Count == 0)
                    {
                        <TypographyMuted>@Localizer["TextInNoDocuments"]</TypographyMuted>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var doc in documents)
                            {
                                <div class="flex items-center justify-between py-1">
                                    <span class="text-sm truncate max-w-[150px]">@doc.Name</span>
                                    @* REQ-NFR-005: icon-only row action — the name carries the row identity so the
                                       control is distinguishable when listed out of context by a screen reader. *@
                                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" OnClick="@(() => DeleteDocumentAsync(doc.Id))">
                                        <LucideIcon aria-hidden="true" Name="trash-2" Size="14" />
                                        <span class="sr-only">@Localizer["TextInDeleteDocument", doc.Id]</span>
                                    </Button>
                                </div>
                            }
                        </div>
                    }
                </CardContent>
            </Card>
        </div>
    </div>
</div>

@code {
    private string documentName = "";
    private string textContent = "";
    private string sourceInfo = "";
    private bool isIngesting;
    private int progress;
    private string? progressMessage;
    private IngestionStats? stats;
    private List<Document> documents = new();
    private bool isDownloadingModel;
    private ModelDownloadProgress? downloadProgress;

    protected override async Task OnInitializedAsync()
    {
        ModelDownloadService.Instance.ProgressChanged += OnDownloadProgressChanged;
        downloadProgress = ModelDownloadService.Instance.Progress;

        try
        {
            UpdateDownloadStatus();
            await Rag.InitializeAsync();
            await RefreshStatsAsync();
            await RefreshDocumentsAsync();
            UpdateDownloadStatus();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize text ingestion page");
            ToastService.Error(Localizer["TextInInitializationError", ex.Message], Localizer["TextInErrorTitle"]);
        }
    }

    private void OnDownloadProgressChanged(object? sender, ModelDownloadProgress progress)
    {
        downloadProgress = progress;
        UpdateDownloadStatus();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateDownloadStatus()
    {
        var status = ModelDownloadService.Instance.Progress.Status;
        isDownloadingModel = status == ModelDownloadStatus.Downloading || status == ModelDownloadStatus.Checking;
    }

    public void Dispose()
    {
        ModelDownloadService.Instance.ProgressChanged -= OnDownloadProgressChanged;
    }

    private void ClearForm()
    {
        documentName = "";
        textContent = "";
        sourceInfo = "";
    }

    private async Task IngestTextAsync()
    {
        if (string.IsNullOrWhiteSpace(documentName))
        {
            ToastService.Error(Localizer["TextInEnterDocumentName"], Localizer["TextInValidationTitle"]);
            return;
        }

        if (string.IsNullOrWhiteSpace(textContent))
        {
            ToastService.Error(Localizer["TextInEnterTextContent"], Localizer["TextInValidationTitle"]);
            return;
        }

        isIngesting = true;
        progress = 0;
        StateHasChanged();

        try
        {
            progress = 10;
            progressMessage = Localizer["TextInProgressPreparing"];
            StateHasChanged();
            await Task.Delay(50);

            var metadata = new Dictionary<string, object>
            {
                { "ContentType", "text" },
                { "CharacterCount", textContent.Length },
                { "WordCount", textContent.Split(new[] { ' ', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Length }
            };
            if (!string.IsNullOrWhiteSpace(sourceInfo))
                metadata["Source"] = sourceInfo;

            progress = 30;
            progressMessage = Localizer["TextInProgressChunking"];
            StateHasChanged();
            await Task.Delay(50);

            var documentId = await Rag.IngestTextAsync(textContent, documentName, metadata);

            progress = 100;
            progressMessage = Localizer["TextInProgressComplete"];
            ToastService.Success(Localizer["TextInIngestedDocument", documentName, documentId], Localizer["TextInSuccessTitle"]);

            await RefreshStatsAsync();
            await RefreshDocumentsAsync();
            documentName = "";
            textContent = "";
            sourceInfo = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to ingest text content");
            ToastService.Error(Localizer["TextInErrorBody", ex.Message], Localizer["TextInErrorTitle"]);
        }
        finally
        {
            isIngesting = false;
            StateHasChanged();
        }
    }

    private async Task ClearVectorStoreAsync()
    {
        try
        {
            await Rag.ClearAsync();
            await RefreshStatsAsync();
            await RefreshDocumentsAsync();
            ToastService.Success(Localizer["TextInAllDataCleared"], Localizer["TextInClearedTitle"]);
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["TextInErrorBody", ex.Message], Localizer["TextInErrorTitle"]);
        }
    }

    private async Task DeleteDocumentAsync(string documentId)
    {
        try
        {
            await Rag.DeleteDocumentAsync(documentId);
            await RefreshStatsAsync();
            await RefreshDocumentsAsync();
            ToastService.Success(Localizer["TextInDocumentDeleted"], Localizer["TextInDeletedTitle"]);
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["TextInErrorBody", ex.Message], Localizer["TextInErrorTitle"]);
        }
    }

    private async Task RefreshStatsAsync()
    {
        try { stats = await Rag.GetStatsAsync(); } catch { }
    }

    private async Task RefreshDocumentsAsync()
    {
        try { documents = (await Rag.ListDocumentsAsync()).ToList(); } catch { }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 * 1024 => $"{bytes / (double)(1024 * 1024 * 1024):F1} GB",
        >= 1024 * 1024 => $"{bytes / (double)(1024 * 1024):F1} MB",
        >= 1024 => $"{bytes / (double)1024:F1} KB",
        _ => $"{bytes} B"
    };

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= (long)(1024 * 1024 * 1024) => $"{bytes / (1024.0 * 1024 * 1024):F2} GB",
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):F1} MB",
        >= 1024 => $"{bytes / 1024.0:F0} KB",
        _ => $"{bytes} B"
    };
}
