@* MCP server editor (REQ-RAG-023) *@
<Dialog @bind-Open="showMcpEditor">
    <DialogContent Class="max-w-3xl">
        <DialogHeader>
            <DialogTitle>@Localizer[mcpDraft?.IsExisting == true ? "McpEditorEditTitle" : "McpEditorNewTitle"]</DialogTitle>
            <DialogDescription>@Localizer["McpEditorDescription"]</DialogDescription>
        </DialogHeader>

        @if (mcpDraft is not null)
        {
            <div class="space-y-4">
                <Field>
                    <FieldLabel>@Localizer["McpFieldName"]</FieldLabel>
                    <FieldContent>
                        <Input @bind-Value="mcpDraft.Name" Placeholder="@Localizer["McpFieldNamePlaceholder"]"
                               AriaLabel="@Localizer["McpFieldName"]" />
                        <TypographyMuted>@Localizer["McpFieldNameHelp"]</TypographyMuted>
                    </FieldContent>
                </Field>

                @* Two buttons rather than a Select: the transport decides whether this registration
                   can execute a local process, and TR-024 makes a Select's trigger paint its raw
                   bound value on first paint — "Stdio" instead of the sentence that explains it. *@
                <Field>
                    <FieldLabel>@Localizer["McpFieldTransport"]</FieldLabel>
                    <FieldContent>
                        <div class="flex flex-wrap gap-2">
                            <Button Variant="@(mcpDraft.Transport == McpTransportKind.Http ? ButtonVariant.Default : ButtonVariant.Outline)"
                                    OnClick="@(() => mcpDraft.Transport = McpTransportKind.Http)">
                                @Localizer["McpTransportHttp"]
                            </Button>
                            <Button Variant="@(mcpDraft.Transport == McpTransportKind.Stdio ? ButtonVariant.Default : ButtonVariant.Outline)"
                                    OnClick="@(() => mcpDraft.Transport = McpTransportKind.Stdio)">
                                @Localizer["McpTransportStdio"]
                            </Button>
                        </div>
                    </FieldContent>
                </Field>

                @if (mcpDraft.Transport == McpTransportKind.Http)
                {
                    <Field>
                        <FieldLabel>@Localizer["McpFieldEndpoint"]</FieldLabel>
                        <FieldContent>
                            <Input @bind-Value="mcpDraft.Endpoint" Placeholder="@Localizer["McpFieldEndpointPlaceholder"]"
                                   AriaLabel="@Localizer["McpFieldEndpoint"]" />
                            <TypographyMuted>@Localizer["McpFieldEndpointHelp"]</TypographyMuted>
                        </FieldContent>
                    </Field>
                }
                else
                {
                    @* Launching a nominated executable is the one thing on this screen that runs
                       code, so it says so rather than being discovered later. *@
                    <Alert Variant="AlertVariant.Warning">
                        <Alert.Icon><LucideIcon aria-hidden="true" Name="triangle-alert" Size="16" /></Alert.Icon>
                        <AlertDescription>@Localizer["McpStdioWarning"]</AlertDescription>
                    </Alert>

                    <Field>
                        <FieldLabel>@Localizer["McpFieldCommand"]</FieldLabel>
                        <FieldContent>
                            <Input @bind-Value="mcpDraft.Command" Placeholder="@Localizer["McpFieldCommandPlaceholder"]"
                                   AriaLabel="@Localizer["McpFieldCommand"]" />
                            <TypographyMuted>@Localizer["McpFieldCommandHelp"]</TypographyMuted>
                        </FieldContent>
                    </Field>
                    <Field>
                        <FieldLabel>@Localizer["McpFieldArguments"]</FieldLabel>
                        <FieldContent>
                            <Textarea @bind-Value="mcpDraft.ArgumentsText" Class="min-h-[90px]"
                                      Placeholder="@Localizer["McpFieldArgumentsPlaceholder"]"
                                      AriaLabel="@Localizer["McpFieldArguments"]" />
                            <TypographyMuted>@Localizer["McpFieldArgumentsHelp"]</TypographyMuted>
                        </FieldContent>
                    </Field>
                    <Field>
                        <FieldLabel>@Localizer["McpFieldWorkingDirectory"]</FieldLabel>
                        <FieldContent>
                            <Input @bind-Value="mcpDraft.WorkingDirectory"
                                   AriaLabel="@Localizer["McpFieldWorkingDirectory"]" />
                        </FieldContent>
                    </Field>
                }

                <Field>
                    <FieldLabel>@Localizer[mcpDraft.Transport == McpTransportKind.Http ? "McpFieldHeaders" : "McpFieldEnvironment"]</FieldLabel>
                    <FieldContent>
                        <TypographyMuted>@Localizer["McpFieldCredentialHelp"]</TypographyMuted>
                        @foreach (var credential in mcpDraft.Credentials)
                        {
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                <Input @bind-Value="credential.Name" Class="max-w-[220px]"
                                       Placeholder="@Localizer["McpCredentialNamePlaceholder"]"
                                       AriaLabel="@Localizer["McpCredentialNamePlaceholder"]" />
                                <Input @bind-Value="credential.Value" Type="InputType.Password" Class="max-w-[280px]"
                                       Placeholder="@Localizer[mcpDraft.IsExisting ? "McpCredentialValueKeepPlaceholder" : "McpCredentialValuePlaceholder"]"
                                       AriaLabel="@Localizer["McpCredentialValuePlaceholder"]" />
                                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                        OnClick="@(() => mcpDraft.Credentials.Remove(credential))">
                                    @Localizer["McpRemoveCredential"]
                                </Button>
                            </div>
                        }
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="mt-2"
                                OnClick="@(() => mcpDraft.AddCredential())">
                            @Localizer["McpAddCredential"]
                        </Button>
                    </FieldContent>
                </Field>

                <Field>
                    <FieldLabel>@Localizer["McpFieldAllowedTools"]</FieldLabel>
                    <FieldContent>
                        <Textarea @bind-Value="mcpDraft.AllowedToolsText" Class="min-h-[70px]"
                                  AriaLabel="@Localizer["McpFieldAllowedTools"]" />
                        <TypographyMuted>@Localizer["McpFieldAllowedToolsHelp"]</TypographyMuted>
                    </FieldContent>
                </Field>

                <div class="td-llm-pair">
                    <Field>
                        <FieldLabel>@Localizer["McpFieldTimeout"]</FieldLabel>
                        <FieldContent>
                            <NumericInput TValue="int" @bind-Value="mcpDraft.TimeoutSeconds" Min="1" Max="3600" Step="5" />
                        </FieldContent>
                    </Field>
                </div>

                <div class="flex items-center gap-3">
                    <Switch @bind-Checked="mcpDraft.IsEnabled" Id="mcp-enabled" />
                    <Label For="mcp-enabled">@Localizer["McpFieldEnabled"]</Label>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <Button Variant="ButtonVariant.Outline" OnClick="TestMcpServerAsync" Disabled="@isTestingMcp">
                        <Button.Icon><LucideIcon aria-hidden="true" Name="plug-zap" Size="16" /></Button.Icon>
                        @(isTestingMcp ? Localizer["McpTesting"] : Localizer["McpTestConnection"])
                    </Button>
                </div>

                @if (mcpProblems.Count > 0)
                {
                    <Alert Variant="AlertVariant.Danger">
                        <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
                        <AlertTitle>@Localizer["McpProblemsTitle"]</AlertTitle>
                        <AlertDescription>
                            <ul class="list-disc pl-5">
                                @foreach (var problem in mcpProblems)
                                {
                                    <li>@problem</li>
                                }
                            </ul>
                        </AlertDescription>
                    </Alert>
                }

                @if (mcpTestTools is not null)
                {
                    <Alert Variant="AlertVariant.Success">
                        <Alert.Icon><LucideIcon aria-hidden="true" Name="circle-check" Size="16" /></Alert.Icon>
                        <AlertTitle>@(Localizer["McpTestSucceededTitle", mcpTestTools.Count])</AlertTitle>
                        <AlertDescription>
                            @if (mcpTestTools.Count == 0)
                            {
                                <span>@Localizer["McpTestNoTools"]</span>
                            }
                            else
                            {
                                <ul class="list-disc pl-5">
                                    @foreach (var tool in mcpTestTools)
                                    {
                                        <li><b>@tool.Name</b> — @tool.Description</li>
                                    }
                                </ul>
                            }
                        </AlertDescription>
                    </Alert>
                }
            </div>
        }

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => showMcpEditor = false)">@Localizer["Cancel"]</Button>
            <Button OnClick="SaveMcpServerAsync" Disabled="@isSavingMcp">@(isSavingMcp ? Localizer["Saving"] : Localizer["McpSaveServer"])</Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@* MCP remove confirm (REQ-RAG-023) *@
<Dialog @bind-Open="showMcpRemoveDialog">
    <DialogContent>
        <DialogHeader>
            <DialogTitle>@(Localizer["McpRemoveTitle", pendingMcpRemove?.ServerName ?? string.Empty])</DialogTitle>
            <DialogDescription>@Localizer["McpRemoveBody"]</DialogDescription>
        </DialogHeader>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => showMcpRemoveDialog = false)">@Localizer["Cancel"]</Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="ConfirmRemoveMcpServerAsync">@Localizer["McpRemove"]</Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@code {
    /// <summary>The workspace URL slug from the route.</summary>
    [Parameter] public string Slug { get; set; } = string.Empty;

    private static readonly AgentKnowledgeScope[] KnowledgeScopes =
    [
        AgentKnowledgeScope.CallingWorkspace,
        AgentKnowledgeScope.SpecificWorkspaces,
        AgentKnowledgeScope.SpecificDocuments
    ];

    private Workspace? workspace;
    private bool notFound;
    private string? loadError;
    private string? loadedSlug;

    private readonly List<AgentDefinition> agents = new();
    private Dictionary<string, bool> catalogue = SkillCatalog.Defaults();
    private readonly List<string> availableModels = new();

    /// <summary>
    /// The skills this install can actually execute. As of REQ-RAG-022 (2026-07-30) that is all six
    /// catalogue entries — web search, web scrape, SQL query, chart generation and file operations
    /// joined RAG search — so no row is badged <c>Not built yet</c> in this build. The check stays
    /// because the badge is driven by the implementation list, not by a hard-coded assumption: a
    /// future catalogue entry that lands ahead of its tool must still be labelled honestly.
    /// </summary>
    private readonly HashSet<string> implementedSkills =
        new(WorkspaceSkillTools.ImplementedSkillNames, StringComparer.OrdinalIgnoreCase);

    private AgentDefinition? builtIn;
    private int builtInMaxToolCalls = AgentDefinition.DefaultMaxToolCalls;
    private int builtInTimeLimit = AgentDefinition.DefaultTimeLimitSeconds;

    private AgentDefinition? editor;
    private string editorHandle = string.Empty;
    private int editorMaxToolCalls = AgentDefinition.DefaultMaxToolCalls;
    private int editorTimeLimit = AgentDefinition.DefaultTimeLimitSeconds;
    private bool isEditingBuiltIn;

    private bool showEditor;
    private bool showDeleteDialog;
    private bool isSaving;
    private bool isSavingCatalogue;
    private AgentDefinition? pendingDelete;

    // ---- MCP servers (REQ-RAG-023) -------------------------------------------------------------

    private readonly List<McpServerRecord> mcpServers = new();
    private readonly List<string> mcpProblems = new();
    private string? mcpLoadError;
    private McpServerDraft? mcpDraft;
    private string? mcpOriginalName;
    private IReadOnlyList<McpAdvertisedTool>? mcpTestTools;
    private McpServerRecord? pendingMcpRemove;
    private bool showMcpEditor;
    private bool showMcpRemoveDialog;
    private bool isSavingMcp;
    private bool isTestingMcp;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (loadedSlug == Slug) return;
        loadedSlug = Slug;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        notFound = false;
        loadError = null;
        workspace = null;
        agents.Clear();

        try
        {
            workspace = await Workspaces.ResolveBySlugAsync(Slug);
            if (workspace is null)
            {
                notFound = true;
                return;
            }

            await RefreshAgentsAsync();
            await LoadAvailableModelsAsync();
            await RefreshMcpServersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load agents for {Slug}", Slug);
            loadError = ex.Message;
        }
    }

    private async Task RefreshAgentsAsync()
    {
        if (workspace is null) return;

        agents.Clear();
        agents.AddRange(await Agents.ListAsync(workspace.WorkspaceId));
        catalogue = new Dictionary<string, bool>(
            await Skills.GetCatalogueAsync(workspace.WorkspaceId), StringComparer.OrdinalIgnoreCase);

        builtIn = agents.FirstOrDefault(a => a.IsBuiltIn);
        if (builtIn is not null)
        {
            builtInMaxToolCalls = builtIn.MaxToolCalls;
            builtInTimeLimit = builtIn.TimeLimitSeconds;
        }
    }

    /// <summary>
    /// Offers the models the app is actually configured with, matching the composer's per-turn
    /// model list so an agent cannot be pointed at a provider that is not set up.
    /// </summary>
    private async Task LoadAvailableModelsAsync()
    {
        availableModels.Clear();
        try
        {
            var config = await RagConfig.LoadConfigAsync();
            AddModel(config.Llm.Model);
            if (config.LlmFallback is not null)
            {
                AddModel(config.LlmFallback.Model);
            }
        }
        catch (Exception ex)
        {
            // A missing provider config must not stop the editor rendering.
            Logger.LogWarning(ex, "Could not read the LLM configuration for the agent model list");
        }
    }

    private void AddModel(string? model)
    {
        if (string.IsNullOrWhiteSpace(model)) return;
        var trimmed = model.Trim();
        if (!availableModels.Contains(trimmed, StringComparer.Ordinal))
        {
            availableModels.Add(trimmed);
        }
    }

    // ---- Skill catalogue (REQ-RAG-022) ---------------------------------------------------------

    private async Task ToggleCatalogueAsync(string skillName, bool enabled)
    {
        if (workspace is null || isSavingCatalogue) return;

        isSavingCatalogue = true;
        try
        {
            await Skills.SetAsync(workspace.WorkspaceId, skillName, enabled, DateTime.UtcNow);
            catalogue[skillName] = enabled;

            var skillLabel = SkillDisplayName(skillName);
            ToastService.Success(
                enabled
                    ? Localizer["AgentsSkillEnabledToast", skillLabel].Value
                    : Localizer["AgentsSkillDisabledToast", skillLabel].Value,
                Localizer["AgentsCatalogueUpdated"].Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle skill {Skill}", skillName);
            ToastService.Error(ex.Message, Localizer["AgentsToggleSaveFailed"].Value);
        }
        finally
        {
            isSavingCatalogue = false;
        }
    }

    // ---- MCP servers (REQ-RAG-023) -------------------------------------------------------------

    /// <summary>
    /// Reloads this workspace's registrations. Reads the database only — no MCP server is contacted,
    /// so opening this screen never makes an outbound call (REQ-NFR-008).
    /// </summary>
    private async Task RefreshMcpServersAsync()
    {
        if (workspace is null) return;

        mcpLoadError = null;
        mcpServers.Clear();

        try
        {
            mcpServers.AddRange(await WorkspaceMcp.ListAsync(workspace.WorkspaceId));
        }
        catch (Exception ex)
        {
            // A registration store outage must not take the whole Agents screen down with it.
            Logger.LogError(ex, "Failed to load MCP servers for {Slug}", Slug);
            mcpLoadError = ex.Message;
        }
    }

    private void BeginAddMcpServer()
    {
        mcpDraft = McpServerDraft.ForNewServer();
        mcpOriginalName = null;
        mcpProblems.Clear();
        mcpTestTools = null;
        showMcpEditor = true;
    }

    private void BeginEditMcpServer(McpServerRecord record)
    {
        // Edit a copy: cancelling must leave the listed registration untouched.
        mcpDraft = McpServerDraft.From(record);
        mcpOriginalName = record.ServerName;
        mcpProblems.Clear();
        mcpTestTools = record.AdvertisedTools.Count > 0 ? record.AdvertisedTools : null;
        showMcpEditor = true;
    }

    /// <summary>
    /// Connects to the server the editor describes and shows what it advertises, saving nothing
    /// (REQ-RAG-023).
    /// </summary>
    private async Task TestMcpServerAsync()
    {
        if (workspace is null || mcpDraft is null || isTestingMcp) return;

        isTestingMcp = true;
        mcpProblems.Clear();
        mcpTestTools = null;

        try
        {
            var report = await WorkspaceMcp.TestAsync(workspace.WorkspaceId, mcpDraft);
            if (report.IsSuccess)
            {
                mcpTestTools = report.Tools;
                await RefreshMcpServersAsync();
            }
            else
            {
                mcpProblems.AddRange(report.Problems);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "MCP test connection failed");
            mcpProblems.Add(ex.Message);
        }
        finally
        {
            isTestingMcp = false;
        }
    }

    private async Task SaveMcpServerAsync()
    {
        if (workspace is null || mcpDraft is null || isSavingMcp) return;

        isSavingMcp = true;
        mcpProblems.Clear();

        try
        {
            var outcome = await WorkspaceMcp.SaveAsync(workspace.WorkspaceId, mcpDraft);
            if (!outcome.IsSuccess)
            {
                mcpProblems.AddRange(outcome.Problems);
                return;
            }

            // Renaming a server is a new registration under the new name, so the old row has to go
            // or the workspace quietly keeps both — and the agent would be offered the stale one.
            var renamedFrom = mcpOriginalName;
            if (!string.IsNullOrEmpty(renamedFrom)
                && !string.Equals(renamedFrom, mcpDraft.Name.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                await WorkspaceMcp.RemoveAsync(workspace.WorkspaceId, renamedFrom);
            }

            showMcpEditor = false;
            await RefreshMcpServersAsync();
            ToastService.Success(
                Localizer["McpSavedToast", mcpDraft.Name.Trim()].Value,
                Localizer["Saved"].Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save MCP server");
            mcpProblems.Add(ex.Message);
        }
        finally
        {
            isSavingMcp = false;
        }
    }

    private async Task ToggleMcpServerAsync(McpServerRecord record, bool isEnabled)
    {
        if (workspace is null || isSavingMcp) return;

        isSavingMcp = true;
        try
        {
            await WorkspaceMcp.SetEnabledAsync(workspace.WorkspaceId, record.ServerName, isEnabled);
            await RefreshMcpServersAsync();
            ToastService.Success(
                Localizer[isEnabled ? "McpEnabledToast" : "McpDisabledToast", record.ServerName].Value,
                Localizer["Saved"].Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle MCP server {Server}", record.ServerName);
            ToastService.Error(ex.Message, Localizer["SaveFailed"].Value);
        }
        finally
        {
            isSavingMcp = false;
        }
    }

    private void BeginRemoveMcpServer(McpServerRecord record)
    {
        pendingMcpRemove = record;
        showMcpRemoveDialog = true;
    }

    private async Task ConfirmRemoveMcpServerAsync()
    {
        if (workspace is null || pendingMcpRemove is null) return;

        var serverName = pendingMcpRemove.ServerName;
        showMcpRemoveDialog = false;
        pendingMcpRemove = null;

        try
        {
            await WorkspaceMcp.RemoveAsync(workspace.WorkspaceId, serverName);
            await RefreshMcpServersAsync();
            ToastService.Success(Localizer["McpRemovedToast", serverName].Value, Localizer["Saved"].Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove MCP server {Server}", serverName);
            ToastService.Error(ex.Message, Localizer["SaveFailed"].Value);
        }
    }

    /// <summary>Names the endpoint or executable a registration points at, for the list.</summary>
    /// <param name="record">The registration.</param>
    /// <returns>The endpoint URL, or the command path.</returns>
    private static string McpTarget(McpServerRecord record) =>
        record.Registration.Server.Transport == McpTransportKind.Http
            ? record.Registration.Server.Endpoint ?? string.Empty
            : record.Registration.Server.Command ?? string.Empty;

    /// <summary>Picks the resource key naming a registration's transport.</summary>
    /// <param name="record">The registration.</param>
    /// <returns>The resource key.</returns>
    private static string McpTransportKey(McpServerRecord record) =>
        record.Registration.Server.Transport == McpTransportKind.Http
            ? "McpTransportHttp"
            : "McpTransportStdio";

    /// <summary>
    /// Badges a stdio registration more prominently than an HTTP one: it is the transport that runs
    /// a local executable, and that is worth seeing at a glance in the list.
    /// </summary>
    /// <param name="record">The registration.</param>
    /// <returns>The badge variant.</returns>
    private static BadgeVariant McpTransportVariant(McpServerRecord record) =>
        record.Registration.Server.Transport == McpTransportKind.Stdio
            ? BadgeVariant.Secondary
            : BadgeVariant.Outline;

    /// <summary>Picks the resource key describing where MCP credentials actually land.</summary>
    /// <returns>The resource key.</returns>
    private string McpCredentialNoticeKey() => WorkspaceMcp.CredentialProtection switch
    {
        McpCredentialProtection.Keychain => "McpCredentialsKeychain",
        McpCredentialProtection.EncryptedSidecar => "McpCredentialsSidecar",
        _ => "McpCredentialsMemoryOnly"
    };

    /// <summary>Colours the credential notice by how much protection is actually in force.</summary>
    /// <returns>The alert variant.</returns>
    private AlertVariant McpCredentialAlertVariant() => WorkspaceMcp.CredentialProtection switch
    {
        McpCredentialProtection.Keychain => AlertVariant.Info,
        McpCredentialProtection.EncryptedSidecar => AlertVariant.Warning,
        _ => AlertVariant.Danger
    };

    // ---- Agent editor (REQ-UI-045) -------------------------------------------------------------

    private void BeginCreate()
    {
        if (workspace is null) return;

        isEditingBuiltIn = false;
        editor = new AgentDefinition { WorkspaceId = workspace.WorkspaceId };
        editor.SelectedSkills.Add(SkillCatalog.RagSearch);
        editorHandle = string.Empty;
        editorMaxToolCalls = editor.MaxToolCalls;
        editorTimeLimit = editor.TimeLimitSeconds;
        showEditor = true;
    }

    private void BeginEdit(AgentDefinition agent)
    {
        // Edit a copy: cancelling must leave the listed agent untouched.
        isEditingBuiltIn = agent.IsBuiltIn;
        editor = agent.Copy();
        editorHandle = agent.Handle;
        editorMaxToolCalls = agent.MaxToolCalls;
        editorTimeLimit = agent.TimeLimitSeconds;
        showEditor = true;
    }

    private void BeginDuplicate(AgentDefinition agent)
    {
        isEditingBuiltIn = false;
        editor = agent.Copy();
        editor.WorkspaceAgentId = 0;
        editor.IsBuiltIn = false;
        editor.LastUsedAt = null;
        editor.CreatedAt = default;
        editor.DisplayName = Localizer["AgentsDuplicateNameSuffix", agent.DisplayName];
        editorHandle = AgentMentionParser.SuggestHandle(editor.DisplayName);
        editorMaxToolCalls = editor.MaxToolCalls;
        editorTimeLimit = editor.TimeLimitSeconds;
        showEditor = true;
    }

    /// <summary>
    /// Keeps the handle in step with the display name while the handle is still untouched, so
    /// creating "Contract Analyst" offers @@contract-analyst rather than an empty required field.
    /// </summary>
    /// <param name="value">The new display name.</param>
    private void OnDisplayNameChanged(string? value)
    {
        if (editor is null) return;

        var previousSuggestion = AgentMentionParser.SuggestHandle(editor.DisplayName);
        editor.DisplayName = value ?? string.Empty;

        if (!editor.IsBuiltIn
            && (string.IsNullOrWhiteSpace(editorHandle) || editorHandle == previousSuggestion))
        {
            editorHandle = AgentMentionParser.SuggestHandle(editor.DisplayName);
        }
    }

    private void OnEditorModelChanged(string? value)
    {
        if (editor is null) return;
        editor.Model = string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private void OnKnowledgeScopeChanged(string? value)
    {
        if (editor is null) return;
        editor.KnowledgeScope = Enum.TryParse<AgentKnowledgeScope>(value, out var parsed)
            ? parsed
            : AgentKnowledgeScope.CallingWorkspace;
    }

    private IReadOnlyList<AgentSkillState> EditorSkillStates() =>
        editor is null
            ? []
            : AgentSkillResolver.Describe(
                catalogue, editor.SelectedSkills, editor.UsesEveryEnabledSkill, implementedSkills);

    private void ToggleEditorSkill(string skillName, bool selected)
    {
        if (editor is null) return;

        // The catalogue is the outer boundary: an agent can never turn on what it forbids. The
        // switch is already disabled for those rows; this is the guard behind the disabled state.
        if (!catalogue.TryGetValue(skillName, out var permitted) || !permitted)
        {
            return;
        }

        if (selected)
        {
            editor.SelectedSkills.Add(skillName);
        }
        else
        {
            editor.SelectedSkills.Remove(skillName);
        }
    }

    private async Task SaveEditorAsync()
    {
        if (editor is null || workspace is null || isSaving) return;

        isSaving = true;
        try
        {
            editor.Handle = editor.IsBuiltIn ? AgentDefinition.BuiltInHandle : editorHandle;
            editor.MaxToolCalls = editorMaxToolCalls;
            editor.TimeLimitSeconds = editorTimeLimit;
            editor.WorkspaceId = workspace.WorkspaceId;

            await Agents.SaveAsync(editor);
            await RefreshAgentsAsync();

            showEditor = false;
            ToastService.Success(
                Localizer["AgentsAgentSavedToast", "@" + editor.Handle].Value,
                Localizer["AgentsAgentSavedTitle"].Value);
        }
        catch (InvalidOperationException ex)
        {
            // Expected refusals — a taken handle, an unusable handle, a missing name.
            ToastService.Error(ex.Message, Localizer["AgentsSaveAgentFailed"].Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save agent");
            ToastService.Error(ex.Message, Localizer["AgentsSaveAgentFailed"].Value);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveBuiltInAsync()
    {
        if (builtIn is null || workspace is null || isSaving) return;

        isSaving = true;
        try
        {
            builtIn.MaxToolCalls = builtInMaxToolCalls;
            builtIn.TimeLimitSeconds = builtInTimeLimit;
            await Agents.SaveAsync(builtIn);
            await RefreshAgentsAsync();
            ToastService.Success(Localizer["AgentsBehaviourSavedToast"].Value, Localizer["Saved"].Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save built-in agent behaviour");
            ToastService.Error(ex.Message, Localizer["SaveFailed"].Value);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResetBuiltInAsync()
    {
        if (workspace is null || builtIn is null) return;

        try
        {
            var defaults = AgentDefinition.BuiltIn(workspace.WorkspaceId, DateTime.UtcNow);
            defaults.WorkspaceAgentId = builtIn.WorkspaceAgentId;
            defaults.CreatedAt = builtIn.CreatedAt;

            if (defaults.WorkspaceAgentId == 0)
            {
                // Never edited, so it is already at its defaults — nothing to write.
                ToastService.Success(
                    Localizer["AgentsAlreadyDefaultToast"].Value,
                    Localizer["AgentsNothingToReset"].Value);
                return;
            }

            await Agents.SaveAsync(defaults);
            await RefreshAgentsAsync();
            ToastService.Success(
                Localizer["AgentsResetDoneToast"].Value,
                Localizer["AgentsResetDoneTitle"].Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset the built-in agent");
            ToastService.Error(ex.Message, Localizer["AgentsResetFailed"].Value);
        }
    }

    private void BeginDelete(AgentDefinition agent)
    {
        pendingDelete = agent;
        showDeleteDialog = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (pendingDelete is null || workspace is null) return;

        try
        {
            await Agents.DeleteAsync(workspace.WorkspaceId, pendingDelete.WorkspaceAgentId);
            await RefreshAgentsAsync();
            ToastService.Success(
                Localizer["AgentsAgentDeletedToast", "@" + pendingDelete.Handle].Value,
                Localizer["AgentsAgentDeletedTitle"].Value);
        }
        catch (InvalidOperationException ex)
        {
            ToastService.Error(ex.Message, Localizer["AgentsDeleteFailed"].Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete agent");
            ToastService.Error(ex.Message, Localizer["AgentsDeleteFailed"].Value);
        }
        finally
        {
            showDeleteDialog = false;
            pendingDelete = null;
        }
    }

    // ---- Presentation ---------------------------------------------------------------------------

    /// <summary>
    /// Summarises an agent's skills as the intersection actually is, not as the agent asked for it —
    /// so a row never advertises a skill the catalogue has since revoked.
    /// </summary>
    /// <param name="agent">The agent row.</param>
    /// <returns>The display text.</returns>
    private string SkillSummary(AgentDefinition agent)
    {
        var permitted = AgentSkillResolver.Permitted(catalogue, agent);
        if (permitted.Count == 0)
        {
            return Localizer["AgentsNonePermitted"].Value;
        }

        var names = permitted
            .Select(SkillDisplayName)
            .ToList();
        return agent.UsesEveryEnabledSkill
            ? Localizer["AgentsAllEnabledCount", names.Count].Value
            : string.Join(", ", names);
    }

    private string KnowledgeSummary(AgentDefinition agent) =>
        agent.RestrictToPinned
            ? Localizer["AgentsKnowledgePinnedOnly", workspace?.Name].Value
            : workspace?.Name ?? Localizer["AgentsThisWorkspace"].Value;

    private string KnowledgeLabel(AgentKnowledgeScope scope) => scope switch
    {
        AgentKnowledgeScope.SpecificWorkspaces => Localizer["AgentsScopeSpecificWorkspaces"].Value,
        AgentKnowledgeScope.SpecificDocuments => Localizer["AgentsScopeSpecificDocuments"].Value,
        _ => Localizer["AgentsScopeCallingWorkspace"].Value
    };

    /// <summary>Renders the selected knowledge scope's label on the Select trigger.</summary>
    /// <param name="value">The bound enum name.</param>
    /// <returns>The option text.</returns>
    private string KnowledgeTextFor(string value) =>
        KnowledgeLabel(Enum.TryParse<AgentKnowledgeScope>(value, out var parsed)
            ? parsed
            : AgentKnowledgeScope.CallingWorkspace);

    /// <summary>Renders the selected model on the Select trigger.</summary>
    /// <param name="value">The bound model id, or an empty string.</param>
    /// <returns>The option text.</returns>
    private string ModelTextFor(string value) =>
        string.IsNullOrWhiteSpace(value) ? Localizer["AgentsFollowWorkspaceDefault"].Value : value;

    private static BadgeVariant ExposureVariant(SkillExposure exposure) => exposure switch
    {
        SkillExposure.LeavesMachine => BadgeVariant.Secondary,
        SkillExposure.NeedsReview => BadgeVariant.Destructive,
        _ => BadgeVariant.Outline
    };

    /// <summary>
    /// REQ-UI-051: the localized name of a catalogue skill.
    /// </summary>
    /// <param name="name">The invariant tool name — the key handed to the LLM.</param>
    /// <returns>The label shown on the catalogue and in the agent editor.</returns>
    /// <remarks>
    /// <para>
    /// <see cref="SkillCatalog"/> now carries resource KEYS rather than English, so this is a
    /// lookup rather than a second copy of the catalogue. The switch it replaced had six arms and
    /// a fallback to the catalogue's own English — which meant a seventh skill would have shipped
    /// English on every install, and two call sites on this page (the toggle toast and the agent
    /// row's skill summary) never went through the switch at all and were English already.
    /// </para>
    /// <para>
    /// A name the catalogue does not know is shown as itself: that is a tool the model named, not
    /// a label, and there is nothing to look up.
    /// </para>
    /// </remarks>
    private string SkillDisplayName(string name) =>
        SkillCatalog.Find(name) is { } skill ? Localizer[skill.DisplayNameKey].Value : name;

    /// <summary>REQ-UI-051: the localized one-line explanation of a catalogue skill.</summary>
    /// <param name="name">The invariant tool name.</param>
    /// <returns>The description shown under the skill's label.</returns>
    private string SkillDescription(string name) =>
        SkillCatalog.Find(name) is { } skill ? Localizer[skill.DescriptionKey].Value : string.Empty;

    /// <summary>REQ-UI-051: the localized exposure badge for a skill.</summary>
    /// <param name="exposure">The exposure to describe.</param>
    /// <returns>The badge text.</returns>
    private string ExposureLabelText(SkillExposure exposure) =>
        Localizer[SkillCatalog.ExposureLabelKey(exposure)].Value;

    private void GoToChat() => Nav.NavigateTo($"/workspace/{Slug}");

    /// <summary>
    /// Opens chat with the handle already typed, which is what "run in chat" means once invocation
    /// is a composer mention rather than a separate run button (REQ-RAG-021).
    /// </summary>
    /// <param name="agent">The agent to invoke.</param>
    private void RunInChat(AgentDefinition agent) =>
        Nav.NavigateTo($"/workspace/{Slug}?agent={Uri.EscapeDataString(agent.Handle)}");
}
