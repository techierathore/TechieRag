@page "/workspace/{Slug}/agents"
@using TechieDesk.Services.Agents
@using TechieDesk.Services.Agents.Mcp
@using TechieRag.Mcp
@using TrBlazeUI.Components.NumericInput
@inject IWorkspaceService Workspaces
@inject IAgentRegistry Agents
@* REQ-RAG-023 (BRD-86): the workspace's registered MCP tool servers. *@
@inject IWorkspaceMcpService WorkspaceMcp
@inject IWorkspaceSkillRepository Skills
@inject TechieRagConfigService RagConfig
@inject ToastService ToastService
@inject NavigationManager Nav
@inject ILogger<WorkspaceAgents> Logger
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["AgentsPageTitle", workspace?.Name ?? Localizer["AgentsWorkspaceFallback"].Value]</PageTitle>

@if (notFound)
{
    <Alert Variant="AlertVariant.Danger">
        <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
        <AlertTitle>@Localizer["AgentsWorkspaceNotAvailableTitle"]</AlertTitle>
        <AlertDescription>@Localizer["AgentsWorkspaceNotAvailableBody"]</AlertDescription>
    </Alert>
}
@* A persistence outage is a different problem from a missing workspace and must say so, rather
   than telling the user their workspace has vanished (REQ-NFR-010 / BRD-101). *@
else if (loadError is not null)
{
    <Alert Variant="AlertVariant.Danger">
        <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
        <AlertTitle>@Localizer["AgentsRegistryUnavailableTitle"]</AlertTitle>
        <AlertDescription>
            @(Localizer["AgentsRegistryUnavailableBody", loadError])
        </AlertDescription>
    </Alert>
}
else if (workspace is null)
{
    <div class="flex items-center gap-2 text-muted-foreground">
        <Spinner Size="SpinnerSize.Small" /> <span>@Localizer["AgentsLoading"]</span>
    </div>
}
else
{
    <div class="mb-4 flex flex-wrap items-center gap-3">
        <div>
            <h1 class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0">@(Localizer["AgentsPageHeading", workspace.Name])</h1>
            <TypographyMuted>@Localizer["AgentsPageSubtitle"]</TypographyMuted>
        </div>
        <div class="ml-auto flex items-center gap-2">
            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="GoToChat">
                <Button.Icon><LucideIcon aria-hidden="true" Name="message-square" Size="16" /></Button.Icon>
                @Localizer["AgentsOpenChat"]
            </Button>
            <Button OnClick="BeginCreate">
                <Button.Icon><LucideIcon aria-hidden="true" Name="plus" Size="16" /></Button.Icon>
                @Localizer["AgentsNewAgent"]
            </Button>
        </div>
    </div>

    <Alert Variant="AlertVariant.Info" Class="mb-4">
        <Alert.Icon><LucideIcon aria-hidden="true" Name="at-sign" Size="16" /></Alert.Icon>
        <AlertDescription>
            @Localizer["AgentsInvokeHintLead"] <b>@("@" + AgentDefinition.BuiltInHandle)</b>@Localizer["AgentsInvokeHintTail"]
        </AlertDescription>
    </Alert>

    <Tabs DefaultValue="agents">
        <TabsList Class="grid w-full grid-cols-4">
            <TabsTrigger Value="agents">@Localizer["AgentsTabAgents"]</TabsTrigger>
            <TabsTrigger Value="skills">@Localizer["AgentsTabSkillCatalogue"]</TabsTrigger>
            <TabsTrigger Value="mcp">@Localizer["AgentsTabMcpServers"]</TabsTrigger>
            <TabsTrigger Value="runs">@Localizer["AgentsTabRunHistory"]</TabsTrigger>
        </TabsList>

        <!-- Agents (REQ-UI-045) -->
        <TabsContent Value="agents" ForceMount="true">
            <Card Class="overflow-hidden">
                <CardHeader>
                    <CardTitle>@Localizer["AgentsYourAgentsTitle"]</CardTitle>
                    <CardDescription>
                        @Localizer["AgentsYourAgentsDescription"]
                    </CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="relative overflow-x-auto">
                        <DataTable TData="AgentDefinition" Data="@agents" ShowToolbar="false" ShowPagination="false"
                                   AriaLabel="@Localizer["AgentsTableAriaLabel"]">
                            <Columns>
                                <DataTableColumn TData="AgentDefinition" TValue="string" Property="@(a => a.Handle)" Header="@Localizer["AgentsAgent"]">
                                    <CellTemplate Context="row">
                                        <div class="font-semibold">@("@" + row.Handle)</div>
                                        @* REQ-UI-055: the shipped built-in wording is TechieDesk's and is translated;
                                           a name the operator typed is theirs and comes back verbatim. One line on
                                           purpose — split, the counter's tag-stripper leaves a phantom English run. *@
                                        <div class="text-xs text-muted-foreground">
                                            @(row.HasShippedBuiltInWording ? Localizer[AgentDefinition.BuiltInDisplayNameKey].Value : row.DisplayName)@(row.HasShippedBuiltInWording ? " — " + Localizer[AgentDefinition.BuiltInDescriptionKey].Value : string.IsNullOrWhiteSpace(row.Description) ? "" : " — " + row.Description)
                                        </div>
                                    </CellTemplate>
                                </DataTableColumn>
                                <DataTableColumn TData="AgentDefinition" TValue="string" Property="@(a => a.Model ?? string.Empty)" Header="@Localizer["AgentsModel"]">
                                    <CellTemplate Context="row">
                                        <span class="text-sm">@(string.IsNullOrWhiteSpace(row.Model) ? Localizer["AgentsFollowsWorkspaceDefault"].Value : row.Model)</span>
                                    </CellTemplate>
                                </DataTableColumn>
                                <DataTableColumn TData="AgentDefinition" TValue="string" Property="@(a => string.Empty)" Header="@Localizer["AgentsSkills"]">
                                    <CellTemplate Context="row">
                                        <span class="text-sm">@SkillSummary(row)</span>
                                    </CellTemplate>
                                </DataTableColumn>
                                <DataTableColumn TData="AgentDefinition" TValue="string" Property="@(a => string.Empty)" Header="@Localizer["AgentsKnowledge"]">
                                    <CellTemplate Context="row">
                                        <span class="text-sm">@KnowledgeSummary(row)</span>
                                    </CellTemplate>
                                </DataTableColumn>
                                <DataTableColumn TData="AgentDefinition" TValue="string" Property="@(a => string.Empty)" Header="@Localizer["AgentsLastUsed"]">
                                    <CellTemplate Context="row">
                                        <span class="text-sm text-muted-foreground">
                                            @(row.LastUsedAt is null ? Localizer["AgentsNever"].Value : row.LastUsedAt.Value.ToLocalTime().ToString("d MMM HH:mm"))
                                        </span>
                                    </CellTemplate>
                                </DataTableColumn>
                                <DataTableColumn TData="AgentDefinition" TValue="string" Property="@(a => string.Empty)" Header="@Localizer["AgentsColumnActions"]" HeaderClass="td-th-label-hidden">
                                    <CellTemplate Context="row">
                                        <div class="flex items-center justify-end gap-1">
                                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                                    OnClick="@(() => BeginEdit(row))">@Localizer["AgentsEdit"]</Button>
                                            <DropdownMenu>
                                                @* REQ-NFR-005: the trigger renders its own button, so the
                                                   inner content must not be another interactive control. *@
                                                <DropdownMenuTrigger>
                                                    <span class="rounded p-1 text-muted-foreground hover:bg-muted">
                                                        <LucideIcon aria-hidden="true" Name="ellipsis" Size="16" />
                                                        <span class="sr-only">@(Localizer["AgentsRowActionsFor", "@" + row.Handle])</span>
                                                    </span>
                                                </DropdownMenuTrigger>
                                                <DropdownMenuContent>
                                                    <DropdownMenuItem OnClick="@(() => RunInChat(row))">
                                                        <LucideIcon aria-hidden="true" Name="message-square" Size="14" />
                                                        <span class="ml-2">@Localizer["AgentsRunInChat"]</span>
                                                    </DropdownMenuItem>
                                                    <DropdownMenuItem OnClick="@(() => BeginDuplicate(row))">
                                                        <LucideIcon aria-hidden="true" Name="copy" Size="14" />
                                                        <span class="ml-2">@Localizer["AgentsDuplicate"]</span>
                                                    </DropdownMenuItem>
                                                    @if (row.IsBuiltIn)
                                                    {
                                                        <DropdownMenuSeparator />
                                                        <DropdownMenuItem OnClick="ResetBuiltInAsync">
                                                            <LucideIcon aria-hidden="true" Name="rotate-ccw" Size="14" />
                                                            <span class="ml-2">@Localizer["AgentsResetToDefaults"]</span>
                                                        </DropdownMenuItem>
                                                    }
                                                    else
                                                    {
                                                        <DropdownMenuSeparator />
                                                        <DropdownMenuItem OnClick="@(() => BeginDelete(row))">
                                                            <LucideIcon aria-hidden="true" Name="trash-2" Size="14" />
                                                            <span class="ml-2">@Localizer["AgentsDelete"]</span>
                                                        </DropdownMenuItem>
                                                    }
                                                </DropdownMenuContent>
                                            </DropdownMenu>
                                        </div>
                                    </CellTemplate>
                                </DataTableColumn>
                            </Columns>
                        </DataTable>
                    </div>
                    @* The built-in agent is not a row anyone created, so its rule is stated rather
                       than left to be discovered by a delete that refuses. *@
                    <TypographyMuted Class="mt-3 block">
                        @(Localizer["AgentsBuiltInNote", "@" + AgentDefinition.BuiltInHandle])
                    </TypographyMuted>
                </CardContent>
            </Card>

            <Card Class="mt-4">
                <CardHeader>
                    <CardTitle>@Localizer["AgentsRelationTitle"]</CardTitle>
                </CardHeader>
                <CardContent>
                    <TypographyMuted>
                        @Localizer["AgentsRelationLead"] <b>@Localizer["AgentsTabSkillCatalogue"]</b> @Localizer["AgentsRelationMid"] <i>@Localizer["AgentsRelationScope"]</i> @Localizer["AgentsRelationTail"]
                    </TypographyMuted>
                </CardContent>
            </Card>
        </TabsContent>

        <!-- Skill catalogue (REQ-RAG-022) -->
        <TabsContent Value="skills" ForceMount="true">
            <Card>
                <CardHeader>
                    <CardTitle>@Localizer["AgentsCatalogueTitle"]</CardTitle>
                    <CardDescription>
                        @Localizer["AgentsCatalogueDescription"]
                    </CardDescription>
                </CardHeader>
                <CardContent Class="space-y-1">
                    @foreach (var skill in SkillCatalog.Skills)
                    {
                        <div class="flex items-center gap-3 border-b py-3 last:border-b-0">
                            <Switch Checked="@catalogue[skill.Name]"
                                    CheckedChanged="@((bool value) => ToggleCatalogueAsync(skill.Name, value))"
                                    Id="@($"skill-{skill.Name}")" Disabled="@isSavingCatalogue" />
                            <div class="min-w-0 flex-1">
                                <Label For="@($"skill-{skill.Name}")" Class="font-semibold">@SkillDisplayName(skill.Name)</Label>
                                <div class="text-xs text-muted-foreground">@SkillDescription(skill.Name)</div>
                            </div>
                            @if (!implementedSkills.Contains(skill.Name))
                            {
                                @* Permission and availability are different facts. Saying "not built yet"
                                   is the honest label; leaving the row looking ready would promise a tool
                                   this install cannot run. *@
                                <Badge Variant="BadgeVariant.Outline">@Localizer["AgentsNotBuiltYet"]</Badge>
                            }
                            <Badge Variant="@ExposureVariant(skill.Exposure)">@ExposureLabelText(skill.Exposure)</Badge>
                        </div>
                    }
                    <Alert Variant="AlertVariant.Warning" Class="mt-4">
                        <Alert.Icon><LucideIcon aria-hidden="true" Name="shield-alert" Size="16" /></Alert.Icon>
                        <AlertDescription>
                            @Localizer["AgentsExposureWarningLead"] <b>@Localizer["AgentsExposureNeedsReview"]</b> @Localizer["AgentsExposureOr"] <b>@Localizer["AgentsExposureLeavesMachine"]</b> @Localizer["AgentsExposureWarningTail"]
                        </AlertDescription>
                    </Alert>
                </CardContent>
            </Card>

            @if (builtIn is not null)
            {
                <Card Class="mt-4">
                    <CardHeader>
                        <CardTitle>@Localizer["AgentsBehaviourTitle"]</CardTitle>
                        <CardDescription>
                            @(Localizer["AgentsBehaviourDescription", "@" + AgentDefinition.BuiltInHandle])
                        </CardDescription>
                    </CardHeader>
                    <CardContent Class="space-y-4">
                        <div class="td-llm-pair">
                            <Field>
                                <FieldLabel>@Localizer["AgentsMaxToolCalls"]</FieldLabel>
                                <FieldContent>
                                    <NumericInput TValue="int" @bind-Value="builtInMaxToolCalls" Min="1" Max="@AgentRegistry.MaxToolCallCeiling" Step="1" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel>@Localizer["AgentsTimeLimit"]</FieldLabel>
                                <FieldContent>
                                    <NumericInput TValue="int" @bind-Value="builtInTimeLimit" Min="5" Max="@AgentRegistry.TimeLimitCeiling" Step="5" />
                                </FieldContent>
                            </Field>
                        </div>
                        <div class="flex items-center gap-3">
                            <Switch @bind-Checked="builtIn.ShowTrace" Id="builtin-trace" />
                            <Label For="builtin-trace">@Localizer["AgentsShowTrace"]</Label>
                        </div>
                        <div class="flex items-center gap-3">
                            <Switch @bind-Checked="builtIn.ConfirmEgress" Id="builtin-egress" />
                            <Label For="builtin-egress">@Localizer["AgentsConfirmEgress"]</Label>
                        </div>
                        <div class="flex items-center gap-3">
                            <Switch @bind-Checked="builtIn.AllowFollowUp" Id="builtin-followup" />
                            <Label For="builtin-followup">@Localizer["AgentsAllowFollowUpBuiltIn"]</Label>
                        </div>
                        <Button OnClick="SaveBuiltInAsync" Disabled="@isSaving">@(isSaving ? Localizer["Saving"] : Localizer["AgentsSaveBehaviour"])</Button>
                    </CardContent>
                </Card>
            }
        </TabsContent>

        @* MCP servers — REQ-RAG-023 (BRD-86). Registration, enable/disable, and the tools each
           server advertises.

           NOT using TrBlazeUI's <Empty>: in 1.0.7 it silently drops Title and Description and
           renders the icon alone, so the whole explanation below would vanish with no compile
           error. Reported by the orchestrator 2026-07-27; hand-written markup until it is fixed. *@
        <TabsContent Value="mcp" ForceMount="true">
            <Card>
                <CardHeader>
                    <CardTitle>@Localizer["McpTitle"]</CardTitle>
                    <CardDescription>@Localizer["McpDescription"]</CardDescription>
                </CardHeader>
                <CardContent Class="space-y-4">
                    <div class="flex flex-wrap items-center gap-3">
                        <Button OnClick="BeginAddMcpServer">
                            <Button.Icon><LucideIcon aria-hidden="true" Name="plus" Size="16" /></Button.Icon>
                            @Localizer["McpAddServer"]
                        </Button>
                    </div>

                    @* REQ-FN-039 / REQ-FN-043: where a token actually lands is not a detail the
                       operator should discover after it disappears, so the tier in force is stated
                       before anything is saved. *@
                    <Alert Variant="@McpCredentialAlertVariant()">
                        <Alert.Icon><LucideIcon aria-hidden="true" Name="key-round" Size="16" /></Alert.Icon>
                        <AlertDescription>@Localizer[McpCredentialNoticeKey()]</AlertDescription>
                    </Alert>

                    @if (mcpLoadError is not null)
                    {
                        <Alert Variant="AlertVariant.Danger">
                            <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
                            <AlertTitle>@Localizer["McpLoadFailedTitle"]</AlertTitle>
                            <AlertDescription>@(Localizer["McpLoadFailedBody", mcpLoadError])</AlertDescription>
                        </Alert>
                    }
                    else if (mcpServers.Count == 0)
                    {
                        <div class="td-agent-empty">
                            <LucideIcon aria-hidden="true" Name="server" Size="40" Class="text-muted-foreground" />
                            <h3 class="text-base font-semibold">@Localizer["AgentsMcpEmptyTitle"]</h3>
                            <TypographyMuted>@Localizer["AgentsMcpEmptyBody"]</TypographyMuted>
                        </div>
                    }
                    else
                    {
                        <div class="relative overflow-x-auto">
                            <DataTable TData="McpServerRecord" Data="@mcpServers" ShowToolbar="false" ShowPagination="false"
                                       AriaLabel="@Localizer["McpTableAriaLabel"]">
                                <Columns>
                                    <DataTableColumn TData="McpServerRecord" TValue="string" Property="@(s => s.ServerName)" Header="@Localizer["McpColumnServer"]">
                                        <CellTemplate Context="row">
                                            <div class="font-semibold">@row.ServerName</div>
                                            <div class="text-xs text-muted-foreground">@McpTarget(row)</div>
                                        </CellTemplate>
                                    </DataTableColumn>
                                    <DataTableColumn TData="McpServerRecord" TValue="string" Property="@(s => string.Empty)" Header="@Localizer["McpColumnTransport"]">
                                        <CellTemplate Context="row">
                                            <Badge Variant="@McpTransportVariant(row)">@Localizer[McpTransportKey(row)]</Badge>
                                        </CellTemplate>
                                    </DataTableColumn>
                                    <DataTableColumn TData="McpServerRecord" TValue="string" Property="@(s => string.Empty)" Header="@Localizer["McpColumnTools"]">
                                        <CellTemplate Context="row">
                                            @if (row.AdvertisedTools.Count == 0)
                                            {
                                                <span class="text-sm text-muted-foreground">@Localizer["McpToolsNotCheckedYet"]</span>
                                            }
                                            else
                                            {
                                                <div class="text-sm">@string.Join(", ", row.AdvertisedTools.Select(t => t.Name))</div>
                                                <div class="text-xs text-muted-foreground">
                                                    @(Localizer["McpToolsCheckedAt", row.LastCheckedUtc!.Value.ToLocalTime().ToString("d MMM HH:mm")])
                                                </div>
                                            }
                                            @if (row.UnrecoverableSecretKeyNames().Count > 0)
                                            {
                                                <div class="text-xs text-destructive">
                                                    @(Localizer["McpCredentialLost", string.Join(", ", row.UnrecoverableSecretKeyNames())])
                                                </div>
                                            }
                                        </CellTemplate>
                                    </DataTableColumn>
                                    <DataTableColumn TData="McpServerRecord" TValue="string" Property="@(s => string.Empty)" Header="@Localizer["McpColumnEnabled"]">
                                        <CellTemplate Context="row">
                                            <div class="flex items-center gap-2">
                                                <Switch Checked="@row.IsEnabled"
                                                        CheckedChanged="@((bool value) => ToggleMcpServerAsync(row, value))"
                                                        Disabled="@isSavingMcp"
                                                        Id="@("mcp-enabled-" + row.ServerName)" />
                                                <Label For="@("mcp-enabled-" + row.ServerName)">
                                                    @Localizer[row.IsEnabled ? "McpEnabled" : "McpDisabled"]
                                                </Label>
                                            </div>
                                        </CellTemplate>
                                    </DataTableColumn>
                                    <DataTableColumn TData="McpServerRecord" TValue="string" Property="@(s => string.Empty)" Header="@Localizer["AgentsColumnActions"]" HeaderClass="td-th-label-hidden">
                                        <CellTemplate Context="row">
                                            <div class="flex items-center justify-end gap-1">
                                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                                        OnClick="@(() => BeginEditMcpServer(row))">@Localizer["AgentsEdit"]</Button>
                                                <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                                                        OnClick="@(() => BeginRemoveMcpServer(row))">@Localizer["McpRemove"]</Button>
                                            </div>
                                        </CellTemplate>
                                    </DataTableColumn>
                                </Columns>
                            </DataTable>
                        </div>
                    }

                    <TypographyMuted Class="block">@Localizer["McpScopeNote"]</TypographyMuted>
                </CardContent>
            </Card>
        </TabsContent>

        <!-- Run history — persisted runs are not built; the live trace lives in chat. -->
        <TabsContent Value="runs" ForceMount="true">
            <Card>
                <CardContent Class="p-6">
                    <div class="td-agent-empty">
                        <LucideIcon aria-hidden="true" Name="history" Size="40" Class="text-muted-foreground" />
                        <h3 class="text-base font-semibold">@Localizer["AgentsRunsEmptyTitle"]</h3>
                        <TypographyMuted>
                            @Localizer["AgentsRunsEmptyBody"]
                        </TypographyMuted>
                        <Button Variant="ButtonVariant.Outline" OnClick="GoToChat">@Localizer["AgentsOpenChat"]</Button>
                    </div>
                </CardContent>
            </Card>
        </TabsContent>
    </Tabs>
}

<!-- Agent editor (REQ-UI-045) -->
<Dialog @bind-Open="showEditor">
    <DialogContent Class="max-w-3xl">
        <DialogHeader>
            <DialogTitle>@(editor is null ? Localizer["AgentsAgent"] : editor.WorkspaceAgentId == 0 && !isEditingBuiltIn ? Localizer["AgentsNewAgent"] : Localizer["AgentsEditorTitleNamed", editor.DisplayName])</DialogTitle>
            <DialogDescription>
                @if (editor is not null && AgentMentionParser.IsValidHandle(editorHandle))
                {
                    <span>@Localizer["AgentsCalledAsLead"] <b>@("@" + AgentMentionParser.Normalize(editorHandle))</b> @Localizer["AgentsCalledAsTail"]</span>
                }
                else
                {
                    <span>@Localizer["AgentsHandlePrompt"]</span>
                }
            </DialogDescription>
        </DialogHeader>

        @if (editor is not null)
        {
            <Tabs DefaultValue="identity">
                <TabsList Class="grid w-full grid-cols-4">
                    <TabsTrigger Value="identity">@Localizer["AgentsTabIdentity"]</TabsTrigger>
                    <TabsTrigger Value="editorskills">@Localizer["AgentsSkills"]</TabsTrigger>
                    <TabsTrigger Value="knowledge">@Localizer["AgentsKnowledge"]</TabsTrigger>
                    <TabsTrigger Value="guardrails">@Localizer["AgentsTabGuardrails"]</TabsTrigger>
                </TabsList>

                <TabsContent Value="identity" ForceMount="true">
                    <div class="td-llm-pair">
                        <Field>
                            <FieldLabel>@Localizer["AgentsDisplayName"]</FieldLabel>
                            <FieldContent>
                                <Input Value="@editor.DisplayName" ValueChanged="OnDisplayNameChanged"
                                       Placeholder="@Localizer["AgentsDisplayNamePlaceholder"]" AriaLabel="@Localizer["AgentsDisplayName"]" />
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel>@Localizer["AgentsHandle"]</FieldLabel>
                            <FieldContent>
                                <Input @bind-Value="editorHandle" Placeholder="@Localizer["AgentsHandlePlaceholder"]" AriaLabel="@Localizer["AgentsHandle"]"
                                       Disabled="@editor.IsBuiltIn" />
                                <FieldDescription>
                                    @Localizer["AgentsHandleHelp"]
                                    @if (editor.IsBuiltIn)
                                    {
                                        <span> @Localizer["AgentsBuiltInHandleFixed"]</span>
                                    }
                                </FieldDescription>
                            </FieldContent>
                        </Field>
                    </div>
                    <Field>
                        <FieldLabel>@Localizer["AgentsDescription"]</FieldLabel>
                        <FieldContent>
                            <Input @bind-Value="editor.Description" Placeholder="@Localizer["AgentsDescriptionPlaceholder"]" AriaLabel="@Localizer["AgentsDescription"]" />
                        </FieldContent>
                    </Field>
                    <Field>
                        <FieldLabel>@Localizer["AgentsInstructions"]</FieldLabel>
                        <FieldContent>
                            <Textarea @bind-Value="editor.Instructions" Class="min-h-[120px]"
                                      Placeholder="@Localizer["AgentsInstructionsPlaceholder"]" />
                            <FieldDescription>@Localizer["AgentsInstructionsHelp"]</FieldDescription>
                        </FieldContent>
                    </Field>
                    <Field>
                        <FieldLabel>@Localizer["AgentsModel"]</FieldLabel>
                        <FieldContent>
                            <Select TValue="string" Value="@(editor.Model ?? string.Empty)" ValueChanged="OnEditorModelChanged"
                                    DisplayTextSelector="ModelTextFor">
                                <SelectTrigger aria-label="@Localizer["AgentsModelSelectAriaLabel"]">
                                    <SelectValue Placeholder="@Localizer["AgentsFollowWorkspaceDefault"]" />
                                </SelectTrigger>
                                <SelectContent>
                                    <SelectItem TValue="string" Value="@string.Empty" Text="@Localizer["AgentsFollowWorkspaceDefault"]">@Localizer["AgentsFollowWorkspaceDefault"]</SelectItem>
                                    @foreach (var model in availableModels)
                                    {
                                        <SelectItem TValue="string" Value="@model" Text="@model">@model</SelectItem>
                                    }
                                </SelectContent>
                            </Select>
                        </FieldContent>
                    </Field>
                </TabsContent>

                <TabsContent Value="editorskills" ForceMount="true">
                    @if (editor.UsesEveryEnabledSkill)
                    {
                        <Alert Variant="AlertVariant.Info" Class="mb-3">
                            <AlertDescription>
                                @Localizer["AgentsFollowCatalogueInfo"]
                            </AlertDescription>
                        </Alert>
                    }
                    else
                    {
                        <TypographyMuted Class="mb-3 block">
                            @Localizer["AgentsSubsetLead"] <b>@Localizer["AgentsBlocked"]</b> @Localizer["AgentsSubsetTail"]
                        </TypographyMuted>
                    }

                    <div class="mb-3 flex items-center gap-3">
                        <Switch Checked="@editor.UsesEveryEnabledSkill"
                                CheckedChanged="@((bool value) => editor.UsesEveryEnabledSkill = value)"
                                Id="editor-followcatalogue" />
                        <Label For="editor-followcatalogue">@Localizer["AgentsFollowCatalogueLabel"]</Label>
                    </div>

                    <div class="space-y-1">
                        @foreach (var state in EditorSkillStates())
                        {
                            <div class="@($"flex items-center gap-3 border-b py-2.5 last:border-b-0 {(state.IsAgentToggleEditable ? "" : "opacity-50")}")">
                                <Switch Checked="@state.AgentSelected"
                                        CheckedChanged="@((bool value) => ToggleEditorSkill(state.Skill.Name, value))"
                                        Id="@($"editor-skill-{state.Skill.Name}")"
                                        Disabled="@(!state.IsAgentToggleEditable || editor.UsesEveryEnabledSkill)" />
                                <div class="min-w-0 flex-1">
                                    <Label For="@($"editor-skill-{state.Skill.Name}")" Class="font-semibold">@SkillDisplayName(state.Skill.Name)</Label>
                                    <div class="text-xs text-muted-foreground">
                                        @(state.Availability == AgentSkillAvailability.Blocked
                                            ? Localizer["AgentsSkillOffInCatalogue"].Value
                                            : SkillDescription(state.Skill.Name))
                                    </div>
                                </div>
                                @switch (state.Availability)
                                {
                                    case AgentSkillAvailability.Blocked:
                                        <Badge Variant="BadgeVariant.Secondary">@Localizer["AgentsBlocked"]</Badge>
                                        break;
                                    case AgentSkillAvailability.Unavailable:
                                        <Badge Variant="BadgeVariant.Outline">@Localizer["AgentsNotBuiltYet"]</Badge>
                                        break;
                                    default:
                                        <Badge Variant="@ExposureVariant(state.Skill.Exposure)">@ExposureLabelText(state.Skill.Exposure)</Badge>
                                        break;
                                }
                            </div>
                        }
                    </div>
                </TabsContent>

                <TabsContent Value="knowledge" ForceMount="true">
                    <Field>
                        <FieldLabel>@Localizer["AgentsCanRead"]</FieldLabel>
                        <FieldContent>
                            <Select TValue="string" Value="@editor.KnowledgeScope.ToString()" ValueChanged="OnKnowledgeScopeChanged"
                                    DisplayTextSelector="KnowledgeTextFor">
                                <SelectTrigger aria-label="@Localizer["AgentsKnowledgeSelectAriaLabel"]">
                                    <SelectValue Placeholder="@Localizer["AgentsScopeCallingWorkspace"]" />
                                </SelectTrigger>
                                <SelectContent>
                                    @foreach (var scope in KnowledgeScopes)
                                    {
                                        <SelectItem TValue="string" Value="@scope.ToString()" Text="@KnowledgeLabel(scope)">@KnowledgeLabel(scope)</SelectItem>
                                    }
                                </SelectContent>
                            </Select>
                        </FieldContent>
                    </Field>
                    @if (editor.KnowledgeScope != AgentKnowledgeScope.CallingWorkspace)
                    {
                        @* Saying so beats letting the user believe a cross-workspace agent is running. *@
                        <Alert Variant="AlertVariant.Warning" Class="mb-3">
                            <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-triangle" Size="16" /></Alert.Icon>
                            <AlertDescription>
                                @Localizer["AgentsScopeNotHonoredLead"] <b>@Localizer["AgentsScopeNotHonoredBold"]</b> @Localizer["AgentsScopeNotHonoredTail"]
                            </AlertDescription>
                        </Alert>
                    }
                    <div class="flex items-center gap-3">
                        <Switch @bind-Checked="editor.RestrictToPinned" Id="editor-pinned" />
                        <Label For="editor-pinned">@Localizer["AgentsRestrictToPinned"]</Label>
                    </div>
                    <div class="mt-3 flex items-center gap-3">
                        <Switch @bind-Checked="editor.AllowGeneralKnowledge" Id="editor-general" />
                        <Label For="editor-general">@Localizer["AgentsAllowGeneralKnowledge"]</Label>
                    </div>
                    <Alert Variant="AlertVariant.Info" Class="mt-4">
                        <AlertDescription>
                            @Localizer["AgentsGeneralKnowledgeNote"]
                        </AlertDescription>
                    </Alert>
                </TabsContent>

                <TabsContent Value="guardrails" ForceMount="true">
                    <div class="td-llm-pair">
                        <Field>
                            <FieldLabel>@Localizer["AgentsMaxToolCalls"]</FieldLabel>
                            <FieldContent>
                                <NumericInput TValue="int" @bind-Value="editorMaxToolCalls" Min="1" Max="@AgentRegistry.MaxToolCallCeiling" Step="1" />
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel>@Localizer["AgentsTimeLimit"]</FieldLabel>
                            <FieldContent>
                                <NumericInput TValue="int" @bind-Value="editorTimeLimit" Min="5" Max="@AgentRegistry.TimeLimitCeiling" Step="5" />
                            </FieldContent>
                        </Field>
                    </div>
                    <div class="flex items-center gap-3">
                        <Switch @bind-Checked="editor.ShowTrace" Id="editor-trace" />
                        <Label For="editor-trace">@Localizer["AgentsShowTrace"]</Label>
                    </div>
                    <div class="mt-3 flex items-center gap-3">
                        <Switch @bind-Checked="editor.ConfirmEgress" Id="editor-egress" />
                        <Label For="editor-egress">@Localizer["AgentsConfirmEgress"]</Label>
                    </div>
                    <div class="mt-3 flex items-center gap-3">
                        <Switch @bind-Checked="editor.AllowFollowUp" Id="editor-followup" />
                        <Label For="editor-followup">@Localizer["AgentsAllowFollowUpAgent"]</Label>
                    </div>
                </TabsContent>
            </Tabs>
        }

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => showEditor = false)">@Localizer["Cancel"]</Button>
            <Button OnClick="SaveEditorAsync" Disabled="@isSaving">@(isSaving ? Localizer["Saving"] : Localizer["AgentsSaveAgent"])</Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

<!-- Delete confirm (REQ-UI-045) -->
<Dialog @bind-Open="showDeleteDialog">
