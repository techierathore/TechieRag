@page "/reset-password"
@layout AuthLayout
@inject IAppManagerClient AppManager
@inject ITechieDeskAuthModeProvider AuthMode
@inject NavigationManager Nav
@inject ILogger<ResetPassword> Logger

<PageTitle>TechieDesk — Reset password</PageTitle>

<Card Class="rounded-2xl p-2 shadow-lg">
    <CardHeader>
        <h1 class="text-2xl font-semibold leading-none tracking-tight">Set a new password</h1>
        <CardDescription>Choose a new password for your account</CardDescription>
    </CardHeader>
    <CardContent Class="space-y-4">
        @if (succeeded)
        {
            <Alert Variant="AlertVariant.Success">
                <Alert.Icon><LucideIcon aria-hidden="true" Name="check-circle" Size="16" /></Alert.Icon>
                <AlertDescription>Your password has been reset. You can now sign in.</AlertDescription>
            </Alert>
            <Button Class="w-full" OnClick="@(() => Nav.NavigateTo("/login", forceLoad: true))">Back to sign in</Button>
        }
        else
        {
            @if (errorMessage is not null)
            {
                <Alert Variant="AlertVariant.Danger" AccentBorder="true">
                    <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
                    <AlertDescription>@errorMessage</AlertDescription>
                </Alert>
            }

            <Field IsInvalid="@(passwordError is not null)">
                <FieldLabel>New password</FieldLabel>
                <FieldContent>
                    <Input Type="InputType.Password" @bind-Value="password" Placeholder="••••••••" AriaInvalid="@(passwordError is not null)" />
                    @if (passwordError is not null)
                    {
                        <FieldError>@passwordError</FieldError>
                    }
                    else
                    {
                        <FieldDescription>Min 8 chars, 1 uppercase, 1 number, 1 special character</FieldDescription>
                    }
                </FieldContent>
            </Field>

            <Field IsInvalid="@(confirmError is not null)">
                <FieldLabel>Confirm new password</FieldLabel>
                <FieldContent>
                    <Input Type="InputType.Password" @bind-Value="confirmPassword" Placeholder="••••••••" AriaInvalid="@(confirmError is not null)" />
                    @if (confirmError is not null)
                    {
                        <FieldError>@confirmError</FieldError>
                    }
                </FieldContent>
            </Field>

            <Button Class="w-full" OnClick="ResetAsync" Disabled="isBusy" Type="ButtonType.Submit">
                @if (isBusy)
                {
                    <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                    <span>Resetting…</span>
                }
                else
                {
                    <span>Reset password</span>
                }
            </Button>

            <div class="text-center">
                <a href="/login" class="text-sm font-semibold text-primary hover:underline">← Back to sign in</a>
            </div>
        }
    </CardContent>
</Card>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string? passwordError;
    private string? confirmError;
    private string? errorMessage;
    private bool isBusy;
    private bool succeeded;

    private async Task ResetAsync()
    {
        passwordError = confirmError = errorMessage = null;

        if (!PasswordPolicy.IsValid(password))
        {
            passwordError = "Min 8 chars, 1 uppercase, 1 number, 1 special character.";
        }

        if (confirmPassword != password)
        {
            confirmError = "Passwords do not match.";
        }

        if (passwordError is not null || confirmError is not null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(Token))
        {
            errorMessage = "This reset link is invalid or has expired.";
            return;
        }

        if (!AuthMode.IsAppManagerEnabled)
        {
            errorMessage = "This instance runs in offline single-user mode — password reset is managed by AppManager and is not available.";
            return;
        }

        isBusy = true;
        try
        {
            await AppManager.ResetPasswordAsync(Token!, password);
            Logger.LogInformation("Password reset completed via emailed token");
            succeeded = true;
        }
        catch (AppManagerException ex)
        {
            Logger.LogWarning("Password reset failed ({ErrorCode})", ex.ErrorCode);
            errorMessage = ex.Error switch
            {
                AppManagerError.InvalidResetToken => "This reset link is invalid or has expired.",
                AppManagerError.InvalidPassword => "Password does not meet the complexity requirements.",
                AppManagerError.AppIdMismatch => "This reset link is not valid for this application.",
                _ => "Unable to reset your password right now. Please request a new link."
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during password reset");
            errorMessage = "Something went wrong. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
