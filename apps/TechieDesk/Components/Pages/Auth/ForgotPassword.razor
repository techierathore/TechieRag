@page "/forgot-password"
@layout AuthLayout
@inject IAppManagerClient AppManager
@inject ITechieDeskAuthModeProvider AuthMode
@inject ILogger<ForgotPassword> Logger

<PageTitle>TechieDesk — Forgot password</PageTitle>

<Card Class="rounded-2xl p-2 shadow-lg">
    <CardHeader>
        <h1 class="text-2xl font-semibold leading-none tracking-tight">Forgot password</h1>
        <CardDescription>Enter your account email and we'll send you a reset link</CardDescription>
    </CardHeader>
    <CardContent Class="space-y-4">
        <Field IsInvalid="@(emailError is not null)">
            <FieldLabel>Email</FieldLabel>
            <FieldContent>
                <Input Type="InputType.Email" @bind-Value="email" Placeholder="you@company.com" AriaInvalid="@(emailError is not null)" />
                @if (emailError is not null)
                {
                    <FieldError>@emailError</FieldError>
                }
            </FieldContent>
        </Field>

        <Button Class="w-full" OnClick="SendResetLinkAsync" Disabled="isBusy" Type="ButtonType.Submit">
            @if (isBusy)
            {
                <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                <span>Sending…</span>
            }
            else
            {
                <span>Send reset link</span>
            }
        </Button>

        @if (submitted)
        {
            <Alert Variant="AlertVariant.Success">
                <Alert.Icon><LucideIcon aria-hidden="true" Name="mail-check" Size="16" /></Alert.Icon>
                <AlertDescription>If that address exists, a reset email is on its way.</AlertDescription>
            </Alert>
        }

        <div class="text-center">
            <a href="/login" class="text-sm font-semibold text-primary hover:underline">← Back to sign in</a>
        </div>
    </CardContent>
</Card>

@code {
    private string email = string.Empty;
    private string? emailError;
    private bool submitted;
    private bool isBusy;

    private async Task SendResetLinkAsync()
    {
        emailError = null;
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            emailError = "A valid email is required.";
            return;
        }

        isBusy = true;
        try
        {
            if (AuthMode.IsAppManagerEnabled)
            {
                await AppManager.ForgotPasswordAsync(email.Trim());
            }

            Logger.LogInformation("Password reset requested for {Email}", email.Trim());
        }
        catch (Exception ex)
        {
            // Anti-enumeration (BRD-17): never reveal whether the address exists — swallow and
            // still show the neutral success message below.
            Logger.LogWarning(ex, "Forgot-password request errored for {Email} (suppressed for anti-enumeration)", email.Trim());
        }
        finally
        {
            isBusy = false;
            submitted = true;
        }
    }
}
