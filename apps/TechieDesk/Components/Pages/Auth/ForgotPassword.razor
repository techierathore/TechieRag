@page "/forgot-password"
@layout AuthLayout
@inject IAppManagerClient AppManager
@inject ITechieDeskAuthModeProvider AuthMode
@inject ILogger<ForgotPassword> Logger
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["ForgotPageTitle"]</PageTitle>

<Card Class="rounded-2xl p-2 shadow-lg">
    <CardHeader>
        <h1 class="text-2xl font-semibold leading-none tracking-tight">@Localizer["ForgotHeading"]</h1>
        <CardDescription>@Localizer["ForgotSubheading"]</CardDescription>
    </CardHeader>
    <CardContent Class="space-y-4">
        <Field IsInvalid="@(emailError is not null)">
            <FieldLabel>@Localizer["AuthEmailLabel"]</FieldLabel>
            <FieldContent>
                <Input Type="InputType.Email" @bind-Value="email" Placeholder="@Localizer["AuthEmailPlaceholder"]" AriaInvalid="@(emailError is not null)" />
                @if (emailError is not null)
                {
                    <FieldError>@emailError</FieldError>
                }
            </FieldContent>
        </Field>

        <Button Class="w-full" OnClick="SendResetLinkAsync" Disabled="isBusy" Type="ButtonType.Submit">
            @if (isBusy)
            {
                <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                <span>@Localizer["ForgotSending"]</span>
            }
            else
            {
                <span>@Localizer["ForgotSubmit"]</span>
            }
        </Button>

        @if (submitted)
        {
            <Alert Variant="AlertVariant.Success">
                <Alert.Icon><LucideIcon aria-hidden="true" Name="mail-check" Size="16" /></Alert.Icon>
                <AlertDescription>@Localizer["ForgotSent"]</AlertDescription>
            </Alert>
        }

        <div class="text-center">
            <a href="/login" class="text-sm font-semibold text-primary hover:underline">@Localizer["AuthBackToSignIn"]</a>
        </div>
    </CardContent>
</Card>

@code {
    private string email = string.Empty;
    private string? emailError;
    private bool submitted;
    private bool isBusy;

    private async Task SendResetLinkAsync()
    {
        emailError = null;
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            emailError = Localizer["AuthErrorEmailRequired"];
            return;
        }

        isBusy = true;
        try
        {
            if (AuthMode.IsAppManagerEnabled)
            {
                await AppManager.ForgotPasswordAsync(email.Trim());
            }

            Logger.LogInformation("Password reset requested for {Email}", email.Trim());
        }
        catch (Exception ex)
        {
            // Anti-enumeration (BRD-17): never reveal whether the address exists — swallow and
            // still show the neutral success message below.
            Logger.LogWarning(ex, "Forgot-password request errored for {Email} (suppressed for anti-enumeration)", email.Trim());
        }
        finally
        {
            isBusy = false;
            submitted = true;
        }
    }
}
