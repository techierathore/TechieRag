@page "/login"
@layout AuthLayout
@inject IAppManagerClient AppManager
@inject TechieDeskAuthenticationStateProvider AuthProvider
@inject ITechieDeskAuthModeProvider AuthMode
@inject NavigationManager Nav
@inject ILogger<Login> Logger

<PageTitle>TechieDesk — Sign in</PageTitle>

<Card Class="rounded-2xl p-2 shadow-lg">
    <CardHeader>
        <h1 class="text-2xl font-semibold leading-none tracking-tight">Welcome back</h1>
        <CardDescription>Sign in to your TechieDesk instance</CardDescription>
    </CardHeader>
    <CardContent Class="space-y-4">
        @if (errorMessage is not null)
        {
            <Alert Variant="@errorVariant" AccentBorder="true">
                <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
                <AlertDescription>@errorMessage</AlertDescription>
            </Alert>
        }

        <Field IsInvalid="@(emailError is not null)">
            <FieldLabel>Email</FieldLabel>
            <FieldContent>
                <Input AriaLabel="Email" Id="login-email" Type="InputType.Email" @bind-Value="email"
                       Placeholder="you@company.com" AriaInvalid="@(emailError is not null)" />
                @if (emailError is not null)
                {
                    <FieldError>@emailError</FieldError>
                }
            </FieldContent>
        </Field>

        <Field IsInvalid="@(passwordError is not null)">
            <div class="flex items-center justify-between">
                <FieldLabel>Password</FieldLabel>
                <a href="/forgot-password" class="text-xs font-semibold text-primary hover:underline">Forgot password?</a>
            </div>
            <FieldContent>
                <Input AriaLabel="Password" Id="login-password" Type="InputType.Password" @bind-Value="password"
                       Placeholder="••••••••" AriaInvalid="@(passwordError is not null)" />
                @if (passwordError is not null)
                {
                    <FieldError>@passwordError</FieldError>
                }
            </FieldContent>
        </Field>

        <Button Class="w-full" OnClick="SignInAsync" Disabled="isBusy" Type="ButtonType.Submit">
            @if (isBusy)
            {
                <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                <span>Signing in…</span>
            }
            else
            {
                <span>Sign in</span>
            }
        </Button>

        <div class="flex items-center gap-2.5 text-xs text-muted-foreground">
            <Separator Class="flex-1" /> or <Separator Class="flex-1" />
        </div>

        <div class="text-center text-sm text-muted-foreground">
            No account? <a href="/register" class="font-semibold text-primary hover:underline">Create one</a>
        </div>
    </CardContent>
</Card>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string email = string.Empty;
    private string password = string.Empty;
    private string? emailError;
    private string? passwordError;
    private string? errorMessage;
    private AlertVariant errorVariant = AlertVariant.Danger;
    private bool isBusy;

    private async Task SignInAsync()
    {
        emailError = passwordError = errorMessage = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            emailError = "Email is required.";
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            passwordError = "Password is required.";
        }

        if (emailError is not null || passwordError is not null)
        {
            return;
        }

        if (!AuthMode.IsAppManagerEnabled)
        {
            errorVariant = AlertVariant.Info;
            errorMessage = "This instance runs in offline single-user mode — no login is required.";
            return;
        }

        isBusy = true;
        try
        {
            var auth = await AppManager.LoginAsync(email.Trim(), password);
            AuthProvider.SignIn(auth);
            Logger.LogInformation("Login succeeded for {Email}", email.Trim());
            Nav.NavigateTo(SafeReturnUrl(), forceLoad: true);
        }
        catch (AppManagerException ex)
        {
            Logger.LogWarning("Login failed for {Email} ({ErrorCode})", email.Trim(), ex.ErrorCode);
            (errorVariant, errorMessage) = MapError(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during login for {Email}", email.Trim());
            errorVariant = AlertVariant.Danger;
            errorMessage = "Something went wrong while signing in. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    // REQ-UI-013: distinct friendly banners for the key account-state errors.
    private static (AlertVariant, string) MapError(AppManagerException ex) => ex.Error switch
    {
        AppManagerError.InvalidCredentials => (AlertVariant.Danger, "Invalid email or password."),
        AppManagerError.AccountLocked => (AlertVariant.Warning, "Account locked — too many failed attempts. Try again in 15 minutes."),
        AppManagerError.AccountDisabled => (AlertVariant.Danger, "Account disabled — contact your administrator."),
        AppManagerError.NoAppAccess => (AlertVariant.Danger, "Your account doesn't have access to this application. Contact your administrator."),
        _ => (AlertVariant.Danger, "Unable to sign in right now. Please try again later.")
    };

    private string SafeReturnUrl()
    {
        var target = ReturnUrl;
        if (string.IsNullOrWhiteSpace(target) || !target.StartsWith('/') || target.StartsWith("//"))
        {
            return "/";
        }

        return target;
    }
}
