@page "/login"
@layout AuthLayout
@inject ITechieDeskAuthModeProvider AuthMode
@inject IDesktopSignInService SignIn
@inject TechieDeskAuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["LoginPageTitle"]</PageTitle>

@* REQ-FN-039 / REQ-UI-007: an IN-PROCESS sign-in, not an HTML form post.

   Until now this posted to /auth/login — an ASP.NET Core endpoint that died with the web host in
   REQ-FN-035, so the screen rendered and submitting it did precisely nothing. A MAUI Blazor Hybrid
   head has no HTTP boundary and no cookie to write, which were the only two reasons the form post
   existed: the component calls IDesktopSignInService on the same thread, that service establishes
   the session, and the tokens go to the OS credential store (REQ-FN-039).

   Consequently gone: the <AntiforgeryToken /> (a desktop app has no cross-site request to forge),
   the ?error= redirect round-trip (the outcome is returned, not redirected back), and
   NavigateTo(forceLoad: true) (there is no server to reload from — a full reload would restart the
   whole WebView).

   The fields stay plain <input> elements carrying the classes TrBlazeUI's <Input> emits, so the
   screen is byte-for-byte what the mockup shows; they are now bound instead of named. *@

<Card Class="rounded-2xl p-2 shadow-lg">
    <CardHeader>
        <h1 class="text-2xl font-semibold leading-none tracking-tight">@Localizer["LoginHeading"]</h1>
        <CardDescription>@Localizer["LoginSubheading"]</CardDescription>
    </CardHeader>
    <CardContent Class="space-y-4">
        @if (Banner is not null)
        {
            <Alert Variant="@Banner.Value.Variant" AccentBorder="true">
                <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
                <AlertDescription>@Banner.Value.Message</AlertDescription>
            </Alert>
        }

        <form class="space-y-4" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <Field>
                <FieldLabel>@Localizer["AuthEmailLabel"]</FieldLabel>
                <FieldContent>
                    <input id="login-email" name="email" type="email" required autocomplete="username"
                           placeholder="@Localizer["AuthEmailPlaceholder"]" aria-label="@Localizer["AuthEmailLabel"]" class="@InputClass"
                           disabled="@Busy" value="@Email"
                           @oninput="@(args => Email = args.Value?.ToString() ?? string.Empty)" />
                </FieldContent>
            </Field>

            <Field>
                <div class="flex items-center justify-between">
                    <FieldLabel>@Localizer["AuthPasswordLabel"]</FieldLabel>
                    <a href="/forgot-password" class="text-xs font-semibold text-primary hover:underline">@Localizer["LoginForgotPassword"]</a>
                </div>
                <FieldContent>
                    <input id="login-password" name="password" type="password" required autocomplete="current-password"
                           placeholder="••••••••" aria-label="@Localizer["AuthPasswordLabel"]" class="@InputClass"
                           disabled="@Busy" value="@Password"
                           @oninput="@(args => Password = args.Value?.ToString() ?? string.Empty)" />
                </FieldContent>
            </Field>

            <button type="submit" class="@SubmitClass" disabled="@Busy">@SubmitLabel</button>
        </form>

        <div class="flex items-center gap-2.5 text-xs text-muted-foreground">
            <Separator Class="flex-1" /> @Localizer["AuthOr"] <Separator Class="flex-1" />
        </div>

        <div class="text-center text-sm text-muted-foreground">
            @Localizer["LoginNoAccount"] <a href="/register" class="font-semibold text-primary hover:underline">@Localizer["LoginCreateOne"]</a>
        </div>

        @* REQ-FN-036 / BRD-129: nothing in the app sends anyone here, so the way back must always
           be on the screen. Signing in activates a licence; the workspace is already usable. *@
        <div class="text-center text-sm">
            <a href="/" class="font-semibold text-primary hover:underline">@Localizer["AuthContinueWithoutAccount"]</a>
        </div>
    </CardContent>
</Card>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    // The exact classes TrBlazeUI's <Input> emits, so a plain input looks identical to the
    // component used on every other screen.
    private const string InputClass =
        "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background " +
        "file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground " +
        "placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring " +
        "focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 " +
        "aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive transition-colors md:text-sm";

    private const string SubmitClass =
        "inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors " +
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 " +
        "disabled:opacity-50 disabled:pointer-events-none bg-primary text-primary-foreground hover:bg-primary/90 " +
        "h-10 px-4 py-2 w-full";

    private string Email { get; set; } = string.Empty;

    private string Password { get; set; } = string.Empty;

    private bool Busy { get; set; }

    // REQ-UI-052: the coverage counter cannot see a C# literal that reaches the screen through a
    // single markup position, so these were invisible to it — and just as English on a Hindi screen.
    private string SubmitLabel => Busy ? Localizer["LoginSubmitBusy"] : Localizer["LoginSubmit"];

    private string SafeReturnUrl => AuthScreenCodes.SafeReturnUrl(ReturnUrl);

    private (AlertVariant Variant, string Message)? Banner => BuildBanner();

    // Signs in through the in-process service, then hands the app back its authenticated identity.
    private async Task SubmitAsync()
    {
        if (Busy)
        {
            return;
        }

        Busy = true;
        try
        {
            var outcome = await SignIn.SignInAsync(Email, Password);
            ErrorCode = outcome.ErrorCode;
            if (!outcome.Succeeded)
            {
                return;
            }

            // The password never outlives the call that needed it.
            Password = string.Empty;

            // The session was established on the app-wide session context, so every consumer already
            // sees it; this is what tells Blazor's authorization plumbing to re-read it.
            AuthProvider.NotifySessionChanged();
            Nav.NavigateTo(SafeReturnUrl);
        }
        finally
        {
            Busy = false;
        }
    }

    // REQ-UI-007 / REQ-UI-013: distinct friendly banners for the key account-state errors, keyed
    // off the code the sign-in service reports.
    private (AlertVariant, string)? BuildBanner()
    {
        // REQ-FN-036 / BRD-129: signing in activates a licence — it is never required to use the
        // app on your own data. With no AppManager configured there is nothing to sign in to, so
        // say so plainly instead of implying the user is missing out on access.
        if (!AuthMode.IsAppManagerEnabled)
        {
            return (AlertVariant.Info, Localizer["LoginBannerNoLicenceServer"]);
        }

        return ErrorCode switch
        {
            null or "" => null,
            "INVALID_CREDENTIALS" => (AlertVariant.Danger, Localizer["LoginErrorInvalidCredentials"]),
            "ACCOUNT_LOCKED" => (AlertVariant.Warning, Localizer["LoginErrorAccountLocked"]),
            "ACCOUNT_DISABLED" => (AlertVariant.Danger, Localizer["LoginErrorAccountDisabled"]),
            "NO_APP_ACCESS" => (AlertVariant.Danger, Localizer["LoginErrorNoAppAccess"]),
            AuthScreenCodes.MissingFields => (AlertVariant.Danger, Localizer["LoginErrorMissingFields"]),
            AuthScreenCodes.NoLicenceServer => (AlertVariant.Info, Localizer["LoginErrorNoLicenceServer"]),
            @* REQ-FN-035: the ANTIFORGERY_FAILED banner is gone with the HTML form post it
               protected. A desktop app has no cross-site request to forge. *@
            _ => (AlertVariant.Danger, Localizer["LoginErrorGeneric"])
        };
    }
}
