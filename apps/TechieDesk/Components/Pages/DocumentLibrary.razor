@page "/workspace/{Slug}/documents"
@using System.Security.Cryptography
@using TechieRag.Embedded
@using Microsoft.Maui.Storage
@using TrBlazeUI.Components.Empty
@implements IDisposable
@inject TechieRagManager Rag
@inject IWorkspaceService Workspaces
@inject ToastService ToastService
@inject NavigationManager Nav
@inject ILogger<DocumentLibrary> Logger
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["DocsPageTitle", workspace?.Name ?? Localizer["DocsWorkspaceFallback"].Value]</PageTitle>

@* REQ-NFR-010/BRD-101: a backend outage (vector store, persistence store) must not be reported
   as "this workspace does not exist or you are not assigned to it" — that sends the user to the
   wrong problem. Unavailability gets its own message naming the real failure. *@
@if (loadError is not null)
{
    <Alert Variant="AlertVariant.Danger">
        <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
        <AlertTitle>@Localizer["DocsLoadErrorTitle"]</AlertTitle>
        <AlertDescription>
            @Localizer["DocsLoadErrorBody", loadError]
        </AlertDescription>
    </Alert>
}
else if (notFound)
{
    <Alert Variant="AlertVariant.Danger">
        <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
        <AlertTitle>@Localizer["DocsNotFoundTitle"]</AlertTitle>
        <AlertDescription>@Localizer["DocsNotFoundBody"]</AlertDescription>
    </Alert>
}
else if (workspace is null)
{
    <div class="flex items-center gap-2 text-muted-foreground">
        <Spinner Size="SpinnerSize.Small" /> <span>@Localizer["DocsLoadingDocuments"]</span>
    </div>
}
else
{
    <div class="mb-4 flex items-center gap-3">
        <div>
            <h1 class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0">@Localizer["DocsHeading", workspace.Name]</h1>
            <TypographyMuted>@Localizer["DocsSubtitle"]</TypographyMuted>
        </div>
        @if (canManage)
        {
            <div class="ml-auto flex items-center gap-2">
                <Switch @bind-Checked="pinOnUpload" Id="pin-on-upload" />
                <Label For="pin-on-upload">@Localizer["DocsPinNewUploads"]</Label>
            </div>
        }
    </div>

    @* REQ-RAG-052: documents whose vectors were produced by a different embedding model or a
       different encoding of the same one. Search still RETURNS them, which is why this needs saying
       out loud — the results are quietly wrong rather than missing, and nothing else would show it. *@
    @if (staleness is { IsDeterminable: true, IsStale: true })
    {
        <Alert Variant="AlertVariant.Warning" Class="mb-4">
            <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-triangle" Size="16" /></Alert.Icon>
            <AlertTitle>@Localizer["DocsStaleEmbeddingsTitle"]</AlertTitle>
            <AlertDescription>
                <p>@Localizer["DocsStaleEmbeddingsBody", staleness.StaleCount, staleness.TotalDocuments]</p>
                @if (staleness.IsMixed)
                {
                    <p class="mt-1">@Localizer["DocsStaleEmbeddingsMixed"]</p>
                }
            </AlertDescription>
        </Alert>
    }

    @* BGE-M3 offline model readiness — embedding runs locally against the bundled model. *@
    @if (isDownloadingModel)
    {
        <Alert Variant="AlertVariant.Warning" Class="mb-4">
            <Alert.Icon><Spinner Size="SpinnerSize.Small" /></Alert.Icon>
            <AlertTitle>@Localizer["DocsPreparingModelTitle"]</AlertTitle>
            <AlertDescription>@(downloadProgress?.StatusMessage)</AlertDescription>
        </Alert>
    }

    @* REQ-UI-019, reworked by REQ-UI-041 (BRD-133): the browser drag-drop <FileUpload> is replaced
       by the OS file and folder pickers. On a desktop head the browser control was a copy of the
       file through a JS stream into a temp file — the app can simply read the path the user picked,
       and a folder can be added in one action instead of a drag per file. *@
    @if (canManage)
    {
        <Card Class="mb-4">
            <CardContent Class="space-y-3 p-4">
                <div class="flex flex-wrap gap-2">
                    <Button OnClick="PickFilesAsync" Disabled="isUploading">
                        <LucideIcon aria-hidden="true" Name="file-plus" Size="16" Class="mr-2" />
                        <span>@Localizer["DocsAddFiles"]</span>
                    </Button>
                    <Button Variant="ButtonVariant.Outline" OnClick="PickFolderAsync" Disabled="isUploading">
                        <LucideIcon aria-hidden="true" Name="folder-open" Size="16" Class="mr-2" />
                        <span>@Localizer["DocsAddFolder"]</span>
                    </Button>
                    @* REQ-RAG-016/017/018: one surface for page, site crawl and YouTube transcript. *@
                    <Button Variant="ButtonVariant.Outline" OnClick="GoToWebIngestion" Disabled="isUploading">
                        <LucideIcon aria-hidden="true" Name="globe" Size="16" Class="mr-2" />
                        <span>@Localizer["DocsAddFromWebAction"]</span>
                    </Button>
                </div>
                <TypographyMuted Class="block">
                    @Localizer["DocsPickerHint", PickerName]
                    <b>@Localizer["DocsAddFromWeb"]</b> @Localizer["DocsAddFromWebHint"]
                </TypographyMuted>
            </CardContent>
        </Card>
    }

    @* REQ-UI-019 / REQ-UI-020 / REQ-RAG-011 / REQ-RAG-012: upload queue with per-file live status. *@
    @if (uploadQueue.Count > 0)
    {
        <Card Class="mb-4">
            <CardHeader>
                <div class="flex items-center justify-between">
                    <CardTitle>@Localizer["DocsUploadsTitle", uploadQueue.Count]</CardTitle>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ClearFinishedUploads" Disabled="isUploading">@Localizer["DocsClearFinished"]</Button>
                </div>
            </CardHeader>
            <CardContent Class="space-y-3">
                @foreach (var item in uploadQueue)
                {
                    <div class="flex items-center gap-3">
                        <div class="w-48 shrink-0 truncate text-sm" title="@item.Name">@item.Name</div>
                        <div class="flex-1">
                            <Progress aria-label="@Localizer["DocsUploadProgress"]" Value="@Math.Round((double)item.Progress)" />
                        </div>
                        <div class="w-40 shrink-0 text-right text-xs">
                            @switch (item.Status)
                            {
                                case UploadStatus.Queued:
                                    <span class="text-muted-foreground">@Localizer["DocsStatusQueued"]</span>
                                    break;
                                case UploadStatus.Embedding:
                                    <Badge Variant="BadgeVariant.Secondary">@Localizer["DocsStatusEmbedding"]</Badge>
                                    break;
                                case UploadStatus.Embedded:
                                    <Badge>@Localizer["DocsStatusEmbedded"]</Badge>
                                    break;
                                case UploadStatus.Duplicate:
                                    <Badge Variant="BadgeVariant.Outline">@Localizer["DocsStatusDuplicate"]</Badge>
                                    break;
                                case UploadStatus.Rejected:
                                    <Badge Variant="BadgeVariant.Destructive">@Localizer["DocsStatusRejected"]</Badge>
                                    break;
                                case UploadStatus.Failed:
                                    <Badge Variant="BadgeVariant.Destructive">@Localizer["DocsStatusFailed"]</Badge>
                                    break;
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(item.Message))
                    {
                        <div class="-mt-1 pl-2 text-xs text-muted-foreground">@item.Message</div>
                    }
                }
            </CardContent>
        </Card>
    }

    @* REQ-UI-021: library table (pin, name, type, size, chunks, uploaded, workspaces, status, actions). *@
    <Card>
        <CardHeader>
            <CardTitle>@(rows.Count == 1 ? Localizer["DocsLibraryTitleOne", rows.Count] : Localizer["DocsLibraryTitleMany", rows.Count])</CardTitle>
            <CardDescription>@Localizer["DocsLibraryDescription"]</CardDescription>
        </CardHeader>
        <CardContent>
            @if (isLoadingRows)
            {
                <div class="flex items-center gap-2 text-muted-foreground">
                    <Spinner Size="SpinnerSize.Small" /> <span>@Localizer["DocsLoadingLibrary"]</span>
                </div>
            }
            else if (rows.Count == 0)
            {
                <Empty Title="@Localizer["DocsEmptyTitle"]"
                       Description="@Localizer["DocsEmptyDescription"]">
                    <Icon><LucideIcon aria-hidden="true" Name="file-text" Size="28" /></Icon>
                </Empty>
            }
            else
            {
                @* TR-004: DataTable must scroll inside an inline-style overflow wrapper at 390px. *@
                <div style="overflow-x:auto">
                    <DataTable TData="DocRow" Data="@rows" ShowToolbar="false" ShowPagination="false">
                        <Columns>
                            <DataTableColumn TData="DocRow" TValue="string" Property="@(r => "")" Header="@Localizer["DocsColumnSelect"]" HeaderClass="td-th-label-hidden" Width="44px">
                                <CellTemplate Context="row">
                                    <button type="button" class="rounded p-1 hover:bg-muted @(row.IsPinned ? "text-primary" : "text-muted-foreground")"
                                            title="@(row.IsPinned ? Localizer["DocsPinTooltipPinned"].Value : Localizer["DocsPinTooltipUnpinned"].Value)"
                                            disabled="@(!canManage || busyDocId == row.DocumentId)"
                                            @onclick="@(() => TogglePinAsync(row))">
                                        <LucideIcon aria-hidden="true" Name="pin" Size="15" />
                                    </button>
                                </CellTemplate>
                            </DataTableColumn>
                            <DataTableColumn TData="DocRow" TValue="string" Property="@(r => r.Name)" Header="@Localizer["DocsColumnName"]" />
                            <DataTableColumn TData="DocRow" TValue="string" Property="@(r => r.Type)" Header="@Localizer["DocsColumnType"]">
                                <CellTemplate Context="row">
                                    <Badge Variant="BadgeVariant.Secondary">@row.Type</Badge>
                                </CellTemplate>
                            </DataTableColumn>
                            <DataTableColumn TData="DocRow" TValue="string" Property="@(r => r.SizeDisplay)" Header="@Localizer["DocsColumnSize"]" />
                            <DataTableColumn TData="DocRow" TValue="int" Property="@(r => r.ChunkCount)" Header="@Localizer["DocsColumnChunks"]" />
                            <DataTableColumn TData="DocRow" TValue="string" Property="@(r => r.Uploaded)" Header="@Localizer["DocsColumnUploaded"]" />
                            <DataTableColumn TData="DocRow" TValue="string" Property="@(r => r.WorkspacesUsing)" Header="@Localizer["DocsColumnWorkspaces"]" />
                            <DataTableColumn TData="DocRow" TValue="string" Property="@(r => "Embedded")" Header="@Localizer["DocsColumnStatus"]">
                                <CellTemplate Context="row">
                                    <Badge>@Localizer["DocsStatusEmbedded"]</Badge>
                                </CellTemplate>
                            </DataTableColumn>
                            <DataTableColumn TData="DocRow" TValue="string" Property="@(r => "")" Header="@Localizer["DocsColumnActions"]" HeaderClass="td-th-label-hidden" MinWidth="150px">
                                <CellTemplate Context="row">
                                    <div class="flex justify-end gap-1">
                                        @if (canManage)
                                        {
                                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                                    OnClick="@(() => UnembedAsync(row))" Disabled="@(busyDocId == row.DocumentId)"
                                                    title="@Localizer["DocsUnembedTooltip"]">
                                                @Localizer["DocsUnembed"]
                                            </Button>
                                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                                    OnClick="@(() => BeginDelete(row))" Disabled="@(busyDocId == row.DocumentId)">
                                                @Localizer["DocsDelete"]
                                            </Button>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-muted-foreground">@Localizer["DocsViewOnly"]</span>
                                        }
                                    </div>
                                </CellTemplate>
                            </DataTableColumn>
                        </Columns>
                    </DataTable>
                </div>
            }
        </CardContent>
    </Card>

    <div class="mt-4 text-xs text-muted-foreground">
        @Localizer["DocsFootnoteDedupe"] <b>@Localizer["DocsUnembed"]</b> @Localizer["DocsFootnoteUnembed"]
        <b>@Localizer["DocsDelete"]</b> @Localizer["DocsFootnoteDelete"]
    </div>
}

@* REQ-FN-012: delete confirmation — removes vectors from all using workspaces. *@
<Dialog @bind-Open="showDeleteDialog">
    <DialogContent>
        <DialogHeader>
            <DialogTitle>@Localizer["DocsDeleteTitle", pendingDelete?.Name ?? string.Empty]</DialogTitle>
            <DialogDescription>
                @Localizer["DocsDeleteBody", pendingDelete is null ? Localizer["DocsDeleteScopeThis"].Value : (pendingDelete.UsageCount == 1 ? Localizer["DocsDeleteScopeOne", pendingDelete.UsageCount].Value : Localizer["DocsDeleteScopeMany", pendingDelete.UsageCount].Value)]
            </DialogDescription>
        </DialogHeader>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => showDeleteDialog = false)">@Localizer["Cancel"]</Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="ConfirmDeleteAsync">@Localizer["DocsDeleteEverywhere"]</Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@code {
    /// <summary>The workspace URL slug from the route.</summary>
    [Parameter] public string Slug { get; set; } = string.Empty;

    private Workspace? workspace;
    private bool notFound;

    /// <summary>Backend failure message when the workspace could not be loaded (REQ-NFR-010).</summary>
    private string? loadError;
    private string? loadedSlug;
    private bool canManage;

    private bool isLoadingRows;
    private readonly List<DocRow> rows = new();

    private readonly List<UploadItem> uploadQueue = new();
    private bool isUploading;
    private bool pinOnUpload;

    private string? busyDocId;
    private bool showDeleteDialog;
    private DocRow? pendingDelete;

    private bool isDownloadingModel;

    /// <summary>
    /// Which of this workspace's documents were embedded by something other than the current
    /// provider (REQ-RAG-052). Null until the first load completes.
    /// </summary>
    private EmbeddingStalenessReport? staleness;
    private ModelDownloadProgress? downloadProgress;

    // REQ-RAG-033 landed XLSX/PPTX/CSV processors, so those types are now accepted alongside the
    // original nine. Everything else falls through to a supported processor or a clean per-file
    // rejection (REQ-RAG-011).
    // The accept/reject matrix lives in UploadTypePolicy so it can be unit-tested directly. It is
    // no longer handed to a browser `accept` attribute (REQ-UI-041 replaced the drag-drop control):
    // it is now applied per file, AFTER the OS picker, which is the only place it can produce a
    // reason the user can read.
    //
    // Ceiling carried over from the retired <FileUpload MaxFileSize="67108864">: a 64 MB document
    // is already far past what one embedding pass should hold, and the limit disappearing with the
    // control would have made the failure an out-of-memory instead of a rejection.
    private const long MaxUploadBytes = 67108864;

    protected override void OnInitialized()
    {
        ModelDownloadService.Instance.ProgressChanged += OnDownloadProgressChanged;
        downloadProgress = ModelDownloadService.Instance.Progress;
        UpdateDownloadStatus();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedSlug == Slug)
        {
            return;
        }

        loadedSlug = Slug;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        notFound = false;
        loadError = null;
        workspace = null;
        rows.Clear();
        uploadQueue.Clear();

        try
        {
            workspace = await Workspaces.ResolveBySlugAsync(Slug);
            if (workspace is null)
            {
                notFound = true;
                return;
            }

            canManage = Workspaces.CanManageWorkspaces;
            await Rag.InitializeAsync();
            await ReloadLibraryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load document library for {Slug}", Slug);
            loadError = ex.Message;
        }
    }

    /// <summary>
    /// Rebuilds the library table by joining this workspace's document memberships with the global
    /// document catalog (name/chunks/date) and a cross-workspace usage map (workspaces-using column).
    /// </summary>
    private async Task ReloadLibraryAsync()
    {
        if (workspace is null)
        {
            return;
        }

        isLoadingRows = true;
        StateHasChanged();
        try
        {
            var manager = await Rag.GetWorkspaceManagerAsync();
            if (manager is null)
            {
                return;
            }

            var store = manager.GetStore();
            var wsDocs = await store.ListDocumentsAsync(workspace.WorkspaceId);

            // Global catalog for the display fields the membership record does not carry.
            var catalog = new Dictionary<string, Document>(StringComparer.Ordinal);
            foreach (var doc in await Rag.ListDocumentsAsync())
            {
                catalog[doc.Id] = doc;
            }

            // Cross-workspace usage: which workspaces reference each document id.
            var usage = new Dictionary<string, List<string>>(StringComparer.Ordinal);
            IReadOnlyList<Workspace> allWorkspaces;
            try
            {
                allWorkspaces = await manager.ListWorkspacesAsync();
            }
            catch
            {
                allWorkspaces = new[] { workspace };
            }

            foreach (var ws in allWorkspaces)
            {
                foreach (var link in await store.ListDocumentsAsync(ws.WorkspaceId))
                {
                    if (!usage.TryGetValue(link.DocumentId, out var names))
                    {
                        names = new List<string>();
                        usage[link.DocumentId] = names;
                    }
                    if (!names.Contains(ws.Name))
                    {
                        names.Add(ws.Name);
                    }
                }
            }

            // REQ-RAG-052: which of THIS workspace's documents were embedded by something other than
            // the current provider. Computed from the catalog already fetched above, so it costs no
            // extra query. Scoped to the workspace on screen rather than the whole store, because a
            // count the user cannot act on from this page would be noise.
            staleness = EmbeddingStaleness.Analyze(
                wsDocs.Select(link => catalog.TryGetValue(link.DocumentId, out var d) ? d : null)
                      .Where(d => d is not null)
                      .Select(d => d!)
                      .ToList(),
                Rag.EmbeddingSignature);

            rows.Clear();
            foreach (var link in wsDocs)
            {
                catalog.TryGetValue(link.DocumentId, out var doc);
                var name = doc?.Name ?? link.DocumentId;
                var usingNames = usage.TryGetValue(link.DocumentId, out var list) ? list : new List<string> { workspace.Name };
                rows.Add(new DocRow
                {
                    DocumentId = link.DocumentId,
                    Name = name,
                    Type = TypeLabel(name),
                    SizeDisplay = SizeFromMetadata(doc),
                    ChunkCount = doc?.ChunkCount ?? 0,
                    Uploaded = (doc?.IngestedAt ?? link.AddedAt).ToLocalTime().ToString("yyyy-MM-dd"),
                    WorkspacesUsing = string.Join(", ", usingNames),
                    UsageCount = usingNames.Count,
                    IsPinned = link.IsPinned,
                    ContentHash = link.ContentHash
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reload workspace library");
            ToastService.Error(ex.Message, Localizer["DocsLibraryLoadFailed"].Value);
        }
        finally
        {
            isLoadingRows = false;
            StateHasChanged();
        }
    }

    /// <summary>Name of the host's file chooser, for the affordance copy (REQ-UI-041).</summary>
    private string PickerName => OperatingSystem.IsWindows() ? Localizer["DocsPickerNameWindows"] : Localizer["DocsPickerNameMac"];

    /// <summary>
    /// Opens the web-ingestion surface for this workspace (REQ-RAG-016/017/018).
    /// </summary>
    /// <remarks>
    /// A page, not a dialog. A crawl runs for minutes and reports per-page progress, and a modal
    /// that cannot be left without abandoning the run is the wrong container for that.
    /// </remarks>
    private void GoToWebIngestion() => Nav.NavigateTo($"/workspace/{Slug}/documents/web");

    /// <summary>Adds documents chosen in the OS file picker (REQ-UI-041).</summary>
    private async Task PickFilesAsync()
    {
        try
        {
            // No FileTypes filter: UploadTypePolicy owns the accept/reject matrix and produces a
            // per-file reason. A picker that hides a supported file the user can see in Finder is a
            // worse failure than one that lets an unsupported file through to a clear rejection.
            var picked = await FilePicker.Default.PickMultipleAsync(
                new PickOptions { PickerTitle = Localizer["DocsPickerTitle"] });
            var paths = picked?.Select(result => result.FullPath).Where(File.Exists).ToArray() ?? [];
            await UploadPathsAsync(paths);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "The OS file picker failed");
            ToastService.Error(Localizer["DocsPickerFailedBody", ex.Message].Value, Localizer["DocsPickerUnavailableTitle"].Value);
        }
    }

    /// <summary>Adds every file in a folder chosen in the OS folder picker (REQ-UI-041).</summary>
    private async Task PickFolderAsync()
    {
        if (!DesktopFolderPicker.IsSupported)
        {
            ToastService.Error(Localizer["DocsNoFolderPickerBody"].Value, Localizer["DocsPickerUnavailableTitle"].Value);
            return;
        }

        try
        {
            // Cancelling returns null and is not a failure; it must not raise an error toast.
            var folder = await DesktopFolderPicker.PickAsync();
            if (string.IsNullOrEmpty(folder))
            {
                return;
            }

            var paths = Directory.GetFiles(folder, "*", SearchOption.AllDirectories);
            if (paths.Length == 0)
            {
                ToastService.Error(Localizer["DocsFolderEmptyBody", folder].Value, Localizer["DocsNothingToAddTitle"].Value);
                return;
            }

            await UploadPathsAsync(paths);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "The OS folder picker failed");
            ToastService.Error(Localizer["DocsFolderPickerFailedBody", ex.Message].Value, Localizer["DocsPickerUnavailableTitle"].Value);
        }
    }

    // REQ-UI-019 / REQ-UI-041: multi-file upload — validates, dedupes, and embeds each queued file.
    private async Task UploadPathsAsync(IReadOnlyList<string> paths)
    {
        if (workspace is null || paths.Count == 0 || isUploading)
        {
            return;
        }

        var batch = paths.Select(path => new UploadItem(path)).ToList();
        uploadQueue.InsertRange(0, batch);
        isUploading = true;
        StateHasChanged();

        var manager = await Rag.GetWorkspaceManagerAsync();
        if (manager is null)
        {
            foreach (var item in batch)
            {
                item.Fail(Localizer["DocsPersistenceMissing"]);
            }
            isUploading = false;
            StateHasChanged();
            return;
        }

        var store = manager.GetStore();
        var embeddedAny = false;

        foreach (var item in batch)
        {
            // REQ-RAG-011: clear per-file rejection for genuinely unsupported types (no crash).
            var rejection = TechieDesk.Services.Data.UploadTypePolicy.GetRejection(item.Name);
            if (rejection is not null)
            {
                // REQ-UI-055: the policy returns a KEY; this page owns the language.
                item.Reject(Localizer[rejection.MessageKey, rejection.Arguments].Value);
                StateHasChanged();
                continue;
            }

            if (!File.Exists(item.Path))
            {
                item.Fail(Localizer["DocsFileNoLongerThere"]);
                StateHasChanged();
                continue;
            }

            if (new FileInfo(item.Path).Length > MaxUploadBytes)
            {
                item.Reject(Localizer["DocsTooLarge", MaxUploadBytes / (1024 * 1024)]);
                StateHasChanged();
                continue;
            }

            item.Status = UploadStatus.Embedding;
            item.Progress = 55;
            StateHasChanged();

            try
            {
                // REQ-RAG-012: content-hash dedupe pre-check so the UI can surface "reused".
                var bytes = await File.ReadAllBytesAsync(item.Path);
                var hash = Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant();
                var existing = await store.FindDocumentIdByHashAsync(hash);

                // REQ-UI-041: the OS picker hands over the real path, so the file is ingested where
                // it already lives. The previous browser upload had to be streamed out of the
                // WebView and re-staged in a temp directory purely to recover its original name.
                await manager.IngestFileAsync(workspace.WorkspaceId, item.Path, pinOnUpload);

                if (existing is not null)
                {
                    item.Status = UploadStatus.Duplicate;
                    item.Message = Localizer["DocsAlreadyEmbedded"];
                }
                else
                {
                    item.Status = UploadStatus.Embedded;
                }
                item.Progress = 100;
                embeddedAny = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to embed {File}", item.Name);
                item.Fail(ex.Message.Length > 160 ? ex.Message[..160] : ex.Message);
            }
            finally
            {
                StateHasChanged();
            }
        }

        isUploading = false;
        if (embeddedAny)
        {
            await ReloadLibraryAsync();
        }
        StateHasChanged();
    }

    private void ClearFinishedUploads()
        => uploadQueue.RemoveAll(u => u.Status != UploadStatus.Queued && u.Status != UploadStatus.Embedding);

    // REQ-RAG-013: pin toggle + persistence. Honored by WorkspaceManager.AskAsync and — since
    // TR-RAG-003 was closed — by WorkspaceManager.AskStreamWithSourcesAsync, which merges pinned
    // documents into the context on the streaming path the workspace chat uses.
    private async Task TogglePinAsync(DocRow row)
    {
        if (workspace is null || !canManage)
        {
            return;
        }

        busyDocId = row.DocumentId;
        try
        {
            var manager = await Rag.GetWorkspaceManagerAsync();
            if (manager is null)
            {
                return;
            }
            var next = !row.IsPinned;
            await manager.SetPinnedAsync(workspace.WorkspaceId, row.DocumentId, next);
            row.IsPinned = next;
            ToastService.Success(next ? Localizer["DocsPinnedToast"].Value : Localizer["DocsUnpinnedToast"].Value, Localizer["DocsUpdatedTitle"].Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle pin");
            ToastService.Error(ex.Message, Localizer["DocsPinFailedTitle"].Value);
        }
        finally
        {
            busyDocId = null;
        }
    }

    // REQ-UI-020: unembed removes the document from THIS workspace only; vectors stay for reuse.
    private async Task UnembedAsync(DocRow row)
    {
        if (workspace is null || !canManage)
        {
            return;
        }

        busyDocId = row.DocumentId;
        try
        {
            var manager = await Rag.GetWorkspaceManagerAsync();
            if (manager is null)
            {
                return;
            }
            await manager.GetStore().RemoveDocumentAsync(workspace.WorkspaceId, row.DocumentId);
            ToastService.Success(Localizer["DocsUnembeddedBody"].Value, Localizer["DocsUnembeddedTitle"].Value);
            await ReloadLibraryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to unembed document");
            ToastService.Error(ex.Message, Localizer["DocsUnembedFailedTitle"].Value);
        }
        finally
        {
            busyDocId = null;
        }
    }

    private void BeginDelete(DocRow row)
    {
        pendingDelete = row;
        showDeleteDialog = true;
    }

    // REQ-FN-012: delete removes the document from every workspace that uses it AND deletes the shared
    // vectors from the store (dedupe means one vector copy is shared, so this clears it everywhere).
    private async Task ConfirmDeleteAsync()
    {
        if (workspace is null || pendingDelete is null)
        {
            return;
        }

        var target = pendingDelete;
        busyDocId = target.DocumentId;
        try
        {
            var manager = await Rag.GetWorkspaceManagerAsync();
            if (manager is null)
            {
                return;
            }

            var store = manager.GetStore();
            foreach (var ws in await manager.ListWorkspacesAsync())
            {
                await store.RemoveDocumentAsync(ws.WorkspaceId, target.DocumentId);
            }
            await Rag.DeleteDocumentAsync(target.DocumentId);

            ToastService.Success(Localizer["DocsDeletedBody"].Value, Localizer["DocsDeletedTitle"].Value);
            showDeleteDialog = false;
            pendingDelete = null;
            await ReloadLibraryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete document everywhere");
            ToastService.Error(ex.Message, Localizer["DocsDeleteFailedTitle"].Value);
        }
        finally
        {
            busyDocId = null;
        }
    }

    private void OnDownloadProgressChanged(object? sender, ModelDownloadProgress progress)
    {
        downloadProgress = progress;
        UpdateDownloadStatus();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateDownloadStatus()
    {
        var status = ModelDownloadService.Instance.Progress.Status;
        isDownloadingModel = status == ModelDownloadStatus.Downloading || status == ModelDownloadStatus.Checking;
    }

    public void Dispose() => ModelDownloadService.Instance.ProgressChanged -= OnDownloadProgressChanged;

    private static string TypeLabel(string name)
    {
        var ext = Path.GetExtension(name);
        return string.IsNullOrEmpty(ext) ? "FILE" : ext.TrimStart('.').ToUpperInvariant();
    }

    // REQ-UI-021: the probe itself now lives in TechieDesk.Core so it can be tested against a
    // document that survived a real vector-store round trip. The behaviour is unchanged — the same
    // keys, the same formatting and the same em-dash fallback for a document ingested before the
    // pipeline recorded a size. Only the writer changed: TechieRagClient now records
    // DocumentMetadataKeys.FileSize, and SqliteVecStore lifts it onto the document row instead of
    // persisting a literal "{}".
    private static string SizeFromMetadata(Document? doc) =>
        TechieDesk.Services.Workspaces.DocumentSizeDisplay.FromMetadata(doc);

    /// <summary>A joined, display-ready library row (membership + catalog + usage).</summary>
    private sealed class DocRow
    {
        public required string DocumentId { get; init; }
        public required string Name { get; init; }
        public required string Type { get; init; }
        public required string SizeDisplay { get; init; }
        public int ChunkCount { get; init; }
        public required string Uploaded { get; init; }
        public required string WorkspacesUsing { get; init; }
        public int UsageCount { get; init; }
        public bool IsPinned { get; set; }
        public string ContentHash { get; init; } = string.Empty;
    }

    private enum UploadStatus { Queued, Embedding, Embedded, Duplicate, Rejected, Failed }

    /// <summary>A per-file upload with live status for the queue (REQ-UI-020).</summary>
    private sealed class UploadItem
    {
        public UploadItem(string path)
        {
            Path = path;
            Name = System.IO.Path.GetFileName(path);
        }

        /// <summary>Absolute path on disk, straight from the OS picker (REQ-UI-041).</summary>
        public string Path { get; }

        public string Name { get; }
        public UploadStatus Status { get; set; } = UploadStatus.Queued;
        public int Progress { get; set; }
        public string? Message { get; set; }

        public void Reject(string message)
        {
            Status = UploadStatus.Rejected;
            Progress = 100;
            Message = message;
        }

        public void Fail(string message)
        {
            Status = UploadStatus.Failed;
            Progress = 100;
            Message = message;
        }
    }
}
