@page "/qdrant-admin"
@using TechieDesk.Services
@inject IDockerContainerService DockerService
@inject IQdrantAdminService QdrantService
@inject ToastService ToastService
@inject ILogger<QdrantAdmin> Logger
@inject IJSRuntime JS

<PageTitle>Qdrant Admin</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0">Qdrant Database Management</h1>
            <TypographyMuted>Manage Qdrant vector database containers, collections, and vectors.</TypographyMuted>
        </div>
        <Button Variant="ButtonVariant.Outline" OnClick="RefreshStatusAsync">
            <Button.Icon><LucideIcon aria-hidden="true" Name="refresh-cw" Size="16" /></Button.Icon>
            Refresh
        </Button>
    </div>

    <!-- Connection & Endpoint Configuration -->
    <Card>
        <CardHeader>
            <CardTitle>Connection Configuration</CardTitle>
        </CardHeader>
        <CardContent Class="space-y-4">
            <div class="grid gap-4 md:grid-cols-4 items-end">
                <Field>
                    <FieldLabel>Host</FieldLabel>
                    <FieldContent>
                        <Input @bind-Value="configHost" Placeholder="localhost" />
                    </FieldContent>
                </Field>
                <Field>
                    <FieldLabel>gRPC Port</FieldLabel>
                    <FieldContent>
                        <Input Type="InputType.Number" @bind-Value="configPortString" Placeholder="6334" />
                    </FieldContent>
                </Field>
                <Field>
                    <FieldLabel>API Key (optional)</FieldLabel>
                    <FieldContent>
                        <Input Type="InputType.Password" @bind-Value="configApiKey" Placeholder="Enter API key..." />
                    </FieldContent>
                </Field>
                <Button OnClick="ApplyEndpointAsync">
                    <Button.Icon><LucideIcon aria-hidden="true" Name="plug" Size="16" /></Button.Icon>
                    Connect
                </Button>
            </div>

            <!-- Status Grid -->
            <div class="grid gap-4 md:grid-cols-4">
                <Card>
                    <CardHeader Class="pb-2">
                        <CardDescription>Docker</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <div class="text-xl font-bold @(isDockerAvailable ? "text-green-600" : "text-yellow-600")">
                            @(isDockerAvailable ? "Available" : "Not Available")
                        </div>
                    </CardContent>
                </Card>
                <Card>
                    <CardHeader Class="pb-2">
                        <CardDescription>Qdrant</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <div class="text-xl font-bold @(qdrantStatus == "Connected" ? "text-green-600" : "text-red-600")">
                            @qdrantStatus
                        </div>
                    </CardContent>
                </Card>
                <Card>
                    <CardHeader Class="pb-2">
                        <CardDescription>Version</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <div class="text-xl font-bold text-blue-600">@(clusterInfo?.Version ?? "N/A")</div>
                    </CardContent>
                </Card>
                <Card>
                    <CardHeader Class="pb-2">
                        <CardDescription>Collections</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <div class="text-xl font-bold text-blue-600">@(clusterInfo?.TotalCollections ?? 0)</div>
                    </CardContent>
                </Card>
            </div>

            <!-- Connection String -->
            <Alert Variant="@(qdrantStatus == "Connected" ? AlertVariant.Default : AlertVariant.Danger)">
                <AlertTitle>Connection String</AlertTitle>
                <AlertDescription>
                    <div class="flex items-center gap-2 mt-2">
                        <code class="flex-1 text-sm font-mono bg-muted px-3 py-2 rounded break-all">@QdrantService.ConnectionString</code>
                        <Button Variant="@(copiedConnection ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Small" OnClick="CopyConnectionString">
                            @(copiedConnection ? "Copied!" : "Copy")
                        </Button>
                    </div>
                    @if (qdrantStatus != "Connected" && !string.IsNullOrEmpty(QdrantService.LastError))
                    {
                        <div class="mt-2 text-sm text-destructive">
                            <strong>Error:</strong> @QdrantService.LastError
                        </div>
                    }
                </AlertDescription>
            </Alert>
        </CardContent>
    </Card>

    <!-- Docker Containers -->
    <Card>
        <CardHeader>
            <div class="flex items-center justify-between">
                <CardTitle>Qdrant Containers</CardTitle>
                @if (isDockerAvailable)
                {
                    <Dialog @bind-Open="showCreateContainerModal">
                        <DialogTrigger AsChild>
                            <Button Size="ButtonSize.Small">
                                <Button.Icon><LucideIcon aria-hidden="true" Name="plus" Size="16" /></Button.Icon>
                                Create Container
                            </Button>
                        </DialogTrigger>
                        <DialogContent>
                            <DialogHeader>
                                <DialogTitle>Create Qdrant Container</DialogTitle>
                                <DialogDescription>Create a new Docker container running Qdrant.</DialogDescription>
                            </DialogHeader>
                            <div class="space-y-4 py-4">
                                <Field>
                                    <FieldLabel>Container Name</FieldLabel>
                                    <FieldContent>
                                        <Input @bind-Value="newContainerName" Placeholder="techierag-qdrant" />
                                    </FieldContent>
                                </Field>
                                <Field>
                                    <FieldLabel>Volume Path (optional)</FieldLabel>
                                    <FieldContent>
                                        <Input @bind-Value="newContainerVolume" Placeholder="C:\QdrantData" />
                                        <FieldDescription>Leave empty for non-persistent storage.</FieldDescription>
                                    </FieldContent>
                                </Field>
                            </div>
                            <DialogFooter>
                                <Button Variant="ButtonVariant.Outline" OnClick="@(() => showCreateContainerModal = false)">Cancel</Button>
                                <Button OnClick="CreateContainerAsync" Disabled="@(string.IsNullOrWhiteSpace(newContainerName) || isCreatingContainer)">
                                    @(isCreatingContainer ? "Creating..." : "Create")
                                </Button>
                            </DialogFooter>
                        </DialogContent>
                    </Dialog>
                }
            </div>
        </CardHeader>
        <CardContent>
            @if (!isDockerAvailable)
            {
                <Alert Variant="AlertVariant.Danger">
                    <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
                    <AlertTitle>Docker Not Available</AlertTitle>
                    <AlertDescription>Install Docker Desktop or ensure Docker daemon is running to manage containers.</AlertDescription>
                </Alert>
            }
            else if (qdrantContainers.Count == 0)
            {
                <TypographyMuted>No Qdrant containers found. Create a new container to get started.</TypographyMuted>
            }
            else
            {
                <div class="relative overflow-x-auto" style="overflow-x:auto;max-width:100%">@* inline style: the Tailwind .overflow-x-auto utility is purged from the shipped TrBlazeUI CSS, so the class alone is inert (see docs/TechieRag-TrBlazeUI-Feedback.md TR-004) — inline guarantees wide DataTables clip on narrow viewports *@
                <DataTable TData="QdrantContainerInfo" Data="@qdrantContainers" ShowPagination="false" ShowToolbar="false">
                    <Columns>
                        <DataTableColumn TData="QdrantContainerInfo" TValue="string" Property="@(c => c.ContainerName)" Header="Container" />
                        <DataTableColumn TData="QdrantContainerInfo" TValue="string" Property="@(c => c.ImageName)" Header="Image" />
                        <DataTableColumn TData="QdrantContainerInfo" TValue="string" Property="@(c => c.HttpPort.HasValue ? c.HttpPort.Value.ToString() : "-")" Header="HTTP Port" />
                        <DataTableColumn TData="QdrantContainerInfo" TValue="string" Property="@(c => c.GrpcPort.HasValue ? c.GrpcPort.Value.ToString() : "-")" Header="gRPC Port" />
                        <DataTableColumn TData="QdrantContainerInfo" TValue="string" Property="@(c => c.Status.ToString())" Header="Status" />
                        <DataTableColumn TData="QdrantContainerInfo" TValue="string" Property="@(c => "")" Header="Actions">
                            <CellTemplate Context="ct">
                                <div class="flex gap-2">
                                    @if (ct.Status == ContainerStatus.Running)
                                    {
                                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => StopContainerAsync(ct.ContainerName))">Stop</Button>
                                    }
                                    else if (ct.Status == ContainerStatus.Exited || ct.Status == ContainerStatus.Created)
                                    {
                                        <Button Size="ButtonSize.Small" OnClick="@(() => StartContainerAsync(ct.ContainerName))">Start</Button>
                                    }
                                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => UseContainer(ct))">
                                        <LucideIcon aria-hidden="true" Name="plug" Size="14" />
                                    </Button>
                                </div>
                            </CellTemplate>
                        </DataTableColumn>
                    </Columns>
                </DataTable>
                </div>
            }
        </CardContent>
    </Card>

    <!-- Collections -->
    <Card>
        <CardHeader>
            <div class="flex items-center justify-between">
                <CardTitle>Collections</CardTitle>
                <Dialog @bind-Open="showCreateCollectionModal">
                    <DialogTrigger AsChild>
                        <Button Size="ButtonSize.Small" Disabled="@(qdrantStatus != "Connected")">
                            <Button.Icon><LucideIcon aria-hidden="true" Name="plus" Size="16" /></Button.Icon>
                            New Collection
                        </Button>
                    </DialogTrigger>
                    <DialogContent>
                        <DialogHeader>
                            <DialogTitle>Create New Collection</DialogTitle>
                            <DialogDescription>Create a new vector collection in Qdrant.</DialogDescription>
                        </DialogHeader>
                        <div class="space-y-4 py-4">
                            <Field>
                                <FieldLabel>Collection Name</FieldLabel>
                                <FieldContent>
                                    <Input @bind-Value="newCollectionName" Placeholder="my_collection" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel>Vector Dimensions</FieldLabel>
                                <FieldContent>
                                    <Input AriaLabel="Vector dimensions" Type="InputType.Number" @bind-Value="newCollectionDimensionsString" />
                                    <FieldDescription>Common: 384 (MiniLM), 768 (BERT), 1024 (BGE-M3)</FieldDescription>
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel>Distance Metric</FieldLabel>
                                <FieldContent>
                                    <Select @bind-Value="newCollectionDistance" TValue="string">
                                        <SelectTrigger>
                                            <SelectValue Placeholder="Select metric" /></SelectTrigger>
                                        <SelectContent>
                                            <SelectItem Value="@("Cosine")" Text="Cosine (Recommended)" TValue="string">Cosine (Recommended)</SelectItem>
                                            <SelectItem Value="@("Euclid")" Text="Euclidean" TValue="string">Euclidean</SelectItem>
                                            <SelectItem Value="@("Dot")" Text="Dot Product" TValue="string">Dot Product</SelectItem>
                                        </SelectContent>
                                    </Select>
                                </FieldContent>
                            </Field>
                        </div>
                        <DialogFooter>
                            <Button Variant="ButtonVariant.Outline" OnClick="@(() => showCreateCollectionModal = false)">Cancel</Button>
                            <Button OnClick="CreateCollectionAsync" Disabled="@string.IsNullOrWhiteSpace(newCollectionName)">Create</Button>
                        </DialogFooter>
                    </DialogContent>
                </Dialog>
            </div>
        </CardHeader>
        <CardContent>
            @if (qdrantStatus != "Connected")
            {
                <TypographyMuted>Connect to Qdrant to view collections.</TypographyMuted>
            }
            else if (collections.Count == 0)
            {
                <TypographyMuted>No collections. Create a new collection to start storing vectors.</TypographyMuted>
            }
            else
            {
                <div class="relative overflow-x-auto" style="overflow-x:auto;max-width:100%">@* inline style: the Tailwind .overflow-x-auto utility is purged from the shipped TrBlazeUI CSS, so the class alone is inert (see docs/TechieRag-TrBlazeUI-Feedback.md TR-004) — inline guarantees wide DataTables clip on narrow viewports *@
                <DataTable TData="CollectionInfo" Data="@collections" ShowPagination="false" ShowToolbar="false">
                    <Columns>
                        <DataTableColumn TData="CollectionInfo" TValue="string" Property="@(c => c.Name)" Header="Name" />
                        <DataTableColumn TData="CollectionInfo" TValue="string" Property="@(c => c.PointCount.ToString("N0"))" Header="Points" />
                        <DataTableColumn TData="CollectionInfo" TValue="string" Property="@(c => c.VectorCount.ToString("N0"))" Header="Vectors" />
                        <DataTableColumn TData="CollectionInfo" TValue="string" Property="@(c => "")" Header="Actions">
                            <CellTemplate Context="col">
                                <div class="flex gap-2">
                                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => SelectCollection(col.Name))">Browse</Button>
                                    <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" OnClick="@(() => DeleteCollectionAsync(col.Name))">Delete</Button>
                                </div>
                            </CellTemplate>
                        </DataTableColumn>
                    </Columns>
                </DataTable>
                </div>
            }
        </CardContent>
    </Card>

    <!-- Collection Detail -->
    @if (selectedCollection != null && selectedCollectionDetail != null)
    {
        <Card>
            <CardHeader>
                <div class="flex items-center justify-between">
                    <CardTitle>Collection: @selectedCollection</CardTitle>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => selectedCollection = null)">Close</Button>
                </div>
            </CardHeader>
            <CardContent Class="space-y-4">
                <!-- Collection Stats -->
                <div class="grid gap-4 md:grid-cols-4">
                    <Card>
                        <CardHeader Class="pb-2">
                            <CardDescription>Points</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <div class="text-2xl font-bold">@selectedCollectionDetail.PointCount.ToString("N0")</div>
                        </CardContent>
                    </Card>
                    <Card>
                        <CardHeader Class="pb-2">
                            <CardDescription>Vector Size</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <div class="text-2xl font-bold">@selectedCollectionDetail.VectorSize</div>
                        </CardContent>
                    </Card>
                    <Card>
                        <CardHeader Class="pb-2">
                            <CardDescription>Distance</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <div class="text-xl font-bold">@selectedCollectionDetail.DistanceMetric</div>
                        </CardContent>
                    </Card>
                    <Card>
                        <CardHeader Class="pb-2">
                            <CardDescription>Status</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <div class="text-xl font-bold @(selectedCollectionDetail.Status == "Green" ? "text-green-600" : "text-yellow-600")">
                                @selectedCollectionDetail.Status
                            </div>
                        </CardContent>
                    </Card>
                </div>

                <!-- Vectors Table -->
                <div>
                    <TypographyH4>Vectors</TypographyH4>
                    @if (currentVectorPage != null && currentVectorPage.Vectors.Count > 0)
                    {
                        <div class="relative overflow-x-auto" style="overflow-x:auto;max-width:100%">@* inline style: the Tailwind .overflow-x-auto utility is purged from the shipped TrBlazeUI CSS, so the class alone is inert (see docs/TechieRag-TrBlazeUI-Feedback.md TR-004) — inline guarantees wide DataTables clip on narrow viewports *@
                        <DataTable TData="VectorSummary" Data="@currentVectorPage.Vectors" ShowPagination="false" ShowToolbar="false">
                            <Columns>
                                <DataTableColumn TData="VectorSummary" TValue="string" Property="@(v => TruncateId(v.Id))" Header="ID" />
                                <DataTableColumn TData="VectorSummary" TValue="string" Property="@(v => v.DocumentName ?? "N/A")" Header="Document" />
                                <DataTableColumn TData="VectorSummary" TValue="string" Property="@(v => TruncateText(v.ChunkText, 60))" Header="Chunk Preview" />
                                <DataTableColumn TData="VectorSummary" TValue="string" Property="@(v => "")" Header="Actions">
                                    <CellTemplate Context="vec">
                                        <div class="flex gap-2">
                                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => ViewVectorAsync(vec.Id))">View</Button>
                                            <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" OnClick="@(() => DeleteVectorAsync(vec.Id))">Delete</Button>
                                        </div>
                                    </CellTemplate>
                                </DataTableColumn>
                            </Columns>
                        </DataTable>
                        </div>

                        <div class="flex flex-wrap justify-between items-center gap-2 mt-4 pt-4 border-t">
                            <TypographyMuted>
                                Showing @(currentVectorPage.Offset + 1)-@(currentVectorPage.Offset + currentVectorPage.Vectors.Count)
                                of @currentVectorPage.TotalCount.ToString("N0") vectors
                            </TypographyMuted>
                            <div class="flex gap-2">
                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="PreviousPage" Disabled="@(currentPageIndex == 0)">
                                    Previous
                                </Button>
                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="NextPage"
                                        Disabled="@(currentVectorPage.NextPageOffset == null)">
                                    Next
                                </Button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <TypographyMuted>No vectors in this collection.</TypographyMuted>
                    }
                </div>
            </CardContent>
        </Card>
    }
</div>

<!-- Vector Detail Dialog -->
<Dialog @bind-Open="showVectorDetailDialog">
    <DialogContent Class="max-w-2xl">
        <DialogHeader>
            <DialogTitle>Vector Details</DialogTitle>
        </DialogHeader>
        @if (selectedVector != null)
        {
            <div class="space-y-4 max-h-[70vh] overflow-auto py-4">
                <Field>
                    <FieldLabel>ID</FieldLabel>
                    <FieldContent>
                        <div class="font-mono text-sm bg-muted px-3 py-2 rounded">@selectedVector.Id</div>
                    </FieldContent>
                </Field>
                @if (!string.IsNullOrEmpty(selectedVector.DocumentName))
                {
                    <Field>
                        <FieldLabel>Document</FieldLabel>
                        <FieldContent>
                            <div class="text-sm bg-muted px-3 py-2 rounded">@selectedVector.DocumentName</div>
                        </FieldContent>
                    </Field>
                }
                @if (selectedVector.ChunkIndex.HasValue)
                {
                    <Field>
                        <FieldLabel>Chunk Index</FieldLabel>
                        <FieldContent>
                            <div class="text-sm bg-muted px-3 py-2 rounded">@selectedVector.ChunkIndex</div>
                        </FieldContent>
                    </Field>
                }
                @if (!string.IsNullOrEmpty(selectedVector.ChunkText))
                {
                    <Field>
                        <FieldLabel>Chunk Text</FieldLabel>
                        <FieldContent>
                            <div class="text-sm bg-muted px-3 py-2 rounded max-h-[200px] overflow-auto whitespace-pre-wrap">@selectedVector.ChunkText</div>
                        </FieldContent>
                    </Field>
                }
                <Field>
                    <FieldLabel>Payload</FieldLabel>
                    <FieldContent>
                        <pre class="text-xs bg-muted px-3 py-2 rounded max-h-[150px] overflow-auto m-0">@FormatPayload(selectedVector.Payload)</pre>
                    </FieldContent>
                </Field>
                <Field>
                    <FieldLabel>Vector (first 10 values)</FieldLabel>
                    <FieldContent>
                        <div class="font-mono text-xs bg-muted px-3 py-2 rounded">
                            [@string.Join(", ", selectedVector.Vector.Take(10).Select(v => v.ToString("F4")))]...
                        </div>
                    </FieldContent>
                </Field>
            </div>
            <DialogFooter>
                <Button Variant="ButtonVariant.Outline" OnClick="@(() => { selectedVector = null; showVectorDetailDialog = false; })">Close</Button>
                <Button Variant="ButtonVariant.Destructive" OnClick="@(() => DeleteVectorAsync(selectedVector.Id))">Delete</Button>
            </DialogFooter>
        }
    </DialogContent>
</Dialog>

@code {
    // Connection state
    private bool isDockerAvailable;
    private string qdrantStatus = "Checking...";
    private QdrantClusterInfo? clusterInfo;
    private List<QdrantContainerInfo> qdrantContainers = new();
    private List<CollectionInfo> collections = new();

    // Endpoint configuration
    private string configHost = "localhost";
    private int configPort = 6334;
    private string? configApiKey;
    private bool copiedConnection;

    private string configPortString
    {
        get => configPort.ToString();
        set { if (int.TryParse(value, out var p)) configPort = p; }
    }

    // Collection browsing
    private const int PageSize = 20;
    private string? selectedCollection;
    private CollectionDetailInfo? selectedCollectionDetail;
    private VectorPage? currentVectorPage;
    private VectorDetail? selectedVector;
    private bool showVectorDetailDialog;

    // Qdrant scroll is forward-only, so Previous is served from a history of the opaque
    // cursors used to LOAD each visited page (pageCursors[i] loads page i; [0] is null).
    private readonly List<string?> pageCursors = new();
    private int currentPageIndex;

    // Modals
    private bool showCreateCollectionModal;
    private string newCollectionName = "";
    private int newCollectionDimensions = 1024;
    private string newCollectionDistance = "Cosine";

    private string newCollectionDimensionsString
    {
        get => newCollectionDimensions.ToString();
        set { if (int.TryParse(value, out var d)) newCollectionDimensions = d; }
    }

    private bool showCreateContainerModal;
    private string newContainerName = "techierag-qdrant";
    private string? newContainerVolume;
    private bool isCreatingContainer;

    protected override async Task OnInitializedAsync()
    {
        configHost = QdrantService.Host;
        configPort = QdrantService.Port;
        await RefreshStatusAsync();
    }

    private async Task RefreshStatusAsync()
    {
        try
        {
            isDockerAvailable = await DockerService.IsDockerAvailableAsync();
            if (isDockerAvailable)
            {
                qdrantContainers = (await DockerService.ListQdrantContainersAsync()).ToList();

                if (qdrantStatus != "Connected" && qdrantContainers.Count > 0)
                {
                    var runningContainer = qdrantContainers.FirstOrDefault(c => c.Status == ContainerStatus.Running);
                    if (runningContainer?.GrpcPort != null)
                    {
                        configHost = "localhost";
                        configPort = runningContainer.GrpcPort.Value;
                        QdrantService.ConfigureEndpoint(configHost, configPort, configApiKey);
                    }
                }
            }

            var connected = await QdrantService.TestConnectionAsync();
            qdrantStatus = connected ? "Connected" : "Disconnected";

            if (connected)
            {
                clusterInfo = await QdrantService.GetClusterInfoAsync();
                collections = (await QdrantService.ListCollectionsAsync()).ToList();
            }
            else
            {
                clusterInfo = null;
                collections.Clear();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh status");
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
    }

    private async Task ApplyEndpointAsync()
    {
        QdrantService.ConfigureEndpoint(configHost, configPort, configApiKey);
        await RefreshStatusAsync();

        if (qdrantStatus == "Connected")
        {
            ToastService.Success($"Connected to {configHost}:{configPort}", "Connected");
        }
        else
        {
            var errorDetail = QdrantService.LastError ?? "Unknown error";
            ToastService.Error($"Failed to connect: {errorDetail}", "Connection Failed");
            Logger.LogWarning("Connection failed to {Host}:{Port}. Error: {Error}", configHost, configPort, errorDetail);
        }
    }

    private void UseContainer(QdrantContainerInfo container)
    {
        if (container.GrpcPort.HasValue)
        {
            configHost = "localhost";
            configPort = container.GrpcPort.Value;
            _ = ApplyEndpointAsync();
        }
    }

    private async Task CopyConnectionString()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", QdrantService.ConnectionString);
            copiedConnection = true;
            StateHasChanged();
            await Task.Delay(2000);
            copiedConnection = false;
            StateHasChanged();
        }
        catch
        {
            ToastService.Error("Failed to copy to clipboard.", "Error");
        }
    }

    private async Task CreateContainerAsync()
    {
        try
        {
            isCreatingContainer = true;
            StateHasChanged();

            await DockerService.CreateQdrantContainerAsync(newContainerName, newContainerVolume);
            showCreateContainerModal = false;
            ToastService.Success($"Container '{newContainerName}' created!", "Created");

            await Task.Delay(2000);
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
        finally
        {
            isCreatingContainer = false;
        }
    }

    private async Task StartContainerAsync(string containerName)
    {
        try
        {
            await DockerService.StartContainerAsync(containerName);
            ToastService.Success($"Container '{containerName}' started!", "Started");
            await Task.Delay(1500);
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
    }

    private async Task StopContainerAsync(string containerName)
    {
        try
        {
            await DockerService.StopContainerAsync(containerName);
            ToastService.Success($"Container '{containerName}' stopped!", "Stopped");
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
    }

    private void ShowCreateCollectionModal()
    {
        newCollectionName = "";
        newCollectionDimensions = 1024;
        newCollectionDistance = "Cosine";
        showCreateCollectionModal = true;
    }

    private async Task CreateCollectionAsync()
    {
        try
        {
            await QdrantService.CreateCollectionAsync(newCollectionName, newCollectionDimensions, newCollectionDistance);
            showCreateCollectionModal = false;
            ToastService.Success($"Collection '{newCollectionName}' created!", "Created");
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
    }

    private async Task DeleteCollectionAsync(string name)
    {
        try
        {
            await QdrantService.DeleteCollectionAsync(name);
            ToastService.Success($"Collection '{name}' deleted!", "Deleted");
            if (selectedCollection == name)
            {
                selectedCollection = null;
                selectedCollectionDetail = null;
            }
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
    }

    private async Task SelectCollection(string name)
    {
        try
        {
            selectedCollection = name;
            selectedCollectionDetail = await QdrantService.GetCollectionInfoAsync(name);
            pageCursors.Clear();
            pageCursors.Add(null); // first page has no cursor
            currentPageIndex = 0;
            currentVectorPage = await QdrantService.BrowseVectorsAsync(name, cursor: null, displayOffset: 0, limit: PageSize);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}", "Error");
        }
    }

    private async Task PreviousPage()
    {
        if (selectedCollection != null && currentPageIndex > 0)
        {
            currentPageIndex--;
            currentVectorPage = await QdrantService.BrowseVectorsAsync(
                selectedCollection,
                cursor: pageCursors[currentPageIndex],
                displayOffset: currentPageIndex * PageSize,
                limit: PageSize);
        }
    }

    private async Task NextPage()
    {
        // Advance only while the SDK reports a real next-page cursor (forward-only scroll).
        if (selectedCollection != null && currentVectorPage?.NextPageOffset != null)
        {
            var nextCursor = currentVectorPage.NextPageOffset;
            currentPageIndex++;
            if (currentPageIndex < pageCursors.Count)
            {
                pageCursors[currentPageIndex] = nextCursor;
            }
            else
            {
                pageCursors.Add(nextCursor);
            }

            currentVectorPage = await QdrantService.BrowseVectorsAsync(
                selectedCollection,
                cursor: nextCursor,
                displayOffset: currentPageIndex * PageSize,
                limit: PageSize);
        }
    }

    private async Task ViewVectorAsync(string id)
    {
        if (selectedCollection != null)
        {
            selectedVector = await QdrantService.GetVectorByIdAsync(selectedCollection, id);
            showVectorDetailDialog = true;
        }
    }

    private async Task DeleteVectorAsync(string id)
    {
        if (selectedCollection != null)
        {
            try
            {
                await QdrantService.DeleteVectorAsync(selectedCollection, id);
                selectedVector = null;
                showVectorDetailDialog = false;
                // Reload the current page using its own cursor (the start id of this page).
                var reloadCursor = currentPageIndex < pageCursors.Count ? pageCursors[currentPageIndex] : null;
                currentVectorPage = await QdrantService.BrowseVectorsAsync(
                    selectedCollection,
                    cursor: reloadCursor,
                    displayOffset: currentPageIndex * PageSize,
                    limit: PageSize);
                ToastService.Success("Vector deleted!", "Deleted");
            }
            catch (Exception ex)
            {
                ToastService.Error($"Error: {ex.Message}", "Error");
            }
        }
    }

    private static string TruncateId(string id) => id.Length > 16 ? id[..16] + "..." : id;
    private static string TruncateText(string? text, int maxLength) =>
        string.IsNullOrEmpty(text) ? "N/A" : (text.Length > maxLength ? text[..maxLength] + "..." : text);

    private static string FormatPayload(Dictionary<string, object> payload)
    {
        return string.Join("\n", payload.Select(kvp => $"{kvp.Key}: {kvp.Value}"));
    }
}
