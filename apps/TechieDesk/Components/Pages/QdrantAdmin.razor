</Dialog>

<!-- Vector Detail Dialog -->
<Dialog @bind-Open="showVectorDetailDialog">
    <DialogContent Class="max-w-2xl">
        <DialogHeader>
            <DialogTitle>@Localizer["QdrantVectorDetailsTitle"]</DialogTitle>
        </DialogHeader>
        @if (selectedVector != null)
        {
            <div class="space-y-4 max-h-[70vh] overflow-auto py-4">
                <Field>
                    <FieldLabel>@Localizer["QdrantColumnId"]</FieldLabel>
                    <FieldContent>
                        <div class="font-mono text-sm bg-muted px-3 py-2 rounded">@selectedVector.Id</div>
                    </FieldContent>
                </Field>
                @if (!string.IsNullOrEmpty(selectedVector.DocumentName))
                {
                    <Field>
                        <FieldLabel>@Localizer["QdrantColumnDocument"]</FieldLabel>
                        <FieldContent>
                            <div class="text-sm bg-muted px-3 py-2 rounded">@selectedVector.DocumentName</div>
                        </FieldContent>
                    </Field>
                }
                @if (selectedVector.ChunkIndex.HasValue)
                {
                    <Field>
                        <FieldLabel>@Localizer["QdrantChunkIndexLabel"]</FieldLabel>
                        <FieldContent>
                            <div class="text-sm bg-muted px-3 py-2 rounded">@selectedVector.ChunkIndex</div>
                        </FieldContent>
                    </Field>
                }
                @if (!string.IsNullOrEmpty(selectedVector.ChunkText))
                {
                    <Field>
                        <FieldLabel>@Localizer["QdrantChunkTextLabel"]</FieldLabel>
                        <FieldContent>
                            <div class="text-sm bg-muted px-3 py-2 rounded max-h-[200px] overflow-auto whitespace-pre-wrap">@selectedVector.ChunkText</div>
                        </FieldContent>
                    </Field>
                }
                <Field>
                    <FieldLabel>@Localizer["QdrantPayloadLabel"]</FieldLabel>
                    <FieldContent>
                        <pre class="text-xs bg-muted px-3 py-2 rounded max-h-[150px] overflow-auto m-0">@FormatPayload(selectedVector.Payload)</pre>
                    </FieldContent>
                </Field>
                <Field>
                    <FieldLabel>@Localizer["QdrantVectorFirstValuesLabel"]</FieldLabel>
                    <FieldContent>
                        <div class="font-mono text-xs bg-muted px-3 py-2 rounded">
                            [@string.Join(", ", selectedVector.Vector.Take(10).Select(v => v.ToString("F4")))]...
                        </div>
                    </FieldContent>
                </Field>
            </div>
            <DialogFooter>
                <Button Variant="ButtonVariant.Outline" OnClick="@(() => { selectedVector = null; showVectorDetailDialog = false; })">@Localizer["QdrantClose"]</Button>
                <Button Variant="ButtonVariant.Destructive" OnClick="@(() => DeleteVectorAsync(selectedVector.Id))">@Localizer["QdrantDelete"]</Button>
            </DialogFooter>
        }
    </DialogContent>
</Dialog>

@code {
    // ---- REQ-UI-042: Docker daemon endpoint configuration ----
    /// <summary>How many trailing log lines the logs dialog reads.</summary>
    private const int LogTailLines = 200;

    // TR-024: a Select trigger paints the RAW BOUND VALUE on first paint, which is why the option
    // values used to BE the English labels. REQ-UI-051 replaced that with DisplayTextSelector, so
    // the bound value is now the culture-invariant enum and only the display text is translated.
    private DockerDaemonEndpointKind daemonKind = DockerDaemonEndpointKind.LocalSocket;
    private string daemonAddress = "";
    private bool verifyTls = true;
    private bool isTestingDaemon;
    private bool isPullingImage;
    private DockerDaemonTestResult? daemonTest;
    private string activeEndpointDisplay = "";
    private DockerDaemonEndpointKind activeEndpointKind = DockerDaemonEndpointKind.LocalSocket;
    private string? daemonSecurityWarningKey;
    private bool activeUsesTls;
    private bool activeVerifyTls = true;
    private bool hasClientCertificate;

    private bool showLogsDialog;
    private string logsContainerName = "";
    private string containerLogs = "";

    private string DaemonAddressPlaceholder => daemonKind switch
    {
        DockerDaemonEndpointKind.RemoteTls => $"qdrant-host.lan:{DockerDaemonEndpoint.DefaultTlsPort}",
        DockerDaemonEndpointKind.NetworkHost => $"qdrant-host.lan:{DockerDaemonEndpoint.DefaultPlainPort}",
        _ => DockerDaemonEndpoint.Local().Display
    };

    /// <summary>REQ-UI-051 / TR-024: the localized display text for a Qdrant distance metric.</summary>
    /// <param name="value">The invariant metric name, which is what Qdrant receives.</param>
    /// <returns>The text painted on the Select trigger.</returns>
    private string DistanceMetricText(string value) => value switch
    {
        "Euclid" => Localizer["QdrantDistanceEuclidean"],
        "Dot" => Localizer["QdrantDistanceDot"],
        _ => Localizer["QdrantDistanceCosine"]
    };

    /// <summary>REQ-UI-051: the localized name of a Docker daemon endpoint kind.</summary>
    /// <param name="kind">The endpoint kind to name.</param>
    /// <returns>The text shown in the option list and on the Select trigger.</returns>
    /// <remarks>
    /// REQ-UI-055: the key now comes from <see cref="DockerDaemonEndpoint.KindLabelKeyFor"/>, so the
    /// service and this screen can no longer name the same endpoint two different ways. Only the
    /// LABEL moves with the culture — the bound value stays the invariant enum, and nothing parses
    /// this text back into a kind. That was the original defect: the Select's bound value WAS the
    /// English label and <c>ParseKind</c> turned it back into an endpoint, so a translated install
    /// would have built a socket path out of Devanagari.
    /// </remarks>
    private string DaemonKindText(DockerDaemonEndpointKind kind) =>
        Localizer[DockerDaemonEndpoint.KindLabelKeyFor(kind)];

    /// <summary>
    /// REQ-UI-055: resolves the Docker service's failure KEY into the reader's language.
    /// </summary>
    /// <param name="failure">The failure the service reported, or null.</param>
    /// <returns>The translated sentence, or an empty string when there is no failure.</returns>
    /// <remarks>
    /// The arguments are deliberately NOT translated: the endpoint that was tried is wire
    /// vocabulary, and a socket error code, an HTTP status and the daemon's own response body are
    /// text Docker or the runtime produced. Rewriting those would invent an error nobody emitted.
    /// </remarks>
    private string DaemonFailureText(DockerEndpointProblem? failure) =>
        failure is null ? string.Empty : Localizer[failure.MessageKey, [.. failure.Arguments]].Value;

    private BadgeVariant TlsBadgeVariant => activeUsesTls
        ? (activeVerifyTls ? BadgeVariant.Default : BadgeVariant.Destructive)
        : (activeEndpointKind == DockerDaemonEndpointKind.LocalSocket ? BadgeVariant.Secondary : BadgeVariant.Destructive);

    private string TlsBadgeText => activeUsesTls
        ? (activeVerifyTls ? Localizer["QdrantTlsVerified"] : Localizer["QdrantTlsUnverified"])
        : (activeEndpointKind == DockerDaemonEndpointKind.LocalSocket
            ? Localizer["QdrantEndpointKindLocalSocket"]
            : Localizer["QdrantTlsUnencryptedTcp"]);

    private string LastCheckedText => daemonTest is null
        ? Localizer["QdrantNotCheckedYet"]
        : daemonTest.CheckedAt.ToLocalTime().ToString("HH:mm:ss");

    // Connection state
    private bool isDockerAvailable;
    // REQ-UI-051: qdrantStatus is a STATE, compared in six places, so it stays culture-invariant
    // and QdrantStatusText is what the user reads.
    private const string QdrantStatusChecking = "Checking";
    private const string QdrantStatusConnected = "Connected";
    private const string QdrantStatusDisconnected = "Disconnected";

    private string qdrantStatus = QdrantStatusChecking;

    /// <summary>REQ-UI-051: the localized wording of the current connection state.</summary>
    private string QdrantStatusText => qdrantStatus switch
    {
        QdrantStatusConnected => Localizer["QdrantStatusConnected"],
        QdrantStatusDisconnected => Localizer["QdrantStatusDisconnected"],
        _ => Localizer["QdrantStatusChecking"]
    };
    private QdrantClusterInfo? clusterInfo;
    private List<QdrantContainerInfo> qdrantContainers = new();
    private List<CollectionInfo> collections = new();

    // Endpoint configuration
    private string configHost = "localhost";
    private int configPort = 6334;
    private string? configApiKey;
    private bool copiedConnection;

    private string configPortString
    {
        get => configPort.ToString();
        set { if (int.TryParse(value, out var p)) configPort = p; }
    }

    // Collection browsing
    private const int PageSize = 20;
    private string? selectedCollection;
    private CollectionDetailInfo? selectedCollectionDetail;
    private VectorPage? currentVectorPage;
    private VectorDetail? selectedVector;
    private bool showVectorDetailDialog;

    // Qdrant scroll is forward-only, so Previous is served from a history of the opaque
    // cursors used to LOAD each visited page (pageCursors[i] loads page i; [0] is null).
    private readonly List<string?> pageCursors = new();
    private int currentPageIndex;

    // Modals
    private bool showCreateCollectionModal;
    private string newCollectionName = "";
    private int newCollectionDimensions = 1024;
    private string newCollectionDistance = "Cosine";

    private string newCollectionDimensionsString
    {
        get => newCollectionDimensions.ToString();
        set { if (int.TryParse(value, out var d)) newCollectionDimensions = d; }
    }

    private bool showCreateContainerModal;
    private string newContainerName = "techierag-qdrant";
    private string? newContainerVolume;
    private bool isCreatingContainer;

    protected override async Task OnInitializedAsync()
    {
        configHost = QdrantService.Host;
        configPort = QdrantService.Port;

        var endpoint = await DockerService.GetActiveEndpointAsync();
        daemonKind = endpoint.Kind;
        daemonAddress = endpoint.Kind == DockerDaemonEndpointKind.LocalSocket
            ? ""
            : $"{endpoint.Uri.Host}:{endpoint.Uri.Port}";
        verifyTls = endpoint.VerifyTls;
        ApplyEndpointToView(endpoint);

        await RefreshStatusAsync();
    }

    /// <summary>
    /// Mirrors the daemon endpoint the service is actually using into the view, so the screen can
    /// never show a daemon nobody selected.
    /// </summary>
    private void ApplyEndpointToView(DockerDaemonEndpoint endpoint)
    {
        activeEndpointDisplay = endpoint.Display;
        activeEndpointKind = endpoint.Kind;
        activeUsesTls = endpoint.UsesTls;
        activeVerifyTls = endpoint.VerifyTls;
        daemonSecurityWarningKey = endpoint.SecurityWarningKey;
        hasClientCertificate = DockerService.HasClientCertificate;
    }

    private async Task TestDaemonAsync()
    {
        isTestingDaemon = true;
        try
        {
            // REQ-UI-055: TryFromKind rather than catching ArgumentException. The exception's
            // message is culture-invariant developer text by design; the toast needs the reader's
            // language, which only the resource key can give it.
            if (!DockerDaemonEndpoint.TryFromKind(
                    daemonKind, daemonAddress, verifyTls, out var candidate, out var problem))
            {
                ToastService.Error(
                    DaemonFailureText(problem), Localizer["QdrantInvalidEndpointTitle"].Value);
                return;
            }

            daemonTest = await DockerService.TestConnectionAsync(candidate);
            isDockerAvailable = daemonTest.Success && candidate.Display == activeEndpointDisplay;

            if (daemonTest.Success)
            {
                ToastService.Success(
                    Localizer["QdrantDaemonAnsweredBody", candidate.Display, daemonTest.DaemonVersion, daemonTest.HostOperatingSystem].Value,
                    Localizer["QdrantDaemonReachableTitle"].Value);
            }
            else
            {
                // Honest failure: the operator sees the endpoint that was tried and the real reason.
                ToastService.Error(
                    daemonTest.Failure is null
                        ? Localizer["QdrantUnknownFailure"].Value
                        : DaemonFailureText(daemonTest.Failure),
                    Localizer["QdrantDaemonUnreachableShort"].Value);
                Logger.LogWarning("Docker daemon test failed for {Endpoint}: {Reason}",
                    candidate.Display, daemonTest.Failure);
            }
        }
        finally
        {
            isTestingDaemon = false;
        }
    }

    private async Task ApplyDaemonAsync()
    {
        // REQ-UI-055: refuse in the reader's language BEFORE the service throws a developer-facing
        // ArgumentException whose message is deliberately culture-invariant.
        if (!DockerDaemonEndpoint.TryFromKind(daemonKind, daemonAddress, verifyTls, out _, out var problem))
        {
            ToastService.Error(DaemonFailureText(problem), Localizer["QdrantInvalidEndpointTitle"].Value);
            return;
        }

        try
        {
            var endpoint = await DockerService.ConfigureEndpointAsync(
                daemonKind, daemonAddress, verifyTls);
            ApplyEndpointToView(endpoint);

            if (endpoint.HasSecurityWarning)
            {
                // TrBlazeUI has no warning-severity toast (TR-023): Destructive is the only variant
                // that reads as "stop and look", which is right for a root-on-host warning. The
                // amber Alert on the card carries the durable, correctly-toned message.
                ToastService.Show(Localizer[endpoint.SecurityWarningKey!].Value,
                    Localizer["QdrantUnsafeEndpointTitle"].Value,
                    ToastVariant.Destructive, 10000);
            }

            await RefreshStatusAsync();
        }
        catch (ArgumentException ex)
        {
            // Unreachable in practice — the guard above already refused anything TryFromKind
            // rejects — but a swallowed configuration failure would leave the screen showing a
            // daemon nobody selected, so it is reported rather than assumed away.
            ToastService.Error(
                Localizer["QdrantUnknownFailure"].Value, Localizer["QdrantInvalidEndpointTitle"].Value);
            Logger.LogError(ex, "Docker daemon endpoint {Kind}/{Address} was rejected on apply",
                daemonKind, daemonAddress);
        }
    }

    private async Task ViewLogsAsync(string containerName)
    {
        logsContainerName = containerName;
        showLogsDialog = true;
        containerLogs = Localizer["QdrantLoadingLogs"];
        try
        {
            // REQ-UI-055: an empty tail is the service saying "the daemon produced nothing", not a
            // sentence it composed. The sentence belongs here, where there is a localizer.
            var tail = await DockerService.GetContainerLogsAsync(containerName, LogTailLines);
            containerLogs = tail.Length > 0
                ? tail
                : Localizer[DockerContainerService.NoLogOutputKey, activeEndpointDisplay, containerName].Value;
        }
        catch (Exception ex)
        {
            containerLogs = Localizer["QdrantLogsUnreadable", containerName, activeEndpointDisplay, ex.Message];
            Logger.LogError(ex, "Failed to read logs for {Container}", containerName);
        }
    }

    private async Task PullImageAsync()
    {
        isPullingImage = true;
        try
        {
            await DockerService.PullQdrantImageAsync();
            ToastService.Success(Localizer["QdrantImagePulledBody", activeEndpointDisplay].Value, Localizer["QdrantImagePulledTitle"].Value);
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["QdrantPullFailedBody", activeEndpointDisplay, ex.Message].Value, Localizer["QdrantPullFailedTitle"].Value);
            Logger.LogError(ex, "Failed to pull the Qdrant image from {Endpoint}", activeEndpointDisplay);
        }
        finally
        {
            isPullingImage = false;
        }
    }

    private async Task RestartContainerAsync(string containerName)
    {
        try
        {
            await DockerService.RestartContainerAsync(containerName);
            ToastService.Success(Localizer["QdrantContainerRestartedBody", containerName].Value, Localizer["QdrantRestartedTitle"].Value);
            await Task.Delay(1500);
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["QdrantErrorDetail", ex.Message].Value, Localizer["QdrantErrorTitle"].Value);
        }
    }

    private async Task RefreshStatusAsync()
    {
        try
        {
            var endpoint = await DockerService.GetActiveEndpointAsync();
            ApplyEndpointToView(endpoint);

            daemonTest = await DockerService.TestConnectionAsync();
            isDockerAvailable = daemonTest.Success;

            if (isDockerAvailable)
            {
                qdrantContainers = (await DockerService.ListQdrantContainersAsync()).ToList();

                if (qdrantStatus != QdrantStatusConnected && qdrantContainers.Count > 0)
                {
                    var runningContainer = qdrantContainers.FirstOrDefault(c => c.Status == ContainerStatus.Running);
                    if (runningContainer?.GrpcPort != null)
                    {
                        configHost = "localhost";
                        configPort = runningContainer.GrpcPort.Value;
                        QdrantService.ConfigureEndpoint(configHost, configPort, configApiKey);
                    }
                }
            }

            var connected = await QdrantService.TestConnectionAsync();
            qdrantStatus = connected ? QdrantStatusConnected : QdrantStatusDisconnected;

            if (connected)
            {
                clusterInfo = await QdrantService.GetClusterInfoAsync();
                collections = (await QdrantService.ListCollectionsAsync()).ToList();
            }
            else
            {
                clusterInfo = null;
                collections.Clear();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh status");
            ToastService.Error(Localizer["QdrantErrorDetail", ex.Message].Value, Localizer["QdrantErrorTitle"].Value);
        }
    }

    private async Task ApplyEndpointAsync()
    {
        QdrantService.ConfigureEndpoint(configHost, configPort, configApiKey);
        await RefreshStatusAsync();

        if (qdrantStatus == QdrantStatusConnected)
        {
            ToastService.Success(Localizer["QdrantConnectedToBody", configHost, configPort].Value, Localizer["QdrantConnected"].Value);
        }
        else
        {
            var errorDetail = QdrantService.LastError ?? Localizer["QdrantUnknownError"].Value;
            ToastService.Error(Localizer["QdrantConnectFailedBody", errorDetail].Value, Localizer["QdrantConnectionFailedTitle"].Value);
            Logger.LogWarning("Connection failed to {Host}:{Port}. Error: {Error}", configHost, configPort, errorDetail);
        }
    }

    private void UseContainer(QdrantContainerInfo container)
    {
        if (container.GrpcPort.HasValue)
        {
            configHost = "localhost";
            configPort = container.GrpcPort.Value;
            _ = ApplyEndpointAsync();
        }
    }

    private async Task CopyConnectionString()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", QdrantService.ConnectionString);
            copiedConnection = true;
            StateHasChanged();
            await Task.Delay(2000);
            copiedConnection = false;
            StateHasChanged();
        }
        catch
        {
            ToastService.Error(Localizer["QdrantClipboardFailed"].Value, Localizer["QdrantErrorTitle"].Value);
        }
    }

    private async Task CreateContainerAsync()
    {
        try
        {
            isCreatingContainer = true;
            StateHasChanged();

            await DockerService.CreateQdrantContainerAsync(newContainerName, newContainerVolume);
            showCreateContainerModal = false;
            ToastService.Success(Localizer["QdrantContainerCreatedBody", newContainerName].Value, Localizer["QdrantCreatedTitle"].Value);

            await Task.Delay(2000);
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["QdrantErrorDetail", ex.Message].Value, Localizer["QdrantErrorTitle"].Value);
        }
        finally
        {
            isCreatingContainer = false;
        }
    }

    private async Task StartContainerAsync(string containerName)
    {
        try
        {
            await DockerService.StartContainerAsync(containerName);
            ToastService.Success(Localizer["QdrantContainerStartedBody", containerName].Value, Localizer["QdrantStartedTitle"].Value);
            await Task.Delay(1500);
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["QdrantErrorDetail", ex.Message].Value, Localizer["QdrantErrorTitle"].Value);
        }
    }

    private async Task StopContainerAsync(string containerName)
    {
        try
        {
            await DockerService.StopContainerAsync(containerName);
            ToastService.Success(Localizer["QdrantContainerStoppedBody", containerName].Value, Localizer["QdrantStoppedTitle"].Value);
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["QdrantErrorDetail", ex.Message].Value, Localizer["QdrantErrorTitle"].Value);
        }
    }

    private void ShowCreateCollectionModal()
    {
        newCollectionName = "";
        newCollectionDimensions = 1024;
        newCollectionDistance = "Cosine";
        showCreateCollectionModal = true;
    }

    private async Task CreateCollectionAsync()
    {
        try
        {
            await QdrantService.CreateCollectionAsync(newCollectionName, newCollectionDimensions, newCollectionDistance);
            showCreateCollectionModal = false;
            ToastService.Success(Localizer["QdrantCollectionCreatedBody", newCollectionName].Value, Localizer["QdrantCreatedTitle"].Value);
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["QdrantErrorDetail", ex.Message].Value, Localizer["QdrantErrorTitle"].Value);
        }
    }

    private async Task DeleteCollectionAsync(string name)
    {
        try
        {
            await QdrantService.DeleteCollectionAsync(name);
            ToastService.Success(Localizer["QdrantCollectionDeletedBody", name].Value, Localizer["QdrantDeletedTitle"].Value);
            if (selectedCollection == name)
            {
                selectedCollection = null;
                selectedCollectionDetail = null;
            }
            await RefreshStatusAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["QdrantErrorDetail", ex.Message].Value, Localizer["QdrantErrorTitle"].Value);
        }
    }

    private async Task SelectCollection(string name)
    {
        try
        {
            selectedCollection = name;
            selectedCollectionDetail = await QdrantService.GetCollectionInfoAsync(name);
            pageCursors.Clear();
            pageCursors.Add(null); // first page has no cursor
            currentPageIndex = 0;
            currentVectorPage = await QdrantService.BrowseVectorsAsync(name, cursor: null, displayOffset: 0, limit: PageSize);
        }
        catch (Exception ex)
        {
            ToastService.Error(Localizer["QdrantErrorDetail", ex.Message].Value, Localizer["QdrantErrorTitle"].Value);
        }
    }

    private async Task PreviousPage()
    {
        if (selectedCollection != null && currentPageIndex > 0)
        {
            currentPageIndex--;
            currentVectorPage = await QdrantService.BrowseVectorsAsync(
                selectedCollection,
                cursor: pageCursors[currentPageIndex],
                displayOffset: currentPageIndex * PageSize,
                limit: PageSize);
        }
    }

    private async Task NextPage()
    {
        // Advance only while the SDK reports a real next-page cursor (forward-only scroll).
        if (selectedCollection != null && currentVectorPage?.NextPageOffset != null)
        {
            var nextCursor = currentVectorPage.NextPageOffset;
            currentPageIndex++;
            if (currentPageIndex < pageCursors.Count)
            {
                pageCursors[currentPageIndex] = nextCursor;
            }
            else
            {
                pageCursors.Add(nextCursor);
            }

            currentVectorPage = await QdrantService.BrowseVectorsAsync(
                selectedCollection,
                cursor: nextCursor,
                displayOffset: currentPageIndex * PageSize,
                limit: PageSize);
        }
    }

    private async Task ViewVectorAsync(string id)
    {
        if (selectedCollection != null)
        {
            selectedVector = await QdrantService.GetVectorByIdAsync(selectedCollection, id);
            showVectorDetailDialog = true;
        }
    }

    private async Task DeleteVectorAsync(string id)
    {
        if (selectedCollection != null)
        {
            try
            {
                await QdrantService.DeleteVectorAsync(selectedCollection, id);
                selectedVector = null;
                showVectorDetailDialog = false;
                // Reload the current page using its own cursor (the start id of this page).
                var reloadCursor = currentPageIndex < pageCursors.Count ? pageCursors[currentPageIndex] : null;
                currentVectorPage = await QdrantService.BrowseVectorsAsync(
                    selectedCollection,
                    cursor: reloadCursor,
                    displayOffset: currentPageIndex * PageSize,
                    limit: PageSize);
                ToastService.Success(Localizer["QdrantVectorDeletedBody"].Value, Localizer["QdrantDeletedTitle"].Value);
            }
            catch (Exception ex)
            {
                ToastService.Error(Localizer["QdrantErrorDetail", ex.Message].Value, Localizer["QdrantErrorTitle"].Value);
            }
        }
    }

    private static string TruncateId(string id) => id.Length > 16 ? id[..16] + "..." : id;
    private static string TruncateText(string? text, int maxLength) =>
        string.IsNullOrEmpty(text) ? "N/A" : (text.Length > maxLength ? text[..maxLength] + "..." : text);

    private static string FormatPayload(Dictionary<string, object> payload)
    {
        return string.Join("\n", payload.Select(kvp => $"{kvp.Key}: {kvp.Value}"));
    }
}
