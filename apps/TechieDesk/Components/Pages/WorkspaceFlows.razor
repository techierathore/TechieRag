    /// <summary>
    /// Renders why a guardrail stopped the run, in the reader's language when this build knows the
    /// guardrail (REQ-UI-055 / BRD-91).
    /// </summary>
    /// <param name="result">The blocked run.</param>
    /// <returns>The translated reason, or the library's own English reason for an unknown id.</returns>
    /// <remarks>
    /// The reason on <c>FlowRunResult</c> is deliberately English: the same string is handed to the
    /// MODEL when a flow is invoked as a tool by an agent, and to the library's trace and logs. So
    /// the catalogue publishes a resource key per guardrail ID — the wire value, which is the same in
    /// every culture — and this is where it becomes a sentence. The fallback matters: an MCP-era
    /// build or a host guardrail can refuse under an id this catalogue does not own, and an English
    /// explanation is far better than a blank alert.
    /// </remarks>
    private string BlockedReasonText(FlowRunResult result) =>
        FlowGuardrailCatalog.BlockReasonKey(result.BlockedByGuardrailId) is { } key
            ? Localizer[key].Value
            : result.BlockReason ?? string.Empty;

