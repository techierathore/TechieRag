    /// <summary>
    /// Translates a catalogue field's label.
    /// </summary>
    /// <param name="kind">The node kind the field belongs to.</param>
    /// <param name="field">The field descriptor published by the catalogue.</param>
    /// <returns>The translated label, or the library's English one for a field this build has not translated.</returns>
    /// <remarks>
    /// The one field whose meaning depends on its kind is <c>Instruction</c>: on an agent step it is
    /// the task, on an end step it is an output override. Translating it by property name alone would
    /// print the wrong label on one of the two.
    /// </remarks>
    private string FieldLabelFor(FlowNodeKind kind, FlowFieldDescriptor field) =>
        kind == FlowNodeKind.Terminal && field.Property == nameof(FlowNode.Instruction)
            ? Localizer["FlowsFieldTerminalInstruction"]
            : field.Property switch
            {
                nameof(FlowNode.Name) => Localizer["FlowsFieldName"],
                nameof(FlowNode.Description) => Localizer["FlowsFieldDescription"],
                nameof(FlowNode.AgentId) => Localizer["FlowsFieldAgentId"],
                nameof(FlowNode.Instruction) => Localizer["FlowsFieldInstruction"],
                nameof(FlowNode.ToolName) => Localizer["FlowsFieldToolName"],
                nameof(FlowNode.ToolArgumentsJson) => Localizer["FlowsFieldToolArgumentsJson"],
                nameof(FlowNode.GuardrailIds) => Localizer["FlowsFieldGuardrailIds"],
                nameof(FlowNode.OutputVariable) => Localizer["FlowsFieldOutputVariable"],
                nameof(FlowNode.MaxToolCalls) => Localizer["FlowsFieldMaxToolCalls"],
                nameof(FlowNode.TerminalStatus) => Localizer["FlowsFieldTerminalStatus"],
                nameof(FlowNode.Handoff) => Localizer["FlowsFieldHandoff"],
                _ => field.DisplayName
            };

