    /// <summary>
    /// Translates a validation issue by its CODE.
    /// </summary>
    /// <param name="issue">The issue reported by the library.</param>
    /// <returns>The translated explanation, or the library's English message for an unknown code.</returns>
    /// <remarks>
    /// <c>FlowValidationIssue.Code</c> is documented as the stable contract and the English
    /// <c>Message</c> as a fallback rather than a parsing target. Translating the message — or worse,
    /// matching on it — would break the day the library rewords it, and would leave a Hindi screen
    /// printing English sentences.
    /// </remarks>
    private string IssueText(FlowValidationIssue issue) => issue.Code switch
    {
        FlowValidationCodes.EmptyFlow => Localizer["FlowsIssueEmptyFlow"],
        FlowValidationCodes.MissingIdentity => Localizer["FlowsIssueMissingIdentity"],
        FlowValidationCodes.DuplicateNodeId => Localizer["FlowsIssueDuplicateNodeId"],
        FlowValidationCodes.DuplicateEdgeId => Localizer["FlowsIssueDuplicateEdgeId"],
        FlowValidationCodes.BlankNodeId => Localizer["FlowsIssueBlankNodeId"],
        FlowValidationCodes.UnknownStartNode => Localizer["FlowsIssueUnknownStartNode"],
        FlowValidationCodes.ImplicitStartNode => Localizer["FlowsIssueImplicitStartNode"],
        FlowValidationCodes.DanglingEdge => Localizer["FlowsIssueDanglingEdge"],
        FlowValidationCodes.DeadEndNode => Localizer["FlowsIssueDeadEndNode"],
        FlowValidationCodes.UnreachableNode => Localizer["FlowsIssueUnreachableNode"],
        FlowValidationCodes.MissingAgentId => Localizer["FlowsIssueMissingAgentId"],
        FlowValidationCodes.MissingToolName => Localizer["FlowsIssueMissingToolName"],
        FlowValidationCodes.MissingHandoffTarget => Localizer["FlowsIssueMissingHandoffTarget"],
        FlowValidationCodes.UnknownHandoffTarget => Localizer["FlowsIssueUnknownHandoffTarget"],
        FlowValidationCodes.HandoffTargetNotAgent => Localizer["FlowsIssueHandoffTargetNotAgent"],
        FlowValidationCodes.IrrelevantProperty => Localizer["FlowsIssueIrrelevantProperty"],
        FlowValidationCodes.CycleDetected => Localizer["FlowsIssueCycleDetected"],
        FlowValidationCodes.InvalidStepBudget => Localizer["FlowsIssueInvalidStepBudget"],
        FlowValidationCodes.NoDefaultBranch => Localizer["FlowsIssueNoDefaultBranch"],
        FlowValidationCodes.UnreachableBranch => Localizer["FlowsIssueUnreachableBranch"],
