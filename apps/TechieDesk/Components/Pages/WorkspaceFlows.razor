    private string NodeLabelFor(string? nodeId) =>
        editor?.FindNode(nodeId)?.DisplayName ?? nodeId ?? string.Empty;

    /// <summary>
    /// Renders a step-picker's bound value as the step's NAME.
    /// </summary>
    /// <param name="nodeId">The node id the picker is bound to.</param>
    /// <returns>The step's display name, or the empty-selection label.</returns>
    /// <remarks>
    /// TR-024: a Select's trigger paints its raw bound VALUE on first paint. The bound value here is
    /// a node id — it has to be, because it is what goes into the stored document — so without this
    /// the picker read "agent-e5e018887f5f4f63b2" until the user opened it. Observed on the live
    /// Catalyst head, 2026-08-01.
    /// </remarks>
    private string StepTextFor(string nodeId) => string.IsNullOrWhiteSpace(nodeId)
        ? Localizer["FlowsStartNodeImplicit"].Value
        : editor?.FindNode(nodeId)?.DisplayName ?? nodeId;

    /// <summary>Renders an agent picker's bound handle as the mention the user knows it by.</summary>
    /// <param name="handle">The agent handle the picker is bound to.</param>
    /// <returns>The handle with its leading '@', or the empty-selection label.</returns>
    private string AgentTextFor(string handle) => string.IsNullOrWhiteSpace(handle)
        ? Localizer["FlowsPickAgent"].Value
        : "@" + handle;

    /// <summary>Renders a handoff mode's bound enum NAME as its translated label.</summary>
    /// <param name="value">The enum name the picker is bound to.</param>
    /// <returns>The translated label.</returns>
    private string HandoffModeTextFor(string value) =>
        Enum.TryParse<HandoffContextMode>(value, out var mode) ? HandoffModeName(mode) : value;

    /// <summary>Renders a condition operator's bound enum NAME as its translated label.</summary>
    /// <param name="value">The enum name the picker is bound to.</param>
