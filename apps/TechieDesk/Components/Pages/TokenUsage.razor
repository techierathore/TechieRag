@page "/token-usage"
@using TechieRag.Abstractions
@using TechieRag.Models
@inject TechieDesk.Services.TechieRagManager TechieRag
@inject ToastService ToastService
@implements IDisposable
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["TokensPageTitle"]</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0">@Localizer["TokensHeading"]</h1>
            <TypographyMuted>@Localizer["TokensSubtitle"]</TypographyMuted>
        </div>
        <Button Variant="ButtonVariant.Outline" OnClick="ResetSession">
            <Button.Icon><LucideIcon aria-hidden="true" Name="rotate-ccw" Size="16" /></Button.Icon>
            @Localizer["TokensResetSession"]
        </Button>
    </div>

    <!-- Summary Cards -->
    <div class="grid gap-4 md:grid-cols-4">
        <Card>
            <CardHeader Class="pb-2">
                <CardDescription>@Localizer["TokensTotal"]</CardDescription>
            </CardHeader>
            <CardContent>
                <div class="text-2xl font-bold">@sessionUsage.TotalTokens.ToString("N0")</div>
            </CardContent>
        </Card>
        <Card>
            <CardHeader Class="pb-2">
                <CardDescription>@Localizer["TokensInputOutput"]</CardDescription>
            </CardHeader>
            <CardContent>
                <div class="text-2xl font-bold">@sessionUsage.TotalInputTokens.ToString("N0") / @sessionUsage.TotalOutputTokens.ToString("N0")</div>
            </CardContent>
        </Card>
        <Card>
            <CardHeader Class="pb-2">
                <CardDescription>@Localizer["TokensEstimatedCost"]</CardDescription>
            </CardHeader>
            <CardContent>
                <div class="text-2xl font-bold">$@sessionUsage.TotalEstimatedCostUsd.ToString("F4")</div>
            </CardContent>
        </Card>
        <Card>
            <CardHeader Class="pb-2">
                <CardDescription>@Localizer["TokensOperations"]</CardDescription>
            </CardHeader>
            <CardContent>
                <div class="text-2xl font-bold">@sessionUsage.OperationCount</div>
            </CardContent>
        </Card>
    </div>

    <!-- Budget Status -->
    @if (budgetStatus != null)
    {
        <Card>
            <CardHeader>
                <CardTitle>@Localizer["TokensBudgetStatus"]</CardTitle>
            </CardHeader>
            <CardContent Class="space-y-4">
                @if (budgetStatus.Budget.MaxTotalTokens > 0)
                {
                    <div class="space-y-1">
                        <div class="flex justify-between text-sm">
                            <span>@Localizer["TokensTokenBudget"]</span>
                            <span>@sessionUsage.TotalTokens.ToString("N0") / @budgetStatus.Budget.MaxTotalTokens.ToString("N0")</span>
                        </div>
                        <Progress aria-label="@Localizer["TokensTokenBudgetUsed"]" Value="@Math.Round((double)(budgetStatus.TokenUtilization * 100))" Class="@GetBudgetClass(budgetStatus.TokenUtilization)" />
                    </div>
                }

                @if (budgetStatus.Budget.MaxCostUsd > 0)
                {
                    <div class="space-y-1">
                        <div class="flex justify-between text-sm">
                            <span>@Localizer["TokensCostBudget"]</span>
                            <span>$@sessionUsage.TotalEstimatedCostUsd.ToString("F4") / $@budgetStatus.Budget.MaxCostUsd.ToString("F2")</span>
                        </div>
                        <Progress aria-label="@Localizer["TokensCostBudgetUsed"]" Value="@Math.Round((double)(budgetStatus.CostUtilization * 100))" Class="@GetBudgetClass(budgetStatus.CostUtilization)" />
                    </div>
                }

                @if (budgetStatus.IsExceeded)
                {
                    <Alert Variant="AlertVariant.Danger">
                        <AlertTitle>@Localizer["TokensBudgetExceeded"]</AlertTitle>
                        <AlertDescription>@Localizer["TokensBudgetExceededBody"]</AlertDescription>
                    </Alert>
                }
                else if (budgetStatus.IsAlertTriggered)
                {
                    <Alert Variant="AlertVariant.Warning">
                        <AlertTitle>@Localizer["TokensBudgetAlert"]</AlertTitle>
                        <AlertDescription>@Localizer["TokensBudgetAlertBody"]</AlertDescription>
                    </Alert>
                }
            </CardContent>
        </Card>
    }

    <!-- Usage by Model -->
    <Card>
        <CardHeader>
            <CardTitle>@Localizer["TokensUsageByModel"]</CardTitle>
        </CardHeader>
        <CardContent>
            @if (modelUsage.Count == 0)
            {
                <TypographyMuted>@Localizer["TokensNoData"]</TypographyMuted>
            }
            else
            {
                <DataTable TData="ModelUsageRow" Data="@modelUsage" ShowPagination="false" ShowToolbar="false">
                    <Columns>
                        <DataTableColumn TData="ModelUsageRow" TValue="string" Property="@(r => r.Model)" Header="@Localizer["TokensColumnModel"]" />
                        <DataTableColumn TData="ModelUsageRow" TValue="int" Property="@(r => r.Requests)" Header="@Localizer["TokensColumnRequests"]" />
                        <DataTableColumn TData="ModelUsageRow" TValue="long" Property="@(r => r.InputTokens)" Header="@Localizer["TokensColumnInput"]" />
                        <DataTableColumn TData="ModelUsageRow" TValue="long" Property="@(r => r.OutputTokens)" Header="@Localizer["TokensColumnOutput"]" />
                        <DataTableColumn TData="ModelUsageRow" TValue="string" Property="@(r => r.CostDisplay)" Header="@Localizer["TokensColumnCost"]" />
                    </Columns>
                </DataTable>
            }
        </CardContent>
    </Card>
</div>

@code {
    private ITokenTracker tracker = null!;
    private TokenUsageSummary sessionUsage = new();
    private BudgetStatus? budgetStatus;
    private List<ModelUsageRow> modelUsage = new();
    private Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        tracker = await TechieRag.GetTokenTrackerAsync();
        RefreshData();
        refreshTimer = new Timer(_ => InvokeAsync(() => { RefreshData(); StateHasChanged(); }), null, 5000, 5000);
    }

    private void RefreshData()
    {
        sessionUsage = tracker.GetSessionUsage();
        budgetStatus = tracker.GetBudgetStatus();

        var usageByModel = tracker.GetUsageByModel();
        modelUsage = usageByModel
            .Select(kvp => new ModelUsageRow(
                kvp.Key,
                kvp.Value.OperationCount,
                kvp.Value.TotalInputTokens,
                kvp.Value.TotalOutputTokens,
                $"${kvp.Value.TotalEstimatedCostUsd:F4}"))
            .ToList();
    }

    private static string GetBudgetClass(float utilization) => utilization switch
    {
        >= 0.8f => "h-2 [&>div]:bg-destructive",
        >= 0.6f => "h-2 [&>div]:bg-yellow-500",
        _ => "h-2"
    };

    private void ResetSession()
    {
        tracker.Reset();
        RefreshData();
        ToastService.Success(Localizer["TokensResetToastBody"], Localizer["TokensResetToastTitle"]);
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }

    private record ModelUsageRow(string Model, int Requests, long InputTokens, long OutputTokens, string CostDisplay);
}
