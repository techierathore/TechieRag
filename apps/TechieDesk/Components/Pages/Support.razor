    // ---------------------------------------------------------------- attachments (REQ-UI-047)

    private Task OnNewIssueFilesChangedAsync(IReadOnlyList<FileUploadItem> files)
    {
        newIssueUploads = files;
        return StageUploadsAsync(files, newIssueDraftKey, newAttachments, () => newIssueUploads = Array.Empty<FileUploadItem>());
    }

    private Task OnCommentFilesChangedAsync(IReadOnlyList<FileUploadItem> files)
    {
        commentUploads = files;
        return StageUploadsAsync(files, commentDraftKey, commentAttachments, () => commentUploads = Array.Empty<FileUploadItem>());
    }

    /// <summary>
    /// Stages files picked or dropped onto a composer, one rejection message per rejected file.
    /// </summary>
    /// <param name="files">The files the control handed over.</param>
    /// <param name="draftKey">The draft they belong to.</param>
    /// <param name="staged">The list to add the accepted attachments to.</param>
    /// <param name="clearControl">Resets the upload control once the files have been consumed.</param>
    private async Task StageUploadsAsync(
        IReadOnlyList<FileUploadItem> files,
        string draftKey,
        List<SupportAttachment> staged,
        Action clearControl)
    {
        if (files.Count == 0 || string.IsNullOrEmpty(draftKey))
        {
            return;
        }

        foreach (var item in files)
        {
            if (staged.Count >= SupportAttachmentPolicy.MaxAttachmentCount)
            {
                ToastService.Error(
                    Localizer["SupportTooManyAttachmentsBody", SupportAttachmentPolicy.MaxAttachmentCount],
                    Localizer["SupportTooManyAttachmentsTitle"]);
                break;
            }

            // Checked before a byte is read so an oversize file is refused by name rather than by
            // an OpenReadStream exception the user cannot interpret.
            var rejection = SupportAttachmentPolicy.GetRejectionReason(item.Name, item.Size);
            if (rejection is not null)
            {
                ToastService.Error(rejection, Localizer["SupportCannotAttachTitle"]);
                continue;
            }

            try
            {
                await using var stream = item.File.OpenReadStream(SupportAttachmentPolicy.MaxFileSizeBytes);
                staged.Add(await AttachmentStore.SaveAsync(draftKey, item.Name, item.ContentType, stream));
            }
            catch (SupportAttachmentRejectedException exception)
            {
                ToastService.Error(exception.Message, Localizer["SupportCannotAttachTitle"]);
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Failed to stage support attachment {FileName}", item.Name);
                ToastService.Error(exception.Message, Localizer["SupportCannotAttachTitle"]);
            }
        }

        clearControl();
        StateHasChanged();
    }

    /// <summary>
    /// Receives a screenshot pasted into a composer (REQ-UI-047). Called from
    /// <c>wwwroot/js/support-attachments.js</c>.
    /// </summary>
    /// <param name="targetKey">Which composer the paste landed in.</param>
    /// <param name="fileName">The name the module generated for the clipboard image.</param>
    /// <param name="contentType">The clipboard image's MIME type.</param>
    /// <param name="base64">The image bytes, base64-encoded.</param>
    [JSInvokable]
    public async Task OnPastedAttachment(string targetKey, string fileName, string contentType, string base64)
    {
        var isComment = targetKey == CommentTargetKey;
        var staged = isComment ? commentAttachments : newAttachments;
        var draftKey = isComment ? commentDraftKey : newIssueDraftKey;

        if (string.IsNullOrEmpty(draftKey))
        {
            return;
        }

        if (staged.Count >= SupportAttachmentPolicy.MaxAttachmentCount)
        {
            ToastService.Error(
                Localizer["SupportTooManyAttachmentsBody", SupportAttachmentPolicy.MaxAttachmentCount],
                Localizer["SupportTooManyAttachmentsTitle"]);
            return;
        }

        try
        {
            var bytes = Convert.FromBase64String(base64);
            var rejection = SupportAttachmentPolicy.GetRejectionReason(fileName, bytes.LongLength);
            if (rejection is not null)
            {
                ToastService.Error(rejection, Localizer["SupportCannotAttachTitle"]);
                return;
            }

            using var stream = new MemoryStream(bytes);
            staged.Add(await AttachmentStore.SaveAsync(draftKey, fileName, contentType, stream));
            ToastService.Success(
                Localizer["SupportScreenshotAttachedBody", fileName], Localizer["SupportScreenshotPastedTitle"]);
        }
        catch (SupportAttachmentRejectedException exception)
        {
            ToastService.Error(exception.Message, Localizer["SupportCannotAttachTitle"]);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to stage a pasted screenshot");
            ToastService.Error(exception.Message, Localizer["SupportCannotAttachTitle"]);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void RemoveNewIssueAttachment(SupportAttachment attachment) =>
        RemoveAttachment(newAttachments, attachment);

    private void RemoveCommentAttachment(SupportAttachment attachment) =>
        RemoveAttachment(commentAttachments, attachment);

    private void RemoveAttachment(List<SupportAttachment> staged, SupportAttachment attachment)
    {
        staged.Remove(attachment);
        AttachmentStore.Remove(attachment);
        StateHasChanged();
    }

    private void DiscardDraft(string draftKey, List<SupportAttachment> staged)
    {
        staged.Clear();
        if (!string.IsNullOrEmpty(draftKey))
        {
            AttachmentStore.DiscardDraft(draftKey);
        }
    }

    // ---------------------------------------------------------------- plumbing

    /// <summary>Wires the paste handler to a composer once its element exists.</summary>
    /// <param name="elementId">The container element listening for the paste.</param>
    /// <param name="targetKey">Which composer the paste belongs to.</param>
    /// <returns>True once the element was found and bound.</returns>
    private async Task<bool> BindPasteTargetAsync(string elementId, string targetKey)
    {
        var module = await GetPasteModuleAsync();
        if (module is null)
        {
            return false;
        }

        selfReference ??= DotNetObjectReference.Create(this);
        try
        {
            return await module.InvokeAsync<bool>("attachPasteTarget", elementId, selfReference, targetKey);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not bind the paste target {ElementId}", elementId);
            return false;
        }
    }

    private async Task<IJSObjectReference?> GetPasteModuleAsync()
    {
        try
        {
            pasteModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/support-attachments.js");
            return pasteModule;
        }
        catch (Exception exception)
        {
            // Paste is the one affordance that needs JS; drag and choose-from-disk still work, so a
            // missing module degrades the screen rather than breaking it.
            Logger.LogWarning(exception, "Support paste module unavailable");
            return null;
        }
    }

    /// <summary>
    /// Resolves the ApplicationId <c>POST /IssueSvc</c> requires, preferring the configured value
    /// and falling back to the one the licence carries.
    /// </summary>
    /// <returns>The application identifier, or zero when none is known.</returns>
    private int ApplicationId()
    {
        var configured = Configuration.GetValue<int?>($"{AppManagerOptions.SectionName}:ApplicationId");
        return configured ?? TokenStore.ActiveLicense?.ApplicationId ?? 0;
    }

    private bool IsMine(SupportIssueCommentData comment)
    {
        var author = comment.CreatedByName;
        if (string.IsNullOrWhiteSpace(author))
        {
            return false;
        }

        var me = TokenStore.User?.DisplayName ?? UserContext.CurrentUser.DisplayName;
        return string.Equals(author, me, StringComparison.OrdinalIgnoreCase);
    }

    private string AuthorOf(SupportIssueCommentData comment) =>
        IsMine(comment) ? Localizer["SupportYou"].Value : (comment.CreatedByName ?? Localizer["SupportTitle"].Value);

    private static string FormatMoment(DateTimeOffset? moment) =>
        moment?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "—";

    /// <summary>
    /// REQ-UI-051: resolves a resource key for the catalogue.
    /// </summary>
    /// <param name="key">A key present in <c>AppStrings.resx</c>.</param>
    /// <param name="arguments">Format arguments, when the key carries placeholders.</param>
    /// <returns>The translated text.</returns>
    /// <remarks>
    /// <see cref="SupportIssueCatalog"/> is static and is shared with non-UI callers, so it takes
    /// its localizer as an argument rather than holding one. This is the page's one adapter onto
    /// the injected <c>IStringLocalizer</c>.
    /// </remarks>
    private string Localize(string key, params object?[] arguments) => Localizer[key, arguments!].Value;

    /// <summary>REQ-UI-051: the localized plain-language note under the issue-type picker.</summary>
    /// <param name="code">The invariant issue-type code.</param>
    /// <returns>The qualifier, or an empty string for an unrecognised code.</returns>
    private string TypeQualifier(string? code) =>
        SupportIssueCatalog.Find(SupportIssueCatalog.Types, code) is { } option
            ? Localize(option.QualifierKey)
            : string.Empty;

    /// <summary>
    /// REQ-UI-051: the localized label for an issue-type code.
    /// </summary>
    /// <param name="code">The invariant wire code, or null.</param>
    /// <returns>The label the user reads.</returns>
    /// <remarks>
    /// <see cref="SupportIssueCatalog"/> holds the WIRE vocabulary \u2014 the codes AppManager receives,
    /// which must never be translated \u2014 beside the resource KEY naming each label. These helpers
    /// resolve the key half only. The switch they replaced restated the six codes a third time (the
    /// catalogue, the wire, and here) and matched on lower-cased literals, so a code the catalogue
    /// gained but the switch did not would have rendered English.
    /// </remarks>
    private string TypeLabelText(string? code) => SupportIssueCatalog.TypeLabel(code, Localize);

    /// <summary>REQ-UI-051: the localized label for a priority code.</summary>
    /// <param name="code">The invariant wire code, or null.</param>
    /// <returns>The label the user reads.</returns>
    private string PriorityLabelText(string? code) => SupportIssueCatalog.PriorityLabel(code, Localize);

    /// <summary>REQ-UI-051: the localized label and qualifier for a priority code.</summary>
    /// <param name="code">The invariant wire code, or null.</param>
    /// <returns>The text the priority pickers show.</returns>
    private string PriorityLabelWithQualifier(string? code) =>
        SupportIssueCatalog.PriorityLabelWithQualifier(code, Localize);

    /// <summary>REQ-UI-051 / TR-024: the status filter's trigger text, "All statuses" included.</summary>
    /// <param name="code">The invariant wire code, or the empty all-statuses sentinel.</param>
    /// <returns>The text painted on the filter's trigger.</returns>
    private string StatusFilterText(string? code) =>
        string.IsNullOrEmpty(code) ? Localizer["SupportAllStatuses"] : StatusLabelText(code);

    /// <summary>REQ-UI-051: the localized label for a status code.</summary>
    /// <param name="code">The invariant wire code, or null.</param>
    /// <returns>The label the user reads.</returns>
    private string StatusLabelText(string? code) => SupportIssueCatalog.StatusLabel(code, Localize);

    private static BadgeVariant PriorityVariant(string? priority) => priority?.ToLowerInvariant() switch
    {
        "critical" or "high" => BadgeVariant.Destructive,
        "medium" => BadgeVariant.Default,
        _ => BadgeVariant.Secondary
    };

    private static BadgeVariant StatusVariant(string? status) => status?.ToLowerInvariant() switch
    {
        "open" => BadgeVariant.Default,
        "inprogress" => BadgeVariant.Outline,
        _ => BadgeVariant.Secondary
    };

    /// <summary>
    /// Turns a failure into a sentence naming what actually went wrong.
    /// </summary>
    /// <param name="exception">The failure.</param>
    /// <returns>The message to show.</returns>
    /// <remarks>
    /// AppManager's own message is preferred over anything invented here — "Issue is already
    /// closed" tells the user what to do next, and "Support is unavailable" does not.
    /// </remarks>
    private string Describe(Exception exception) => exception switch
    {
        AppManagerException { Error: AppManagerError.NotConfigured } =>
            Localizer["SupportErrorNotConfigured"],
        AppManagerException { Error: AppManagerError.Unauthorized or AppManagerError.InvalidToken } =>
            Localizer["SupportErrorSessionExpired"],
        // Server text plus its code: no English of ours, so nothing to translate.
        AppManagerException appManager => $"{appManager.Message} ({appManager.ErrorCode})",
        HttpRequestException http => Localizer["SupportErrorUnreachable", http.Message],
        _ => exception.Message
    };
}
