@page "/setup"
@layout AuthLayout
@using TechieDesk.Services.Setup
@using TechieDesk.Services.Agents
@inject ISetupStateService SetupState
@* REQ-FN-050: the owner asked the first run to check "whether the LLMs are configured, whether the
   agents are configured". The registry is what answers the second half. *@
@inject IAgentRegistry AgentRegistry
@inject IStringLocalizer<AppStrings> Localizer
@inject IOllamaProbe OllamaProbe
@inject TechieRagConfigService RagConfig
@inject TechieRagManager Rag
@inject IWorkspaceService Workspaces
@inject ITechieDeskAuthModeProvider AuthMode
@inject NavigationManager Nav
@inject ILogger<Setup> Logger

@* REQ-UI-022/023, REQ-FN-016: first-run wizard. Centered card on AuthLayout (no shell),
   matching docs/mockups/setup-wizard.html. Applies zero-config OFFLINE defaults (Embedded
   BGE-M3 + SqliteVec), detects a local Ollama, captures the AppManager-vs-offline choice and
   first-Admin intent, then creates the default workspace. TR-005: the step indicator is
   composed from Progress + a custom label row (no Stepper component in TrBlazeUI). *@

<PageTitle>@Localizer["SetupPageTitle"]</PageTitle>

@* REQ-NFR-005: the wizard has no visible title of its own (its heading role is carried by the
   step indicator), so the route shipped with no level-one heading at all. A visually-hidden h1
   gives screen-reader and FocusOnNavigate users the page identity without altering the mockup. *@
<h1 class="sr-only">@Localizer["SetupSrHeading"]</h1>

<Card Class="rounded-2xl p-2 shadow-lg" style="width:100%">
    <CardContent Class="space-y-4 pt-6">
        <Progress aria-label="@Localizer["SetupProgressLabel"]" Value="@Math.Round(ProgressValue)" Class="h-2" />

        @* TR-005 step indicator — done / current / pending states.

           REQ-FN-050: the labels used to sit UNDER each node. That worked at five steps and does
           not at six — measured on the maccatalyst head, not guessed: each column drops to about
           forty-five pixels and the six labels rendered as "De-faults", "Provide r", "AppMa nager"
           and "Worksp ace". Hindi, whose words are no shorter, would fare worse.

           So the rail now carries the numbers and ONE caption names the step you are actually on.
           Nothing is lost to assistive tech — every node keeps its full label as its accessible
           name and its tooltip — and the caption states the position outright ("Step 3 of 6"),
           which the coloured-node row only implied. *@
        <div class="flex justify-between gap-1.5">
            @* `i != n`, not `i < n`: the `<` opens what every tag-based reader of this file takes
               for an element, which swallows the loop header and the div after it. *@
            @for (var i = 0; i != StepLabels.Length; i++)
            {
                var index = i;
                var state = StepStateFor(index);
                <div class="flex flex-1 flex-col items-center">
                    <span class="@NodeClass(state)" title="@StepLabels[index]" aria-label="@StepLabels[index]">
                        @if (state == StepState.Done)
                        {
                            <LucideIcon aria-hidden="true" Name="check" Size="14" />
                        }
                        else
                        {
                            @(index + 1)
                        }
                    </span>
                </div>
            }
        </div>
        <p class="text-center text-xs font-bold text-foreground">
            @Localizer["SetupStepIndicator", (int)currentStep + 1, StepLabels.Length, StepLabels[(int)currentStep]]
        </p>

        @* ---------------- Step 1: Offline defaults ---------------- *@
        @if (currentStep == WizardStep.Defaults)
        {
            <Alert Variant="AlertVariant.Success">
                <Alert.Icon><LucideIcon aria-hidden="true" Name="shield-check" Size="16" /></Alert.Icon>
                <AlertTitle>@Localizer["SetupDefaultsReadyTitle"]</AlertTitle>
                <AlertDescription>@Localizer["SetupDefaultsReadyBody"]</AlertDescription>
            </Alert>
            <TypographyMuted>@Localizer["SetupDefaultsNote"]</TypographyMuted>
        }

        @* ---------------- Step 2: AI provider (Ollama detect) ---------------- *@
        @if (currentStep == WizardStep.AiProvider)
        {
            @if (probing)
            {
                <div class="flex items-center gap-2 text-muted-foreground">
                    <Spinner Size="SpinnerSize.Small" /> <span>@Localizer["SetupDetectingOllama"]</span>
                </div>
            }
            else if (ollama is { Available: true })
            {
                <Alert Variant="AlertVariant.Success">
                    <Alert.Icon><LucideIcon aria-hidden="true" Name="check-circle" Size="16" /></Alert.Icon>
                    <AlertDescription>
                        @Localizer[ollama.Models.Count == 1 ? "SetupOllamaDetectedOne" : "SetupOllamaDetectedMany", ollama.Endpoint, ollama.Models.Count]
                    </AlertDescription>
                </Alert>

                @if (ollama.Models.Count > 0)
                {
                    <Field>
                        <FieldLabel>@Localizer["SetupChatModel"]</FieldLabel>
                        <FieldContent>
                            <Select @bind-Value="selectedModel" TValue="string" Class="w-full">
                                <SelectTrigger aria-label="@Localizer["SetupChatModel"]"><SelectValue Placeholder="@Localizer["SetupSelectModel"]" /></SelectTrigger>
                                <SelectContent>
                                    @foreach (var model in ollama.Models)
                                    {
                                        <SelectItem Value="@model" Text="@model" TValue="string">@model</SelectItem>
                                    }
                                </SelectContent>
                            </Select>
                        </FieldContent>
                    </Field>
                }
            }
            else
            {
                <Alert Variant="AlertVariant.Info">
                    <Alert.Icon><LucideIcon aria-hidden="true" Name="info" Size="16" /></Alert.Icon>
                    <AlertDescription>@Localizer["SetupNoOllama"]</AlertDescription>
                </Alert>
            }

            <div class="space-y-2">
                @RenderProviderRow(ProviderChoice.Ollama, Localizer["SetupProviderOllamaTitle"], Localizer["SetupProviderOllamaSubtitle"], ollama is { Available: true })
                @* A bare brand name has nothing to translate; the subtitle beside it carries the prose.
                   Same call as LlmSettings.LlmSourceText makes for the same seven providers. *@
                @RenderProviderRow(ProviderChoice.LmStudio, "LM Studio", Localizer["SetupProviderLmStudioSubtitle"], true)
                @RenderProviderRow(ProviderChoice.OpenAiCompatible, Localizer["SetupProviderOpenAiTitle"], Localizer["SetupProviderOpenAiSubtitle"], true)
                @RenderProviderRow(ProviderChoice.Skip, Localizer["SetupProviderSkipTitle"], Localizer["SetupProviderSkipSubtitle"], true)
            </div>

            @if (provider is ProviderChoice.LmStudio or ProviderChoice.OpenAiCompatible)
            {
                <Field>
                    <FieldLabel>@Localizer["SetupEndpointUrl"]</FieldLabel>
                    <FieldContent>
                        <Input AriaLabel="@Localizer["SetupEndpointUrl"]" @bind-Value="providerEndpoint"
                               Placeholder="@(provider == ProviderChoice.LmStudio ? "http://localhost:1234" : "http://localhost:8000/v1")" />
                    </FieldContent>
                </Field>
                <Field>
                    <FieldLabel>@Localizer["SetupModelName"]</FieldLabel>
                    <FieldContent>
                        <Input @bind-Value="selectedModel" Placeholder="@Localizer["SetupModelPlaceholder"]" />
                    </FieldContent>
                </Field>
            }
        }

        @* ---------------- Step 3: Agents (REQ-FN-050) ----------------
           The LLM half of the owner's ask was already covered by the step above. This is the half
           that was missing: it reports whether this instance has agents to answer with, and — when
           the previous step ended embedded-only — says plainly what agents can and cannot do
           without a provider, so "offline" is an informed choice rather than a surprise later. *@
        @if (currentStep == WizardStep.Agents)
        {
            @if (agentsLoading)
            {
                <div class="flex items-center gap-2 text-muted-foreground">
                    <Spinner Size="SpinnerSize.Small" /> <span>@Localizer["SetupAgentsChecking"]</span>
                </div>
            }
            else
            {
                <Alert Variant="AlertVariant.Success">
                    <Alert.Icon><LucideIcon aria-hidden="true" Name="bot" Size="16" /></Alert.Icon>
                    <AlertTitle>@Localizer["SetupAgentsReadyTitle"]</AlertTitle>
                    <AlertDescription>@Localizer["SetupAgentsReadyDescription", agentCount]</AlertDescription>
                </Alert>

                @if (provider == ProviderChoice.Skip)
                {
                    <Alert Variant="AlertVariant.Info">
                        <Alert.Icon><LucideIcon aria-hidden="true" Name="info" Size="16" /></Alert.Icon>
                        <AlertDescription>@Localizer["SetupAgentsNoProviderNote"]</AlertDescription>
                    </Alert>
                }
            }
        }

        @* ---------------- Step 4: AppManager vs offline ---------------- *@
        @if (currentStep == WizardStep.AppManager)
        {
            <div class="space-y-2">
                @RenderModeRow(false, Localizer["SetupModeOfflineTitle"], Localizer["SetupModeOfflineSubtitle"])
                @RenderModeRow(true, Localizer["SetupModeAppManagerTitle"], Localizer["SetupModeAppManagerSubtitle"])
            </div>

            @if (useAppManager)
            {
                <Field>
                    <FieldLabel>@Localizer["SetupAppManagerBaseUrl"]</FieldLabel>
                    <FieldContent>
                        <Input @bind-Value="appManagerBaseUrl" Placeholder="https://appmanager.example.com" />
                    </FieldContent>
                </Field>
                <div class="td-grid-2">
                    <Field>
                        <FieldLabel>@Localizer["SetupApiKey"]</FieldLabel>
                        <FieldContent><Input @bind-Value="appManagerApiKey" Placeholder="@Localizer["SetupApiKeyPlaceholder"]" /></FieldContent>
                    </Field>
                    <Field>
                        <FieldLabel>@Localizer["SetupApiSecret"]</FieldLabel>
                        <FieldContent><Input Type="InputType.Password" @bind-Value="appManagerApiSecret" Placeholder="@Localizer["SetupApiSecretPlaceholder"]" /></FieldContent>
                    </Field>
                </div>
                <Alert Variant="AlertVariant.Warning">
                    <Alert.Icon><LucideIcon aria-hidden="true" Name="key-round" Size="16" /></Alert.Icon>
                    <AlertDescription>
                        @Localizer["SetupSecretsBefore"] (<TypographyInlineCode>AppManager__ApiKey</TypographyInlineCode> /
                        <TypographyInlineCode>AppManager__ApiSecret</TypographyInlineCode>)@Localizer["SetupSecretsAfter"]
                    </AlertDescription>
                </Alert>
            }
        }

        @* ---------------- Step 5: Admin account ---------------- *@
        @if (currentStep == WizardStep.Admin)
        {
            @if (!useAppManager)
            {
                <Alert Variant="AlertVariant.Info">
                    <Alert.Icon><LucideIcon aria-hidden="true" Name="user-check" Size="16" /></Alert.Icon>
                    <AlertDescription>@Localizer["SetupOfflineAdminNote"]</AlertDescription>
                </Alert>
            }
            else
            {
                <TypographyMuted>@Localizer["SetupCreateAdmin"]</TypographyMuted>
                <Field>
                    <FieldLabel>@Localizer["SetupFullName"]</FieldLabel>
                    <FieldContent><Input @bind-Value="adminName" Placeholder="@Localizer["SetupFullNamePlaceholder"]" /></FieldContent>
                </Field>
                <Field>
                    <FieldLabel>@Localizer["SetupEmail"]</FieldLabel>
                    <FieldContent><Input Type="InputType.Email" @bind-Value="adminEmail" Placeholder="admin@company.com" /></FieldContent>
                </Field>
                <Field>
                    <FieldLabel>@Localizer["SetupPassword"]</FieldLabel>
                    <FieldContent><Input Type="InputType.Password" @bind-Value="adminPassword" Placeholder="••••••••" /></FieldContent>
                </Field>
                <Alert Variant="AlertVariant.Info">
                    <Alert.Icon><LucideIcon aria-hidden="true" Name="info" Size="16" /></Alert.Icon>
                    <AlertDescription>@Localizer["SetupAdminProvisionNote"]</AlertDescription>
                </Alert>
            }
        }

        @* ---------------- Step 6: Workspace ---------------- *@
        @if (currentStep == WizardStep.Workspace)
        {
            <TypographyMuted>@Localizer["SetupWorkspaceNote"]</TypographyMuted>
            <Field>
                <FieldLabel>@Localizer["SetupWorkspaceName"]</FieldLabel>
                <FieldContent><Input @bind-Value="workspaceName" Placeholder="@Localizer["SetupWorkspacePlaceholder"]" /></FieldContent>
            </Field>
            <Alert Variant="AlertVariant.Success">
                <Alert.Icon><LucideIcon aria-hidden="true" Name="rocket" Size="16" /></Alert.Icon>
                <AlertDescription>@Localizer["SetupFinishNote"]</AlertDescription>
            </Alert>
        }

        @if (errorMessage is not null)
        {
            <Alert Variant="AlertVariant.Danger" AccentBorder="true">
                <Alert.Icon><LucideIcon aria-hidden="true" Name="alert-circle" Size="16" /></Alert.Icon>
                <AlertDescription>@errorMessage</AlertDescription>
            </Alert>
        }

        @* ---------------- Wizard navigation ---------------- *@
        <div class="flex items-center justify-between pt-2">
            <Button Variant="ButtonVariant.Outline" OnClick="Back" Disabled="@(currentStep == WizardStep.Defaults || isFinishing)">
                @Localizer["SetupBack"]
            </Button>
            @if (currentStep == WizardStep.Workspace)
            {
                <Button OnClick="FinishAsync" Disabled="@(isFinishing || string.IsNullOrWhiteSpace(workspaceName))">
                    @if (isFinishing)
                    {
                        <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                        <span>@Localizer["SetupFinishing"]</span>
                    }
                    else
                    {
                        <span>@Localizer["SetupFinish"]</span>
                    }
                </Button>
            }
            else
            {
                <Button OnClick="Next" Disabled="@isFinishing">@Localizer["SetupContinue"]</Button>
            }
        </div>

        @* REQ-FN-050 acceptance (2): an explicit way OUT that still settles the question. Without
           it the only exits from a wizard the shell now insists on are "finish it" and "quit the
           app", and the second leaves the flag unwritten so the wizard returns on the next launch —
           precisely the "why the hell do I have to set it up every time" the owner objected to.
           Skipping records completion in Offline/embedded-only form, so it is a one-way door. *@
        <div class="flex justify-center pt-1">
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                    OnClick="SkipAsync" Disabled="@isFinishing">
                @Localizer["SetupSkipLink"]
            </Button>
        </div>
    </CardContent>
</Card>

@code {
    private enum WizardStep { Defaults, AiProvider, Agents, AppManager, Admin, Workspace }

    private enum StepState { Done, Current, Pending }

    private enum ProviderChoice { Ollama, LmStudio, OpenAiCompatible, Skip }

    // REQ-UI-050: the step labels are read by the user, so they resolve through AppStrings like
    // every other label in the shell. Keyed off the enum so a new step cannot be added without a
    // label — the array and the enum used to be able to drift.
    private string[] StepLabels =>
    [
        Localizer["SetupStepDefaults"],
        Localizer["SetupStepAiProvider"],
        Localizer["SetupStepAgents"],
        Localizer["SetupStepAppManager"],
        Localizer["SetupStepAdmin"],
        Localizer["SetupStepWorkspace"]
    ];

    private WizardStep currentStep = WizardStep.Defaults;

    // Step 2 — AI provider.
    private bool probing = true;
    private OllamaProbeResult? ollama;
    private ProviderChoice provider = ProviderChoice.Skip;
    private string providerEndpoint = string.Empty;
    private string selectedModel = string.Empty;

    // Step 3 — agents (REQ-FN-050). Counted, not configured: the built-in @@agent is synthesized by
    // the registry for every workspace, so the honest first-run check is "are there agents to
    // answer with", not "make the user create one before they may use the app".
    private bool agentsLoading = true;
    private int agentCount;

    // Step 4 — AppManager vs offline.
    private bool useAppManager;
    private string appManagerBaseUrl = string.Empty;
    private string appManagerApiKey = string.Empty;
    private string appManagerApiSecret = string.Empty;

    // Step 5 — first Admin (AppManager mode).
    private string adminName = string.Empty;
    private string adminEmail = string.Empty;
    private string adminPassword = string.Empty;

    // Step 6 — workspace.
    private string workspaceName = "Default";

    private bool isFinishing;
    private string? errorMessage;

    private double ProgressValue => ((int)currentStep + 1) / (double)StepLabels.Length * 100.0;

    // AppManager mode defaults to whatever the running instance is configured for, so the wizard
    // reflects reality when re-run on an already-configured instance.
    protected override void OnInitialized() => useAppManager = AuthMode.IsAppManagerEnabled;

    // REQ-FN-016: probe Ollama once, after the first interactive render (not during prerender), so
    // a slow/absent server never blocks first paint. Graceful: an unavailable result just offers
    // the embedded/offline path.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            ollama = await OllamaProbe.ProbeAsync(IOllamaProbe.DefaultEndpoint);
            if (ollama.Available)
            {
                provider = ProviderChoice.Ollama;
                selectedModel = ollama.Models.FirstOrDefault() ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Ollama probe failed during setup wizard");
            ollama = new OllamaProbeResult(false, IOllamaProbe.DefaultEndpoint, Array.Empty<string>());
        }
        finally
        {
            probing = false;
            StateHasChanged();
        }

        await LoadAgentReadinessAsync();
    }

    // REQ-FN-050: the agent half of the first-run check. REQ-FN-009 has already bootstrapped a
    // default workspace by the time the wizard runs, so the registry can be asked directly; on a
    // genuinely empty instance the count is simply zero and the step still reads correctly, because
    // the built-in agent is synthesized per workspace the moment one exists.
    private async Task LoadAgentReadinessAsync()
    {
        try
        {
            var visible = await Workspaces.ListForCurrentUserAsync();
            var first = visible.FirstOrDefault();
            agentCount = first is null
                ? 0
                : (await AgentRegistry.ListAsync(first.WorkspaceId)).Count;
        }
        catch (Exception ex)
        {
            // An agent read must never block setup — the step degrades to "none found" and the
            // user carries on. Nothing here gates Continue.
            Logger.LogDebug(ex, "Agent readiness check failed during setup wizard");
            agentCount = 0;
        }
        finally
        {
            agentsLoading = false;
            StateHasChanged();
        }
    }

    private StepState StepStateFor(int index)
    {
        var current = (int)currentStep;
        if (index < current) return StepState.Done;
        return index == current ? StepState.Current : StepState.Pending;
    }

    private static string NodeClass(StepState state) => state switch
    {
        StepState.Done => "flex h-7 w-7 items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground",
        StepState.Current => "flex h-7 w-7 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary ring-2 ring-primary",
        _ => "flex h-7 w-7 items-center justify-center rounded-full bg-muted text-xs font-bold text-muted-foreground"
    };

    // `cls` is ONE line, and stays inside the __builder lambda. Both are load-bearing for the tools
    // that read this file rather than for the compiler: inside the lambda this is a razor TEMPLATE
    // region, so the class strings are correctly read as markup rather than as English prose — and
    // within a template region a C# line that does NOT end in a semicolon stands in the text stream
    // as a phantom English run, which is what the three-line version of this produced.
    private RenderFragment RenderProviderRow(ProviderChoice choice, string title, string subtitle, bool enabled) => __builder =>
    {
        var selected = provider == choice;
        var cls = "flex w-full items-start gap-3 rounded-lg border p-3 text-left transition-colors " + (selected ? "border-primary bg-primary/5" : "border-border hover:border-primary/40") + (enabled ? " cursor-pointer" : " cursor-not-allowed opacity-50");
        <button type="button" class="@cls" disabled="@(!enabled)" @onclick="@(() => SelectProvider(choice))">
            <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border @(selected ? "border-primary" : "border-muted-foreground/40")">
                @if (selected)
                {
                    <span class="h-2 w-2 rounded-full bg-primary"></span>
                }
            </span>
            <span class="flex flex-col">
                <span class="text-sm font-semibold">@title</span>
                <span class="text-xs text-muted-foreground">@subtitle</span>
            </span>
        </button>
    };

    // One line, inside the lambda — see RenderProviderRow above.
    private RenderFragment RenderModeRow(bool appManager, string title, string subtitle) => __builder =>
    {
        var selected = useAppManager == appManager;
        var cls = "flex w-full cursor-pointer items-start gap-3 rounded-lg border p-3 text-left transition-colors " + (selected ? "border-primary bg-primary/5" : "border-border hover:border-primary/40");
        <button type="button" class="@cls" @onclick="@(() => useAppManager = appManager)">
            <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border @(selected ? "border-primary" : "border-muted-foreground/40")">
                @if (selected)
                {
                    <span class="h-2 w-2 rounded-full bg-primary"></span>
                }
            </span>
            <span class="flex flex-col">
                <span class="text-sm font-semibold">@title</span>
                <span class="text-xs text-muted-foreground">@subtitle</span>
            </span>
        </button>
    };

    private void SelectProvider(ProviderChoice choice)
    {
        provider = choice;
        if (choice == ProviderChoice.Ollama)
        {
            providerEndpoint = ollama?.Endpoint ?? IOllamaProbe.DefaultEndpoint;
            selectedModel = ollama?.Models.FirstOrDefault() ?? selectedModel;
        }
        else if (choice == ProviderChoice.LmStudio && string.IsNullOrWhiteSpace(providerEndpoint))
        {
            providerEndpoint = "http://localhost:1234";
        }
    }

    private void Back()
    {
        errorMessage = null;
        if (currentStep > WizardStep.Defaults)
        {
            currentStep = (WizardStep)((int)currentStep - 1);
        }
    }

    private void Next()
    {
        errorMessage = null;
        if (currentStep < WizardStep.Workspace)
        {
            currentStep = (WizardStep)((int)currentStep + 1);
        }
    }

    // Applies the collected choices: offline defaults (Embedded BGE-M3 + SqliteVec) with the
    // optional local LLM, ensures a workspace exists, and records completion. Any provider
    // outage is tolerated — completion is recorded so the app is usable (REQ-UI-022).
    private async Task FinishAsync()
    {
        if (string.IsNullOrWhiteSpace(workspaceName))
        {
            errorMessage = Localizer["SetupWorkspaceRequired"];
            return;
        }

        isFinishing = true;
        errorMessage = null;
        try
        {
            await ApplyOfflineDefaultsAsync();

            var mode = useAppManager ? "AppManager" : "Offline";
            var baseUrl = useAppManager && !string.IsNullOrWhiteSpace(appManagerBaseUrl)
                ? appManagerBaseUrl.Trim()
                : null;

            await EnsureWorkspaceAsync();

            // REQ-FN-050 acceptance (4): record WHICH provider was chosen, including the deliberate
            // "none". Embedded-only and never-configured look identical in the RAG config, and only
            // this value lets the shell tell a settled offline install from an unfinished one — so
            // only this value stops the deliberate offline user from being nagged forever.
            await SetupState.MarkCompleteAsync(mode, baseUrl, RecordedProvider());

            Logger.LogInformation(
                "First-run setup completed (mode: {Mode}, provider: {Provider})", mode, provider);

            Nav.NavigateTo(LandingRoute(), forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "First-run setup failed to complete");
            errorMessage = Localizer["SetupFailed"];
            isFinishing = false;
        }
    }

    /// <summary>The provider value persisted for this run — "None" for a deliberate offline finish.</summary>
    private string RecordedProvider() =>
        provider == ProviderChoice.Skip ? ISetupStateService.NoProvider : provider.ToString();

    // REQ-FN-050 acceptance (2): "set up later" is a COMPLETED outcome. It records the flag exactly
    // as a finish does, so the wizard never reappears — a "later" that reopens the wizard on the
    // next launch is the behaviour the owner rejected outright. Nothing else is applied: the
    // instance keeps the zero-config embedded defaults it already boots with.
    private async Task SkipAsync()
    {
        isFinishing = true;
        errorMessage = null;
        try
        {
            await SetupState.MarkSkippedAsync();
            Logger.LogInformation("First-run setup skipped by the user; it will not be offered again");
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "First-run setup skip could not be recorded");
            errorMessage = Localizer["SetupFailed"];
            isFinishing = false;
        }
    }

    // REQ-UI-022: persist zero-external-service defaults, layering the chosen LLM on top.
    private async Task ApplyOfflineDefaultsAsync()
    {
        var config = await RagConfig.LoadConfigAsync();

        config.Embedding.Source = EmbeddingSource.Embedded;
        config.VectorStore.Type = VectorStoreType.SqliteVec;
        if (string.IsNullOrWhiteSpace(config.VectorStore.ConnectionString))
        {
            config.VectorStore.ConnectionString = "Data Source=data/techiedesk-rag-store.db";
        }

        switch (provider)
        {
            case ProviderChoice.Ollama when ollama is { Available: true }:
                config.Llm.Source = LlmSource.Ollama;
                config.Llm.Endpoint = ollama.Endpoint;
                config.Llm.Model = string.IsNullOrWhiteSpace(selectedModel) ? "llama3.1" : selectedModel;
                break;
            case ProviderChoice.LmStudio:
                config.Llm.Source = LlmSource.LmStudio;
                config.Llm.Endpoint = string.IsNullOrWhiteSpace(providerEndpoint) ? "http://localhost:1234" : providerEndpoint.Trim();
                config.Llm.Model = selectedModel;
                break;
            case ProviderChoice.OpenAiCompatible:
                config.Llm.Source = LlmSource.OpenAICompatible;
                config.Llm.Endpoint = providerEndpoint.Trim();
                config.Llm.Model = selectedModel;
                break;
            default:
                // Skip / embedded-only: leave the LLM unset so the instance is retrieval-ready
                // with zero external services.
                break;
        }

        await RagConfig.SaveConfigAsync(config);

        // Rebuild the running instance so the new offline defaults take effect without a restart.
        // Tolerate a build failure (e.g. a provider that is not reachable yet) — completion still
        // proceeds so the app is usable and the operator can adjust settings later.
        try
        {
            await Rag.ReconfigureAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "TechieRag reconfigure after setup did not complete; continuing");
        }
    }

    private async Task EnsureWorkspaceAsync()
    {
        var userId = Workspaces.CurrentUserId;
        var created = await Workspaces.EnsureDefaultWorkspaceAsync(userId);
        if (!created && Workspaces.CanManageWorkspaces)
        {
            // A workspace already exists (Wave 3 bootstrap). Only create the named one when it is
            // genuinely new, to avoid duplicating "Default".
            var existing = await Workspaces.ListForCurrentUserAsync();
            var alreadyNamed = existing.Any(w =>
                string.Equals(w.Name, workspaceName.Trim(), StringComparison.OrdinalIgnoreCase));
            if (!alreadyNamed && !string.Equals(workspaceName.Trim(), "Default", StringComparison.OrdinalIgnoreCase))
            {
                await Workspaces.CreateWorkspaceAsync(workspaceName.Trim());
            }
        }
    }

    private string LandingRoute()
    {
        try
        {
            var target = workspaceName.Trim();
            var visible = Workspaces.ListForCurrentUserAsync().GetAwaiter().GetResult();
            var match = visible.FirstOrDefault(w =>
                string.Equals(w.Name, target, StringComparison.OrdinalIgnoreCase)) ?? visible.FirstOrDefault();
            return match is not null ? $"/workspace/{Workspaces.SlugFor(match)}" : "/";
        }
        catch
        {
            return "/";
        }
    }
}
